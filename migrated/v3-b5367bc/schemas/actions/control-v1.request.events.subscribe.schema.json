{
  "$comment": "Runtime binds authenticated principal/grant, exact request bytes/digest, deadline <=60000ms ahead, visibility, idempotency custody and resource identity/generation equality before dispatch. UUIDs and schema validation grant no authority.",
  "$defs": {
    "AuthorityV1": {
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "scope_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "grant_id",
        "scope_sha256"
      ],
      "type": "object"
    },
    "BodyRequest_events_subscribe": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_limit": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "cursor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/EventCursorV1"
            }
          ]
        },
        "resource_ids": {
          "items": {
            "$ref": "#/$defs/UuidV4"
          },
          "maxItems": 100,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/EventTopicV1"
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "cursor",
        "topics",
        "resource_ids",
        "bootstrap_limit"
      ],
      "type": "object"
    },
    "EventCursorV1": {
      "$comment": "Runtime checks epoch, retention, expiry, principal visibility and the server-computed sorted filter digest; this selector supplies no authority.",
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "$ref": "#/$defs/UuidV4"
        },
        "expires_unix_ms": {
          "$ref": "#/$defs/U64Decimal"
        },
        "filter_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "issued_unix_ms": {
          "$ref": "#/$defs/U64Decimal"
        },
        "sequence": {
          "$ref": "#/$defs/U64Decimal"
        },
        "visibility_revision": {
          "$ref": "#/$defs/U64Decimal"
        }
      },
      "required": [
        "epoch",
        "sequence",
        "filter_sha256",
        "visibility_revision",
        "issued_unix_ms",
        "expires_unix_ms"
      ],
      "type": "object"
    },
    "EventTopicV1": {
      "enum": [
        "task",
        "thread",
        "roster",
        "service",
        "analysis",
        "delivery",
        "recovery"
      ],
      "type": "string"
    },
    "Sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "U64Decimal": {
      "$comment": "Canonical decimal string, numeric range 0..18446744073709551615 inclusive.",
      "maxLength": 20,
      "minLength": 1,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "UuidV4": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "urn:hee3:control:1:request:events.subscribe",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "events.subscribe",
      "type": "string"
    },
    "action_version": {
      "const": 1,
      "type": "integer"
    },
    "authority": {
      "$ref": "#/$defs/AuthorityV1"
    },
    "body": {
      "$ref": "#/$defs/BodyRequest_events_subscribe"
    },
    "deadline_unix_ms": {
      "$ref": "#/$defs/U64Decimal"
    },
    "idempotency_key": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/UuidV4"
        }
      ]
    },
    "kind": {
      "const": "request",
      "type": "string"
    },
    "precondition": {
      "type": "null"
    },
    "protocol": {
      "const": "hee3.control",
      "type": "string"
    },
    "request_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "protocol",
    "version",
    "kind",
    "request_id",
    "action",
    "action_version",
    "idempotency_key",
    "deadline_unix_ms",
    "authority",
    "precondition",
    "body"
  ],
  "title": "HEE3-Control/1 events.subscribe v1 request schema",
  "type": "object"
}
