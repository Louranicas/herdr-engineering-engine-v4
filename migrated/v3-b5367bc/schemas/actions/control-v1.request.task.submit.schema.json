{
  "$comment": "Runtime binds authenticated principal/grant, exact request bytes/digest, deadline <=60000ms ahead, visibility, idempotency custody and resource identity/generation equality before dispatch. UUIDs and schema validation grant no authority.",
  "$defs": {
    "AuthorityV1": {
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "scope_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "grant_id",
        "scope_sha256"
      ],
      "type": "object"
    },
    "BodyRequest_task_submit": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/TaskSpecV1"
        }
      },
      "required": [
        "spec"
      ],
      "type": "object"
    },
    "BudgetV1": {
      "additionalProperties": false,
      "properties": {
        "currency_microunits": {
          "$ref": "#/$defs/U64Decimal"
        },
        "mode": {
          "enum": [
            "hard",
            "conservative"
          ],
          "type": "string"
        },
        "tokens": {
          "$ref": "#/$defs/U64Decimal"
        },
        "wall_ms": {
          "$ref": "#/$defs/U64Decimal"
        }
      },
      "required": [
        "mode",
        "wall_ms",
        "tokens",
        "currency_microunits"
      ],
      "type": "object"
    },
    "Sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "TaskSpecV1": {
      "$comment": "Runtime admits task_class, workspace, parent allocation and budget. RC01 overlay requires local_only privacy and zero currency; this vocabulary alone grants no remote capability.",
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/BudgetV1"
        },
        "criteria": {
          "items": {
            "$comment": "Runtime must validate UTF-8 and 1..1024 encoded bytes, reject unpaired surrogate code units, and avoid normalization. JSON Schema length counts Unicode code points, not bytes; maxLength is only a necessary upper bound.",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "intent": {
          "$comment": "Runtime must validate UTF-8 and 1..8192 encoded bytes, reject unpaired surrogate code units, and avoid normalization. JSON Schema length counts Unicode code points, not bytes; maxLength is only a necessary upper bound.",
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        "parent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "allocation_id": {
                  "$ref": "#/$defs/UuidV4"
                },
                "brief_revision": {
                  "$ref": "#/$defs/U64Decimal"
                },
                "task_id": {
                  "$ref": "#/$defs/UuidV4"
                }
              },
              "required": [
                "task_id",
                "allocation_id",
                "brief_revision"
              ],
              "type": "object"
            }
          ]
        },
        "privacy": {
          "enum": [
            "local_only",
            "remote_allowed"
          ],
          "type": "string"
        },
        "task_class": {
          "$comment": "ASCII includes controls; RC03 does not select a printable-only subset.",
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[^\\u0000-\\u007f]"
          },
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "required": [
        "task_class",
        "intent",
        "criteria",
        "privacy",
        "workspace_id",
        "budget",
        "parent"
      ],
      "type": "object"
    },
    "U64Decimal": {
      "$comment": "Canonical decimal string, numeric range 0..18446744073709551615 inclusive.",
      "maxLength": 20,
      "minLength": 1,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "type": "string"
    },
    "UuidV4": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "urn:hee3:control:1:request:task.submit",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "task.submit",
      "type": "string"
    },
    "action_version": {
      "const": 1,
      "type": "integer"
    },
    "authority": {
      "$ref": "#/$defs/AuthorityV1"
    },
    "body": {
      "$ref": "#/$defs/BodyRequest_task_submit"
    },
    "deadline_unix_ms": {
      "$ref": "#/$defs/U64Decimal"
    },
    "idempotency_key": {
      "$ref": "#/$defs/UuidV4"
    },
    "kind": {
      "const": "request",
      "type": "string"
    },
    "precondition": {
      "type": "null"
    },
    "protocol": {
      "const": "hee3.control",
      "type": "string"
    },
    "request_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "protocol",
    "version",
    "kind",
    "request_id",
    "action",
    "action_version",
    "idempotency_key",
    "deadline_unix_ms",
    "authority",
    "precondition",
    "body"
  ],
  "title": "HEE3-Control/1 task.submit v1 request schema",
  "type": "object"
}
