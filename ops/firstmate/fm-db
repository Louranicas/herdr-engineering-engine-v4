STATUS_VERBS = {"done": "PASS", "failed": "FAIL", "blocked": "BLOCKED", "needs-decision": "BLOCKED", "paused": "PASS_WITH_GAPS"}


def collapsed(text: str) -> list[str]:
    """Each line with its whitespace collapsed to single spaces; a verbatim paste survives re-wrapping of indentation only."""
    return [" ".join(ln.split()) for ln in text.splitlines()]


# A VERIFY line whose exit status is not its check's: the shape names why. fm-db owns this detector: it is the door, the
# highest rung. The workflow curator keeps no copy; it loads `verify_cannot_fail` from here. control.py's
# `brief-verify-section-parity` case requires every roster VERIFY line the curator's section reader finds, and this
# detector flags, to be among this door's `verify_findings`.
VERIFY_SINKS = {"tail": "pipe_into_tail_head", "head": "pipe_into_tail_head", "wc": "pipe_into_sink", "cat": "pipe_into_sink",
                "sort": "pipe_into_sink", "uniq": "pipe_into_sink", "tee": "pipe_into_sink"}
VERIFY_SWALLOWERS = ("echo", "printf", "true", ":")              # each exits 0 whatever ran before it
# A whole-line `( ... )` is a description, not a subshell, only when it opens with one of these prose words and holds no
# shell operator (SHELL_OPERATOR, outside quotes). `at`, `as`, `expect` and `see` are left out because each is also a
# command name.
VERIFY_DESCRIPTION = re.compile(r"^\(\s*(from|run from|the|each|every|all|in|on|with|expected|note|where|after|before|per|"
                                r"using|judged|this|these|only)\b", re.IGNORECASE)
SHELL_OPERATOR = re.compile(r"[|;]|&&")
# `bash -c '...'`, `sh -lc "..."`, `env [opts] [VAR=v ...] bash -c '...' [args] [redirections]`: read word by word on the
# masked text by `_shell_c`. These env options take the next word as their argument (`-u NAME`, `-C DIR`, `-S STRING`).
ENV_ARG_SHORT = "uCS"
ENV_ARG_LONG = ("--unset", "--chdir", "--split-string")
SHELLS = ("bash", "sh")
# Transparent command wrappers: each runs the command after its options and operands and passes that command's status
# through (or adds only failures unrelated to the work: timeout's 124 on expiry, sudo's auth failure). Name -> (short
# options that take the next word, long options that take the next word, operands before the command). `env` keeps its
# own reader above (`-S STRING` is a command line). Wrappers nest and may precede or follow `env`.
WRAPPERS: dict[str, tuple[str, tuple[str, ...], int]] = {
    "nice": ("n", ("--adjustment",), 0),
    "timeout": ("sk", ("--signal", "--kill-after"), 1),                  # DURATION
    "nohup": ("", (), 0),
    "stdbuf": ("ioe", ("--input", "--output", "--error"), 0),
    "setsid": ("", (), 0),
    "ionice": ("cn", ("--class", "--classdata"), 0),
    "taskset": ("", (), 1),                                                # MASK, or LIST under -c
    "chrt": ("TPD", ("--sched-runtime", "--sched-period", "--sched-deadline"), 1),   # PRIORITY
    "sudo": ("ugpChDrtUTRa", ("--user", "--group", "--prompt", "--close-from", "--host", "--chdir", "--role", "--type",
                              "--other-user", "--command-timeout", "--chroot", "--auth-type"), 0),
    "doas": ("uC", (), 0),
    "command": ("", (), 0),
    "exec": ("a", (), 0),
    "time": ("of", ("--output", "--format"), 0),
}
# Wrapper options after which no command runs (`ionice -p PID`, `taskset -p`, `chrt -p`, `command -v`): reading stops,
# and the fail-closed scan of `_shell_c` still judges any later `bash -c`.
WRAPPER_NO_COMMAND = {"ionice": "pP", "taskset": "p", "chrt": "pm", "command": "vV"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
PIPEFAIL_ON = re.compile(r"(?:^|\s)-[A-Za-z]*o\s+pipefail\b")
PIPEFAIL_OFF = re.compile(r"(?:^|\s)\+[A-Za-z]*o\s+pipefail\b")
PIPESTATUS_READ = re.compile(r"^(exit|test|\[\[?)\s+.*\$\{PIPESTATUS\[[^\]]*\]\}")


def _first_word(seg: str) -> str:
    w = seg.split()
    while w and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w[0]):          # leading VAR=value assignments
        w = w[1:]
    return os.path.basename(w[0]) if w else ""


def _mask(s: str) -> str:
    """`s` with quoted text, `$(..)` and process substitution `<(..)`/`>(..)` blanked to `Q`s of the same length: none of
    them splits, pipes, comments or sets the line's status, and every index into the mask is an index into `s`."""
    out = re.sub(r"'[^']*'|\"[^\"]*\"", lambda m: "Q" * len(m.group(0)), s)
    for m in reversed(list(re.finditer(r"[$<>]\(", out))):          # last opened first: a nested one goes before its parent
        depth, end = 0, len(out)
        for i in range(m.start() + 1, len(out)):
            depth += {"(": 1, ")": -1}.get(out[i], 0)
            if depth == 0:
                end = i + 1
                break
        out = out[:m.start()] + "Q" * (end - m.start()) + out[end:]
    return out


def _split(bare: str, raw: str, sep: str) -> list[tuple[str, str, str]]:
    """(operator before, masked piece, raw piece) for each piece of `bare` between matches of `sep`; the first operator is ''."""
    out, start, op = [], 0, ""
    for m in re.finditer(sep, bare):
        out.append((op, bare[start:m.start()], raw[start:m.start()]))
        start, op = m.end(), m.group(0)
    out.append((op, bare[start:], raw[start:]))
    return out


def _description(bare: str, raw: str) -> bool:
    """A whole `( ... )` that opens with a prose word and holds no unquoted shell operator: prose, not a subshell."""
    return raw.startswith("(") and raw.endswith(")") and bool(VERIFY_DESCRIPTION.match(raw)) and not SHELL_OPERATOR.search(bare)


def _words(bare: str) -> list[tuple[int, int]]:
    """(start, end) of each whitespace-separated word of the masked text; a quoted word is one word because it is masked."""
    return [(m.start(), m.end()) for m in re.finditer(r"\S+", bare)]


def _unquote(raw: str) -> str:
    """One shell word's text: a word wholly inside one pair of quotes loses them; any other word is kept as written."""
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "'\"" and raw[0] not in raw[1:-1]:
        return raw[1:-1]
    return raw


def _skip_options(words: list[tuple[str, str]], i: int, short_arg: str, long_arg: tuple[str, ...],
                  stop: str = "") -> tuple[int, bool]:
    """(index after the options starting at `i`, whether an option in `stop` was seen). An option in `short_arg` (clustered,
    as in `-oL`) or `long_arg` takes the rest of its word or the next word; `--opt=v` carries its own value; `--` ends them."""
    stopped = False
    while i < len(words) and words[i][0].startswith("-") and words[i][0] != "-":
        w = words[i][0]
        i += 1
        if w == "--":
            break
        if w.startswith("--"):
            if w in long_arg:
                i += 1
            continue
        for k, ch in enumerate(w[1:], start=1):
            stopped = stopped or ch in stop
            if ch in short_arg:
                if k + 1 == len(w):
                    i += 1
                break
    return i, stopped


def _shell_string(words: list[tuple[str, str]], i: int) -> set[str]:
    """The shapes of the command string when `words[i]` is a shell (`bash`, `sh`) run with a `-c` cluster; else none."""
    if i >= len(words) or os.path.basename(words[i][0]) not in SHELLS:
        return set()
    i += 1
    has_c, pipefail = False, False
    while i < len(words) and words[i][0][:1] in "-+" and len(words[i][0]) > 1 and words[i][0] != "--":
        w = words[i][0]
        i += 1
        if w.startswith("--"):
            continue
        if w[1:].endswith("o") and i < len(words):                    # `-o NAME` / `+o NAME` / `-eo NAME`
            if words[i][0] == "pipefail":
                pipefail = w[0] == "-"
            i += 1
        has_c = has_c or (w[0] == "-" and "c" in w[1:])
    if i < len(words) and words[i][0] == "--":
        i += 1
    if not has_c or i >= len(words):
        return set()
    inner = _unquote(words[i][1])
    return set(verify_cannot_fail(("set -o pipefail; " if pipefail else "") + inner))


def _shell_c(bare: str, raw: str) -> set[str]:
    """The shapes of the command string when this command runs `bash -c '...'` / `sh -c`, directly or behind wrappers.

    Leading `VAR=v` words are skipped, then any chain of `env` and the transparent wrappers of WRAPPERS (`nice`,
    `timeout`, `nohup`, `stdbuf`, `setsid`, `ionice`, `taskset`, `chrt`, `sudo`, `doas`, `command`, `exec`, `time`), each
    with its own options, the argument of those that take one, its operands (timeout's DURATION, taskset's MASK, chrt's
    PRIORITY) and any `VAR=v` words after it; they nest in any order (`nice timeout 60 env X=1 bash -c ...`). `env`'s
    options are `-u`/`-C`/`-S`/`--unset`/`--chdir`/`--split-string`; `env -S STRING` is itself a command line and is read
    the same way. The shell's first non-option word after a `-c` cluster is the command string; words after it (`2>&1`,
    `_`, positional arguments) are not part of it. `bash -o pipefail -c '...'` judges the string with pipefail on.

    Fail closed: when the word reached is not a shell (an unknown wrapper such as `mywrap --opt bash -c '...'`, or a
    wrapper option after which no command runs), every later unquoted word whose basename is a shell and which is followed
    by a `-c` cluster has its string judged too. Reading an unknown wrapper as transparent can only refuse more lines
    whose string cannot fail; it never admits one."""
    words = [(bare[a:b], raw[a:b]) for a, b in _words(bare)]
    i = 0
    while i < len(words) and ASSIGNMENT.match(words[i][0]):
        i += 1
    while i < len(words):
        name = os.path.basename(words[i][0])
        if name == "env":
            i += 1
            while i < len(words) and words[i][0].startswith("-") and words[i][0] != "-":
                w, wr = words[i]
                i += 1
                if w == "--":
                    break
                split = None
                if w.startswith("--"):
                    if w in ENV_ARG_LONG and i < len(words):
                        split, i = (words[i][1] if w == "--split-string" else None), i + 1
                    elif w.startswith("--split-string="):
                        split = wr.split("=", 1)[1]
                else:
                    for k, ch in enumerate(w[1:], start=1):
                        if ch in ENV_ARG_SHORT:
                            if k + 1 < len(w):
                                split = wr[k + 1:]
                            elif i < len(words):
                                split, i = words[i][1], i + 1
                            if ch != "S":
                                split = None
                            break
                if split is not None:                                 # `-S STRING`: the rest of the command is that string
                    inner = _unquote(split) + " " + " ".join(r for _, r in words[i:])
                    return _shell_c(_mask(inner), inner)
        elif name in WRAPPERS:
            short_arg, long_arg, operands = WRAPPERS[name]
            i, stopped = _skip_options(words, i + 1, short_arg, long_arg, WRAPPER_NO_COMMAND.get(name, ""))
            if stopped:
                break
            i += operands
        else:
            break
        while i < len(words) and ASSIGNMENT.match(words[i][0]):
            i += 1
    if i < len(words) and os.path.basename(words[i][0]) in SHELLS:
        return _shell_string(words, i)
    shapes: set[str] = set()
    for j in range(i + 1, len(words)):                                # fail closed: a shell later on the line
        shapes |= _shell_string(words, j)
    return shapes


def _pipefail(bare: str, on: bool) -> bool:
    """The pipefail setting after one command: only `set -o pipefail` (or `-eo`, `-euo` ...) sets it, `set +o` clears it."""
    if _first_word(bare) != "set":
        return on
    return False if PIPEFAIL_OFF.search(bare) else (True if PIPEFAIL_ON.search(bare) else on)


def _judge(bare: str, raw: str) -> set[str]:
    """The cannot-fail shapes of one command text (masked and raw, same length), subshell parentheses read as spaces."""
    bare = bare.replace("(", " ").replace(")", " ")
    chunks = [(b.strip(), r.strip()) for _, b, r in _split(bare, raw, r";") if b.strip()]
    if not chunks:
        return set()
    on = False
    for b, _ in chunks[:-1]:
        on = _pipefail(b, on)
    last_b, last_r = chunks[-1]
    shapes: set[str] = set()
    if len(chunks) > 1 and (_first_word(last_b) in VERIFY_SWALLOWERS or re.match(r"^exit\s+0$", last_b)):
        shapes.add("echo_rc" if "$?" in last_b else "trailing_true")
    parts = [(op, b.strip(), r.strip()) for op, b, r in _split(last_b, last_r, r"&&|\|\|")]
    if len(parts) > 1 and parts[-1][0] == "||" and (_first_word(parts[-1][1]) in VERIFY_SWALLOWERS
                                                    or re.match(r"^exit\s+0$", parts[-1][1])):
        shapes.add("or_true")
    for i, (_, b, r) in enumerate(parts):
        on = _pipefail(b, on)
        stages = [(sb, sr) for _, sb, sr in _split(b, r, r"\|&?") if sb.strip()]   # `|&` pipes stderr too; its sink is the next word
        if not stages:
            continue
        segs = [sb.strip() for sb, _ in stages]
        sink = _first_word(segs[-1])
        read = i + 1 < len(parts) and parts[i + 1][0] == "&&" and bool(PIPESTATUS_READ.match(parts[i + 1][2]))
        if len(segs) > 1 and not on and not read and sink in VERIFY_SINKS:
            shapes.add(VERIFY_SINKS[sink])
        if sink in ("grep", "egrep", "rg") and any(re.match(r"^-[A-Za-z]*v", o) for o in segs[-1].split()[1:]):
            shapes.add("inverted_grep")
        for sb, sr in (stages if on else stages[-1:]):                   # the stages whose status is this part's
            shapes |= _shell_c(sb, sr)
    return shapes


def verify_cannot_fail(line: str) -> list[str]:
    """The shapes that keep one VERIFY line from failing; [] when its exit status is its check's.

    What is judged: a markdown bullet (`- `, `* `, `1. `) and a backtick wrapper are stripped; quoted text and `$(..)` are
    masked; an unquoted `#` at the start or after whitespace starts a comment, which is dropped; a whole line `( ... )`
    that opens with a prose word (VERIFY_DESCRIPTION: `(from the worktree root)`) and holds no unquoted `|`, `;`, `&&` or
    `||` is a description and is not judged, and any other parenthesised text is a subshell, judged as a command. The command
    string of `bash -c` or `sh -c`, directly or behind `env` and the transparent wrappers of WRAPPERS (`nice`, `timeout`,
    `sudo` ...), is judged as a line of its own, recursively; an unknown wrapper fails closed (`_shell_c`).
    A trailing annotation after two or more spaces,
    `x  (rc=0; ...)`, is cut off, and the line before it and the annotation (unless a description) are judged apart.

    How: `a; b` exits with b, so only the last `;` command counts; in it every `&&`/`||` part must carry its status to
    the end. A pipeline (`|` or `|&`) is judged by its LAST stage (`x | tail -1` cannot fail, `x | grep -q PASS` can)
    unless an earlier command ran `set -o pipefail` (and no later `set +o pipefail`), or the next part is `&& exit
    ${PIPESTATUS[..]}` or a `test`/`[` of it. `|| true`, `|| :`, `|| exit 0`, `|| echo ..`, a trailing `; true`, `; exit
    0` or `; echo rc=$?` swallow the status; `grep -v` succeeds whenever any line differs."""
    s = line.strip()
    s = re.sub(r"^(-|\*|\d+[.)])\s+", "", s)
    if s.startswith("`") and s.count("`") >= 2:
        s = s[1:s.index("`", 1)].strip()
    bare = _mask(s)
    comment = re.search(r"(?:^|\s)#", bare)
    if comment:
        s, bare = s[:comment.start()].rstrip(), bare[:comment.start()].rstrip()
    if not s:
        return []
    if _description(bare, s):
        return []
    note = re.search(r"\s{2,}\(", bare)
    if not note:
        return sorted(_judge(bare, s))
    cut = note.end() - 1
    shapes = _judge(bare[:cut], s[:cut])
    if not _description(bare[cut:], s[cut:]):
        shapes |= _judge(bare[cut:], s[cut:])
    return sorted(shapes)


def verify_findings(text: str) -> list[tuple[int, list[str], str]]:
    """(file line number, shapes, line) for every VERIFY line of a brief that cannot fail. Every VERIFY section is read:
    the `VERIFY:` field and any `VERIFY (...):` section after it (SECTION_LABEL), each running to the next section label."""
    out, in_verify = [], False
    for n, ln in enumerate(text.splitlines(), start=1):
        label = SECTION_LABEL.match(ln)
        if label is not None:
            in_verify = label.group(1) == "VERIFY"
            ln = ln[label.end():]
        if in_verify:
            shapes = verify_cannot_fail(ln)
            if shapes:
                out.append((n, shapes, ln.strip()))
    return out


def verify_refusal(text: str) -> str | None:
    """The first VERIFY line (file line number) that cannot fail, as the typed refusal; None when every line can fail."""
    for n, shapes, ln in verify_findings(text):
        return f"verify_line_cannot_fail line={n} shape={','.join(shapes)}: {ln}"
    return None


def brief_row(d: dict[str, str]) -> str | None:
    """Fill the computed brief columns in place; return the typed refusal detail, or None when the brief is admissible."""
    path = Path(d.get("path") or "")
    if not path.is_file():
        return f"brief_path_unreadable: {path}"
    if not STANDING_ORDERS.is_file():
        return f"standing_orders_absent: {STANDING_ORDERS}"
    body = path.read_bytes()
    standing = STANDING_ORDERS.read_bytes()
    if not d.get("head_sha"):
        try:
            g = subprocess.run(["git", "-C", str(HEE4_ROOT), "rev-parse", "HEAD"], capture_output=True, text=True, stdin=subprocess.DEVNULL)
            d["head_sha"] = g.stdout.strip() if g.returncode == 0 else ""
        except OSError:
            d["head_sha"] = ""
        if not d["head_sha"]:                                            # never an empty string (standing order 4, AP-29)
            return f"head_sha_unmeasured; pass --head-sha (git -C {HEE4_ROOT} rev-parse HEAD failed)"
    text = body.decode("utf-8", "replace")
    for label in BRIEF_FIELDS:                                           # column 0, `LABEL:` — brief.rs:63-64
        if not any(ln.startswith(label + ":") for ln in text.splitlines()):
            return f"brief_field_missing={label}"
    standing_lines = standing.decode("utf-8", "replace").splitlines()
    first_body = 1 if standing_lines and standing_lines[0].startswith("#") else 0   # the H1 is the file's title, not an order
    present = set(collapsed(text))
    for n, ln in enumerate(standing_lines, start=1):
        if n > first_body and ln.strip() and " ".join(ln.split()) not in present:
            return f"standing_not_verbatim line={n}: standing orders are pasted verbatim, never summarised (PROTOCOL §2)"
    refusal = verify_refusal(text)
    if refusal:
        return refusal
    d["brief_sha"] = hashlib.sha256(body).hexdigest()
    d["standing_sha"] = hashlib.sha256(standing).hexdigest()
    return None


def record(kind: str, args: list[str]) -> int:
    if kind not in COLS:
        return out("record", "USAGE", 2, detail=f"unknown kind {kind!r}; one of {sorted(COLS)}")
    table, cols = COLS[kind]
    d = kv(args)
    d.setdefault("ts", ts())
    if kind == "unit":
        d.setdefault("opened_ts", d.pop("ts"))
    if kind == "brief" and "unit" in d:
        d["unit_id"] = d.pop("unit")                                     # `--unit U` is the CLI spelling of unit_id
    if kind == "exit" and d.get("verdict") in STATUS_VERBS:        # Firstmate status verb → roster verdict
        d["verdict"] = STATUS_VERBS[d["verdict"]]
    if kind == "andon":
        d["measured"] = "1" if d.get("measured", "0") in ("1", "true", "yes") else "0"
    extra = sorted(set(d) - set(BRIEF_KEYS if kind == "brief" else cols))
    if extra:
        return out("record", "USAGE", 2, detail=f"unknown keys {extra}; allowed {BRIEF_KEYS if kind == 'brief' else cols}")
    if kind == "brief":
        refusal = brief_row(d)
        if refusal:
            return out("record", "REFUSED", 20, detail=refusal)
    row = {c: d.get(c) for c in cols}
    try:
        with Writer() as con:
            if kind == "spawn":  # planned_agents is enforced HERE (Firstmate has no cap)
                u = row["unit_id"]
                r = con.execute("SELECT planned_agents, (SELECT count(*) FROM spawns WHERE unit_id=?), closed_ts FROM units WHERE unit_id=?",
                                (u, u)).fetchone()
                if r is None:
                    return out("record", "REFUSED", 20, detail=f"no unit {u!r}; record the unit first")
                if r[2] is not None:
                    return out("record", "REFUSED", 20, detail=f"unit_closed: {u} closed at {r[2]}; open a new unit")
                if r[1] >= r[0]:
                    return out("record", "REFUSED", 20, detail=f"planned_agents={r[0]} already spawned={r[1]}; raise the plan in a new unit, do not exceed it")
                if con.execute("SELECT 1 FROM andon WHERE unit_id=? AND cleared_ts IS NULL", (u,)).fetchone():
                    return out("record", "REFUSED", 20, detail="open andon on this unit: no spawn until the captain clears it")
                if not con.execute("SELECT 1 FROM briefs WHERE unit_id=?", (u,)).fetchone():   # PROTOCOL §2: the brief is the only start
                    return out("record", "REFUSED", 20, detail=f"no brief recorded for unit {u}; record the brief first")
                if not row["brief_sha"]:                                 # V4-99: the spawn names the brief it starts from
                    return out("record", "REFUSED", 20, detail=f"brief_sha_missing: pass --brief-sha (the sha of unit {u}'s recorded brief)")
                b = con.execute("SELECT unit_id FROM briefs WHERE brief_sha=?", (row["brief_sha"],)).fetchone()
                if b is None:
                    return out("record", "REFUSED", 20, detail=f"brief_sha_unknown: {row['brief_sha']} is not a recorded brief")
                if b[0] != u:
                    return out("record", "REFUSED", 20, detail=f"brief_sha_unit_mismatch: brief belongs to unit {b[0]}, spawn names {u}")
            if kind == "brief":
                b = con.execute("SELECT unit_id FROM briefs WHERE brief_sha=?", (row["brief_sha"],)).fetchone()
                if b is not None:
                    return out("record", "REFUSED", 20, detail=f"brief_already_recorded sha={row['brief_sha'][:12]} unit={b[0]}")
            given = [c for c in cols if row[c] is not None]          # absent keys take the schema's defaults
            cur = con.execute(f"INSERT INTO {table} ({','.join(given)}) VALUES ({','.join('?' * len(given))})", [row[c] for c in given])
            rid = cur.lastrowid
    except sqlite3.IntegrityError as e:
        return out("record", "REFUSED", 20, detail=str(e))
    return out("record", "PASS", 0, kind=kind, table=table, rowid=rid)


def clear_andon(args: list[str]) -> int:
    d = kv(args)
    with Writer() as con:
        n = con.execute("UPDATE andon SET cleared_by=?, cleared_ts=? WHERE andon_id=? AND cleared_ts IS NULL", (d.get("by"), ts(), d.get("id"))).rowcount
    return out("clear-andon", "PASS" if n else "REFUSED", 0 if n else 20, cleared=n)


def close_unit(args: list[str]) -> int:
    """Close a unit: every spawn has an exit and no andon is open; unverified MEASURED claims are reported, not refused."""
    d = kv(args)
    u, who = d.get("id"), d.get("by")
    if not u or not who or set(d) - {"id", "by"}:
        return out("close-unit", "USAGE", 2, detail="close-unit --id UNIT --by WHO")
    with Writer() as con:
        r = con.execute("SELECT closed_ts FROM units WHERE unit_id=?", (u,)).fetchone()
        if r is None:
            return out("close-unit", "REFUSED", 20, detail=f"no unit {u!r}")
        if r[0] is not None:
            return out("close-unit", "REFUSED", 20, detail=f"already_closed: {u} closed at {r[0]}")
        if con.execute("SELECT 1 FROM andon WHERE unit_id=? AND cleared_ts IS NULL", (u,)).fetchone():
            return out("close-unit", "REFUSED", 20, detail="open andon on this unit: the captain clears it before the unit closes")
        m = con.execute("SELECT s.task_id FROM spawns s LEFT JOIN exits e ON e.task_id = s.task_id "
                        "WHERE s.unit_id=? AND e.task_id IS NULL ORDER BY s.ts, s.task_id LIMIT 1", (u,)).fetchone()
        if m:
            return out("close-unit", "REFUSED", 20, detail=f"spawn_without_exit task_id={m[0]}; record its exit first")
        k = con.execute("SELECT count(*) FROM spawns WHERE unit_id=?", (u,)).fetchone()[0]
        e = con.execute("SELECT count(*) FROM exits e JOIN spawns s ON s.task_id = e.task_id WHERE s.unit_id=?", (u,)).fetchone()[0]
        n = con.execute("SELECT count(*) FROM claims c JOIN spawns s ON s.task_id = c.task_id WHERE s.unit_id=? AND c.label='MEASURED' "
                        "AND NOT EXISTS (SELECT 1 FROM verifications v WHERE v.claim_id = c.claim_id)", (u,)).fetchone()[0]
        con.execute("UPDATE units SET closed_ts=? WHERE unit_id=?", (ts(), u))
    return out("close-unit", "PASS", 0, unit_id=u, by=who, spawns=k, exits=e, unverified=n)


def q(sql: str) -> int:
    if not sql.lstrip().upper().startswith("SELECT"):
        return out("q", "REFUSED", 20, detail="one SELECT only")
    if not Path(TURSODB).exists():
        return out("q", "UNMEASURED", 30, detail=f"tursodb absent at {TURSODB}")
    p = subprocess.run([TURSODB, "-q", "--readonly", "-m", "list", str(DB), f"{sql.rstrip(';')} LIMIT {Q_CAP}"],
                       stdin=subprocess.DEVNULL, capture_output=True, text=True)
    rows = [ln.split("|") for ln in p.stdout.splitlines() if ln]
    return out("q", "PASS" if p.returncode == 0 else "FAIL", 0 if p.returncode == 0 else 20, rows=rows, rc=p.returncode, stderr=p.stderr[:200])


def status() -> int:
    if not DB.exists():
        return out("status", "UNMEASURED", 30, detail="no database; run fm-db init")
    con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    cur = con.execute("SELECT * FROM open_units")
    names = [c[0] for c in cur.description]                              # the view's own columns, never a typed list
    units = [dict(zip(names, r, strict=True)) for r in cur]
    unverified = con.execute("SELECT count(*) FROM claims c WHERE c.label='MEASURED' AND NOT EXISTS (SELECT 1 FROM verifications v WHERE v.claim_id=c.claim_id)").fetchone()[0]
    con.close()
    return out("status", "PASS", 0, open_units=units, measured_claims_unverified=unverified)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__); return 2
    v = argv[1]
    homes = db_outside_home()
    if homes:
        return out(v, "SETUP", 3, detail=homes)
    if v == "init": return init()
    if v in ("record", "clear-andon", "close-unit", "q", "status") and (DB.exists() or v != "status"):
        behind = schema_behind()                                         # before any write or read-back
        if behind:
            return out(v, "SETUP", 3, detail=behind)
    if v == "record": return record(argv[2], argv[3:]) if len(argv) > 2 else out("record", "USAGE", 2)
    if v == "clear-andon": return clear_andon(argv[2:])
    if v == "close-unit": return close_unit(argv[2:])
    if v == "q": return q(" ".join(argv[2:]))
    if v == "status": return status()
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
