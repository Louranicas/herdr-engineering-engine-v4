def verb_ingest(a, o: Out) -> int:
    need_db(a.db)
    started = now_utc()
    plan, acct = enumerate_world()
    unexplained = [x for x in acct if x["status"] == "unexplained"]
    parsed: list[tuple[str, str, str, str, int, dict]] = []
    absent = []
    try:
        if unexplained:
            raise Refusal("ingest_world_unexplained", f"{len(unexplained)} file(s) match a world glob with no parser or reason: "
                          + ", ".join(f"{x['root']}:{x['rel']}" for x in unexplained))
        for root, rel, parser in sorted(plan):
            p = ROOTS[root] / rel
            if not p.exists():
                absent.append(f"{root}:{rel}")
                continue
            data = read_source(p)
            try:
                text = data.decode("utf-8")
            except UnicodeDecodeError as e:
                raise Refusal("ingest_malformed", f"source={root}:{rel} not UTF-8: {e}") from e
            res = PARSERS[parser](text, rel)
            parsed.append((root, rel, parser, sha256_bytes(data), len(data), res))
        if absent:
            raise Refusal("ingest_source_absent", "declared source(s) missing: " + ", ".join(absent)
                          + " (an absent source is never ingested as zero rows)", EXIT_UNMEASURED)
        cross_check_parsed(parsed)
        reg, reg_lines = collect_registry(started)       # rev 2026-10-01 registry: read before the write, refused as one unit
    except Refusal as r:
        record_failed_receipt(a.db, "ingest", started, r, len(plan))
        raise
    con0 = ro_connect(a.db)
    prev = {(r[0], r[1]): r[2] for r in con0.execute("SELECT root, rel_path, sha256 FROM sources")}
    con0.close()
    ts = now_utc()
    counts: dict[str, int] = {}
    changed = 0
    with Writer(a.db) as con:
        for t in reversed(DERIVED_TABLES):
            con.execute(f'DELETE FROM "{t}"')
        con.execute("DELETE FROM sources")
        for root, rel, parser, sha, nbytes, res in parsed:
            nrows = sum(len(v) for k, v in res.items() if k not in CHILD_TABLES)
            cur = con.execute("INSERT INTO sources(root, rel_path, parser, sha256, bytes, rows_derived, ingested_at) VALUES(?,?,?,?,?,?,?)",
                              (root, rel, parser, sha, nbytes, nrows, ts))
            sid = cur.lastrowid
            for table, rows in res.items():
                for r in rows:
                    insert_derived(con, table, r, sid, sha, ts)
                counts[table] = counts.get(table, 0) + len(rows)
            state = "new" if (root, rel) not in prev else ("unchanged" if prev[(root, rel)] == sha else "changed")
            changed += state != "unchanged"
            o.line(f"source={root}:{rel} parser={parser} rows={nrows} sha={sha[:12]} {state}")
        for x in acct:
            o.line(f"excluded={x['root']}:{x['rel']} reason={x['reason']}")
        removed = sorted(set(prev) - {(r, rel) for r, rel, *_ in parsed})
        for r, rel in removed:
            o.line(f"source_removed={r}:{rel}")
        write_registry(con, reg, ts)
        reg_counts = {t: len(reg[t]) for t in REGISTRY_TABLES}
        detail = {"counts": counts, "excluded": len(acct), "removed": len(removed), "registry": reg_counts}
        con.execute("INSERT INTO ingest_receipts(verb, started_at, finished_at, status, sources_seen, sources_changed, rows_written, detail_json) "
                    "VALUES('ingest',?,?,?,?,?,?,?)", (started, now_utc(), "ok", len(parsed), changed, sum(counts.values()), json.dumps(detail)))
    expected = py_counts(a.db, DERIVED_TABLES + ["sources"] + REGISTRY_TABLES)
    check_readback(a.db, expected, o)
    for t in DERIVED_TABLES:
        o.line(f"table={t} rows={counts.get(t, 0)}")
    for t in REGISTRY_TABLES:
        o.line(f"registry table={t} rows={reg_counts[t]}")
    reg_unreadable = [r for r in reg["registry_sources"] if r["status"] == "unreadable"]
    for r in reg["registry_sources"]:
        if r["status"] != "ok":
            o.line(f"registry_source kind={r['kind']} scope={r['scope']} status={r['status']} path={r['path']} detail={r['detail']}")
    for ln in reg_lines:
        o.line(ln)
    n_side = build_sidecar(a.db, o)
    o.doc.update({"sources": len(parsed), "changed": changed, "counts": counts, "sidecar_rows": n_side, "registry": reg_counts})
    world = len(parsed) + len(acct)
    return o.emit(EXIT_OK if not reg_unreadable else EXIT_GAPS, f"{len(parsed)}/{world - len(acct)}",
                  f"world={world} parsed={len(parsed)} excluded={len(acct)} unexplained=0 changed={changed} "
                  f"registry_rows={sum(reg_counts.values())} registry_unreadable={len(reg_unreadable)}")


