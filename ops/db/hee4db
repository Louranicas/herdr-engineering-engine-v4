    return res


# Jev Fit Map (rev 2026-10-01 jev-fit) ------------------------------------------------------------
JEV_FIT_SECTIONS = ("3a", "3b", "3c", "3d")
JEV_FIT_ID = ("J", "E", "W", "R", "Q", "A", "S")
JEV_GRADES = ("A", "B", "C", "X")
JEV_CLUSTERS = {"K0": "K0", "K0h": "K0h", "K0e": "K0e", "K1": "K1", "K2": "K2", "K3": "K3", "K4": "K4", "K5": "K5",
                "K6": "K6", "tooling": "outside"}
# the ONE rule for "this data class is engine data" (the parser sets engine_data; jev_scope reads it)
JEV_ENGINE_MARKS = ("engine data", "engine logs", "engine source", "v4 planning text", "v4 report text", "v4 files",
                    "task context in v4")
JEV_SELFCHECK_PREFIX = "jev-fit-map verdict="


def code_spans(s: str) -> list[tuple[str, str]]:
    """[(text_before, span)] for every `code` span, plus a final (tail, '')."""
    out, i, last = [], 0, 0
    while True:
        a = s.find("`", i)
        if a < 0:
            break
        b = s.find("`", a + 1)
        if b < 0:
            break
        out.append((s[last:a], s[a + 1:b]))
        last = i = b + 1
    out.append((s[last:], ""))
    return out


def fit_module_claims(where: str) -> list[tuple[str, str]]:
    """(cluster, module head) for each `<cluster> \\`name\\`` in a Where cell; '/' or ',' continues the previous claim."""
    claims, prev = [], None
    for before, span in code_spans(where):
        if not span:
            break
        toks = before.split()
        sep = before.strip()
        if toks and toks[-1] in JEV_CLUSTERS:
            cl = JEV_CLUSTERS[toks[-1]]
        elif prev and sep in ("/", ","):
            cl = prev
        else:
            prev = None
            continue
        head = span
        for cut in ("::", "(", ".", " "):
            head = head.split(cut, 1)[0]
        claims.append((cl, head.strip()))
        prev = cl
    return claims


def h_ids(text: str) -> list[str]:
    """H-n ids (H-10a, H-10b …) in reading order, deduplicated."""
    out = []
    for tok in text.replace("(", " ").replace(")", " ").replace(",", " ").replace(";", " ").split():
        t = tok.strip(".:*`~")
        if t.startswith("H-") and t[2:].rstrip("abcdefghijklmnopqrstuvwxyz").isdigit() and t not in out:
            out.append(t)
    return out


def drop_parens(s: str) -> str:
    """Remove (…) spans, nested or not: a parenthetical cites a source and is not the data class itself."""
    out, depth = [], 0
    for ch in s:
        if ch == "(":
            depth += 1
        elif ch == ")" and depth:
            depth -= 1
        elif depth == 0:
            out.append(ch)
    return "".join(out)


def jev_selfcheck(text: str) -> dict | None:
    """The fit map's self-check line `jev-fit-map verdict=… intersections=N A=… B=… C=… X=…` as a dict, or None."""
    for _, ln, fenced in md_lines(text):
        s = ln.strip().strip("`")
        if not fenced and s.startswith(JEV_SELFCHECK_PREFIX):
            kv = dict(t.split("=", 1) for t in s.split() if "=" in t)
            return {"line": s, **kv}
    return None


def parse_jev_fit_map(text: str, src: str) -> dict:
    """The Jev Fit Map: a design note AND §3's tables 3a–3d (the single home of the decision intersections)."""
    res = parse_design_note(text, src)
    lines = md_lines(text)
    tbls = [t for t in md_tables(lines) if t["heading"][:2] in JEV_FIT_SECTIONS and t["heading"][2:4] == " ·"
            and t["header"] and t["header"][0].strip() == "#"]
    secs = [t["heading"][:2] for t in tbls]
    if secs != list(JEV_FIT_SECTIONS):
        raise Refusal("ingest_malformed", f"source={src} expected the §3 tables {list(JEV_FIT_SECTIONS)} (| # | Decision | … | Grade and reason | Today |), found {secs}")
    # §3d session rule: the H-ids that hold every non-X Claude-session row in a v4 session
    session_gates: list[str] = []
    for s in sections(lines, 3):
        if s["title"].startswith("3d ·"):
            para = next((p for p in s["text"].split("\n\n") if p.startswith("**Session rule")), None)
            if para is None:
                raise Refusal("ingest_malformed", f"source={src} §3d has no '**Session rule' paragraph")
            session_gates = h_ids(para)
    # §7: gate → the fits that wait on it (explicit ids, and "every J row")
    gate_fits: list[tuple[str, str]] = []
    g7 = [t for t in md_tables(lines) if t["heading"].startswith("§7") and t["header"] and t["header"][0].strip().lower() == "gate"]
    if len(g7) != 1:
        raise Refusal("ingest_malformed", f"source={src} expected exactly 1 §7 gate table (| Gate | … | Fits that wait on it |), found {len(g7)}")
    hm7 = header_map(g7[0]["header"], {"gate": ("gate",), "fits": ("fits that wait",)}, src)
    for _no, cells in g7[0]["rows"]:
        gid = next(iter(h_ids(strip_md(cell(cells, hm7["gate"])))), None)
        if gid:
            gate_fits.append((gid, strip_md(cell(cells, hm7["fits"]))))
    rows, links = [], []
    for t in tbls:
        sec = t["heading"][:2]
        hm = header_map(t["header"], {"id": ("#",), "decision": ("decision",), "where": ("where",), "type": ("type",),
                                      "data": ("data class",), "baseline": ("code baseline",), "threshold": ("threshold",),
                                      "cost": ("cost",), "grade": ("grade",), "today": ("today",)}, src)
        for no, cells in t["rows"]:
            fid = id_token(cell(cells, hm["id"]), JEV_FIT_ID)
            if not fid:
                raise Refusal("ingest_malformed", f"source={src} line {no} §{sec} row without a fit id: {cell(cells, 0)[:40]!r}")
            if len(cells) != len(t["header"]):
                raise Refusal("ingest_malformed", f"source={src} line {no} {fid} has {len(cells)} cells, header has {len(t['header'])} (an unescaped '|'?)")
            gcell = cell(cells, hm["grade"])
            gtok = first_bold(gcell)
            grade = gtok.replace(",", " ").replace(":", " ").split()[0] if gtok.split() else ""
            if grade not in JEV_GRADES:
                raise Refusal("ingest_malformed", f"source={src} line {no} {fid} grade {grade!r} not in {JEV_GRADES}")
            extra = gtok[len(grade):].strip(" ,:")
            after = gcell[gcell.find("**", gcell.find("**") + 2) + 2:].strip(" :,;") if "**" in gcell else gcell
            reason = strip_md("; ".join(x for x in (extra, after) if x))
            dcell = cell(cells, hm["data"])
            bolds = strip_md(first_bold(dcell)).lower()
            dtext = strip_md(dcell)
            if dtext in ("—", "-", ""):
                allowed = "n/a"
            elif bolds.startswith("yes"):
                allowed = "yes"
            elif bolds.startswith("no"):
                allowed = "no"
            else:
                allowed = "conditional"
            engine = int(any(m in drop_parens(dtext).lower() for m in JEV_ENGINE_MARKS))   # citations in (…) are not the class
            where = strip_md(cell(cells, hm["where"]))
            phases = [p for p in (tok.strip(".,;:()") for tok in where.split()) if p in PHASES_ALL]
            gates = h_ids(dtext)
            for gid, fits in gate_fits:
                named = {x.strip(".,;:()") for x in fits.replace(",", " ").split()}
                if fid in named or (grade != "X" and fid.startswith("J") and "every J row" in fits):
                    gates.append(gid)
            if sec == "3d" and grade != "X":
                gates += session_gates
            gates = list(dict.fromkeys(gates))
            claims = fit_module_claims(cell(cells, hm["where"]))
            mods = []
            for cl, head in claims:
                if head in mods:
                    continue
                mods.append(head)
                links.append({"fit_id": fid, "module": head, "cluster": cl, "line": no})
            if mods:
                mcell = ", ".join(mods)
            elif where.lower().startswith("all crates"):
                mcell = "ALL"
            else:
                mcell = "UNMAPPED"
            today = strip_md(cell(cells, hm["today"]))
            rows.append({"id": fid, "section": sec, "decision": strip_md(cell(cells, hm["decision"])), "where_cell": where,
                         "question_type": strip_md(cell(cells, hm["type"])), "data_class": dtext.split("; ", 1)[0],
                         "engine_data": engine, "allowed_now": allowed, "baseline": strip_md(cell(cells, hm["baseline"])),
                         "threshold_source": strip_md(cell(cells, hm["threshold"])), "cost_estimate": strip_md(cell(cells, hm["cost"])),
                         "grade": grade, "grade_reason": reason, "measured_value": None if today in ("—", "-", "") else today,
                         "phases": ",".join(dict.fromkeys(phases)), "gates": ",".join(gates), "modules": mcell, "line": no})
    ids = [r["id"] for r in rows]
    dup = sorted({i for i in ids if ids.count(i) > 1})
    if dup:
        raise Refusal("ingest_malformed", f"source={src} jev fit map duplicate id {','.join(dup)}")
    res["jev_fits"] = rows
    res["jev_fit_modules"] = links
    return res


