# FTS corpus: (kind, id expression, title, body) per derived/imported table.
FTS_CORPUS = [
    ("decision", "decisions", "id", "title", "body"),
    ("ap", "antipatterns", "id", "name", "definition || ' ' || tell || ' ' || detector"),
    ("ex", "exemplars", "id", "title", "body"),
    ("drift", "drift_controls", "id", "title", "body"),
    ("note", "design_notes", "path", "title", "body"),
    ("held", "held_items", "id", "title", "item || ' ' || why"),
    ("loop", "loops", "id", "title", "evidence"),
    ("learning", "habitat_learnings", "id", "title", "body"),
    ("dc", "design_conflicts", "id", "title", "conflict || ' ' || recommendation"),
]


def sidecar_path(db: Path) -> Path:
    return db.with_name(db.stem + "-search.db")


def corpus_signature(db: Path) -> str:
    con = ro_connect(db)
    try:
        h = hashlib.sha256()
        for _, table, idc, tc, bc in FTS_CORPUS:
            for r in con.execute(f"SELECT {idc}, {tc}, {bc} FROM {table} ORDER BY 1"):
                h.update(json.dumps(r, ensure_ascii=False).encode())
        return h.hexdigest()
    finally:
        con.close()


def build_sidecar(db: Path, o: Out) -> int:
    """Rebuild the Tantivy sidecar: plain rows written by Python into a temp file, then ONE tursodb
    statement per call (argument form stops at the first error; no BEGIN/ROLLBACK around FTS, which
    panics on 0.7.2), verified by count, fsynced and renamed into place."""
    side = sidecar_path(db)
    sig = corpus_signature(db)
    tmpd = Path(tempfile.mkdtemp(prefix=".sidecar-", dir=db.parent))
    tmp = tmpd / "s.db"
    try:
        src = ro_connect(db)
        dst = sqlite3.connect(str(tmp))
        dst.execute("CREATE TABLE doc(kind TEXT NOT NULL, id TEXT NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL, PRIMARY KEY(kind, id))")
        dst.execute("CREATE TABLE meta(k TEXT PRIMARY KEY, v TEXT NOT NULL)")
        n = 0
        for kind, table, idc, tc, bc in FTS_CORPUS:
            for r in src.execute(f"SELECT {idc}, {tc}, {bc} FROM {table}"):
                if "|" in str(r[0]) or "\n" in str(r[0]):
                    raise Refusal("sidecar_bad_id", f"{kind} id {r[0]!r} contains '|' or newline (list-mode output would be ambiguous)")
                dst.execute("INSERT INTO doc VALUES(?,?,?,?)", (kind, str(r[0]), r[1] or "", r[2] or ""))
                n += 1
        dst.execute("INSERT INTO meta VALUES('corpus_sha256', ?), ('built_at', ?), ('rows', ?)", (sig, now_utc(), str(n)))
        dst.commit()
        dst.close()
        src.close()
        for stmt in ["CREATE INDEX doc_fts ON doc USING fts (title, body) WITH (weights='title=2,body=1')",
                     "OPTIMIZE INDEX doc_fts"]:
            rc, _, err = run_bounded([TURSODB, "-q", "--experimental-index-method", str(tmp), stmt], 4096)
            if rc != 0:
                raise Refusal("sidecar_build_failed", f"{stmt.split('(')[0]}: rc={rc} {err.strip()[:200]}")
        rc, out, err = run_bounded([TURSODB, "-q", "--experimental-index-method", "-m", "list", str(tmp),
                                    "SELECT count(*) FROM doc"], 4096)
        if rc != 0 or out.strip() != str(n):
            raise Refusal("sidecar_build_failed", f"count read-back {out.strip()!r} != {n} rc={rc} {err[:120]}")
        for f in tmpd.iterdir():
            with open(f, "rb") as fh:
                os.fsync(fh.fileno())
        for suffix in ("-wal", "-shm"):
            Path(str(side) + suffix).unlink(missing_ok=True)
        os.replace(tmp, side)
        for suffix in ("-wal", "-shm"):
            p = Path(str(tmp) + suffix)
            if p.exists():
                os.replace(p, Path(str(side) + suffix))
        dfd = os.open(str(db.parent), os.O_RDONLY)
        os.fsync(dfd)
        os.close(dfd)
        o.line(f"sidecar rows={n} corpus_sha256={sig[:12]} path={side}")
        return n
    finally:
        shutil.rmtree(tmpd, ignore_errors=True)


def sidecar_state(db: Path) -> tuple[str, str]:
    side = sidecar_path(db)
    if not side.exists():
        return "absent", ""
    try:
        con = sqlite3.connect(f"file:{side}?mode=ro", uri=True)
        con.close()
    except sqlite3.Error:
        pass
    rc, out, _ = run_bounded([TURSODB, "-q", "--readonly", "-m", "list", str(side),
                              "SELECT v FROM meta WHERE k='corpus_sha256'"], 4096)
    have = out.strip()
    return ("fresh" if rc == 0 and have == corpus_signature(db) else "stale"), have


def fts_query_text(text: str) -> str:
    # Plain terms joined by AND; Tantivy syntax characters are dropped so agent text cannot
    # become a query-language construct. Prefix (*) is ABSENT in 0.7.2 (silently 0 rows).
    keep = []
    for w in text.split():
        w2 = "".join(ch for ch in w if ch.isalnum() or ch in "-_.")
        w2 = w2.strip("-.")
        if w2:
            keep.append(w2 if "-" not in w2 else f'"{w2}"')
    return " AND ".join(keep)


def verb_search(a, o: Out) -> int:
    text = " ".join(a.text).strip()
    if not text:
        raise Refusal("usage_empty_search", "search needs text", EXIT_USAGE)
    limit = min(max(1, a.rows), SEARCH_LIMIT)
    state, _ = sidecar_state(a.db)
    hits: list[dict] = []
    engine = "fts"
    if state == "fresh":
        side = sidecar_path(a.db)
        if side.stat().st_size > SIDECAR_CAP:
            raise Refusal("refused_byte_cap", f"sidecar bytes={side.stat().st_size} cap={SIDECAR_CAP}")
        q = fts_query_text(text).replace("'", "''")
        if not q:
            raise Refusal("usage_empty_search", "no searchable terms after sanitising", EXIT_USAGE)
        with tempfile.TemporaryDirectory(prefix="hee4db-q-") as td:
            cp = Path(td) / "q.db"
            shutil.copyfile(side, cp)   # fts_match needs a rw open (refused under --readonly): private copy
            for suffix in ("-wal",):
                if Path(str(side) + suffix).exists():
                    shutil.copyfile(str(side) + suffix, str(cp) + suffix)
            sql = (f"SELECT kind, id, fts_score(title, body, '{q}') FROM doc WHERE fts_match(title, body, '{q}') "
                   f"ORDER BY fts_score(title, body, '{q}') DESC LIMIT {limit + 1}")
            rc, out, err = run_bounded([TURSODB, "-q", "--experimental-index-method", "-m", "list", str(cp), sql], BYTE_CAP_DEFAULT)
            if rc != 0:
                o.line(f"fts_error rc={rc} {err.strip()[:160]} -> like-fallback")
                state = "error"
            else:
                for ln in out.splitlines():
                    if ln.count("|") >= 2:
                        k, i, s = ln.split("|", 2)
                        hits.append({"kind": k, "id": i, "score": round(float(s), 4)})
    if state != "fresh":
        engine = "like-fallback"
        o.line(f"sidecar={state} engine=like-fallback (substring match, unranked)")
        con = ro_connect(a.db)
        try:
            pat = "%" + text.replace("%", "").replace("_", "") + "%"
            for kind, table, idc, tc, bc in FTS_CORPUS:
                for r in con.execute(f"SELECT {idc} FROM {table} WHERE {tc} LIKE ? OR {bc} LIKE ? LIMIT ?", (pat, pat, limit + 1)):
                    hits.append({"kind": kind, "id": r[0], "score": None})
        finally:
            con.close()
    truncated = len(hits) > limit
    hits = hits[:limit]
    # attach titles from the main DB
    con = ro_connect(a.db)
    try:
        tab = {k: (t, idc, tc) for k, t, idc, tc, _ in FTS_CORPUS}
        for h in hits:
            t, idc, tc = tab[h["kind"]]
            r = con.execute(f"SELECT {tc} FROM {t} WHERE {idc}=?", (h["id"],)).fetchone()
            h["title"] = r[0] if r else None
        corpus_n = sum(con.execute(f"SELECT count(*) FROM {t}").fetchone()[0] for _, t, *_ in FTS_CORPUS)
    finally:
        con.close()
    o.doc.update({"rows": hits, "engine": engine, "query": text, "corpus_rows": corpus_n, "truncated": truncated})
    if corpus_n == 0:
        o.line("unmeasured_empty_world corpus_rows=0")
        return o.emit(EXIT_UNMEASURED, "0/0")
    code = EXIT_OK if engine == "fts" else EXIT_GAPS
    return o.emit(code, f"{len(hits)}/{corpus_n}", f"engine={engine}" + (" truncated=1" if truncated else ""))


