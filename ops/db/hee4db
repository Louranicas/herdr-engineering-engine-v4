class Refusal(Exception):
    """A named refusal: diagnostic token, human detail, exit code."""

    def __init__(self, diag: str, detail: str, code: int = EXIT_REFUSED):
        super().__init__(f"{diag}: {detail}")
        self.diag, self.detail, self.code = diag, detail, code


def now_utc() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def read_source(path: Path) -> bytes:
    """Bounded acquisition of a source file: stat first, then read at most cap+1 bytes."""
    st = path.stat()
    if st.st_size > SOURCE_FILE_CAP:
        raise Refusal("source_over_cap", f"{path} bytes={st.st_size} cap={SOURCE_FILE_CAP}")
    with open(path, "rb") as fh:
        data = fh.read(SOURCE_FILE_CAP + 1)
    if len(data) > SOURCE_FILE_CAP:
        raise Refusal("source_over_cap", f"{path} bytes>{SOURCE_FILE_CAP} cap={SOURCE_FILE_CAP}")
    return data


# ─────────────────────────────── output ───────────────────────────────

class Out:
    def __init__(self, verb: str, fmt: str):
        self.verb, self.fmt = verb, fmt
        self.doc: dict = {"verb": verb}
        self.lines: list[str] = []      # typed lines (diagnostics, per-source counts)

    def line(self, s: str) -> None:
        self.lines.append(s)

    def emit(self, code: int, measured: str | None = None, extra: str = "") -> int:
        verdict = VERDICT_OF.get(code, "FAIL")
        self.doc["verdict"] = verdict
        self.doc["exit"] = code
        if measured is not None:
            self.doc["measured"] = measured
        self.doc["lines"] = self.lines
        if self.fmt == "json":
            sys.stdout.write(json.dumps(self.doc, ensure_ascii=False, default=str) + "\n")
        else:
            rows = self.doc.get("rows")
            if isinstance(rows, list) and rows and isinstance(rows[0], dict):
                print_table(rows)
            elif "text" in self.doc:
                sys.stdout.write(str(self.doc["text"]).rstrip("\n") + "\n")
            for ln in self.lines:
                sys.stdout.write(ln + "\n")
        tail = f"hee4db {self.verb} verdict={verdict} exit={code}"
        if measured is not None:
            tail += f" measured={measured}"
        if extra:
            tail += " " + extra
        sys.stderr.write(tail + "\n")
        return code


def print_table(rows: list[dict]) -> None:
    cols = list(rows[0].keys())
    cells = [[("" if r.get(c) is None else str(r.get(c))).replace("\n", " ⏎ ") for c in cols] for r in rows]
    width = [min(60, max(len(c), *(len(x[i]) for x in cells))) for i, c in enumerate(cols)]

    def fmt(vals: list[str]) -> str:
        return " | ".join(v[:w].ljust(w) for v, w in zip(vals, width, strict=True))
    sys.stdout.write(fmt(cols) + "\n" + "-+-".join("-" * w for w in width) + "\n")
    for x in cells:
        sys.stdout.write(fmt(x) + "\n")


# ─────────────────────────────── engines ───────────────────────────────

def need_db(db: Path) -> None:
    if not db.exists():
        raise Refusal("setup_no_db", f"{db} does not exist; run `hee4db migrate` first", EXIT_SETUP)


def run_bounded(argv: list[str], byte_cap: int, stdin_text: str | None = None,
                timeout: int = SUBPROC_TIMEOUT_S) -> tuple[int, str, str]:
    """Run a child and read at most byte_cap+1 bytes of its stdout; kill it past the cap."""
    if not Path(argv[0]).exists() and shutil.which(argv[0]) is None:
        raise Refusal("setup_no_binary", f"{argv[0]} not found", EXIT_SETUP)
    p = subprocess.Popen(argv, stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        if stdin_text is not None:
            assert p.stdin is not None
            p.stdin.write(stdin_text.encode())
            p.stdin.close()
        assert p.stdout is not None and p.stderr is not None
        data = p.stdout.read(byte_cap + 1)
        if len(data) > byte_cap:
            p.kill()
            p.wait(timeout=5)
            raise Refusal("refused_byte_cap", f"child output bytes>{byte_cap} cap={byte_cap} argv0={Path(argv[0]).name}")
        err = p.stderr.read(64 * 1024)
        rc = p.wait(timeout=timeout)
    except subprocess.TimeoutExpired as e:
        p.kill()
        p.wait(timeout=5)
        raise Refusal("refused_timeout", f"child exceeded {timeout}s argv0={Path(argv[0]).name}") from e
    return rc, data.decode("utf-8", "replace"), err.decode("utf-8", "replace")


def turso_ro(db: Path, sql: str, byte_cap: int = BYTE_CAP_DEFAULT, extra: list[str] | None = None) -> str:
    """One-shot read-only tursodb call: both DATABASE and SQL passed, stdin closed (habitat rule)."""
    argv = [TURSODB, "-q", "--readonly", "-m", "list", *(extra or []), str(db), sql]
    rc, out, err = run_bounded(argv, byte_cap)
    if rc != 0:
        raise Refusal("turso_error", f"rc={rc} {err.strip()[:300]}")
    return out


def ro_connect(db: Path) -> sqlite3.Connection:
    need_db(db)
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
    con.execute("PRAGMA query_only=1")
    if con.execute("PRAGMA query_only").fetchone()[0] != 1:
        raise Refusal("setup_query_only", "PRAGMA query_only did not read back as 1", EXIT_SETUP)
    return con


READ_ACTIONS = {
    sqlite3.SQLITE_SELECT, sqlite3.SQLITE_READ, sqlite3.SQLITE_FUNCTION, sqlite3.SQLITE_RECURSIVE,
}
# A small set of read-only pragmas an agent may ask for through `q`.
READ_PRAGMAS = {"table_info", "table_list", "index_list", "index_info", "foreign_key_list", "user_version",
                "integrity_check", "quick_check", "foreign_key_check", "schema_version", "page_count",
                "page_size", "journal_mode", "compile_options"}


def bounded_select(db: Path, sql: str, params: tuple = (), row_cap: int = ROW_CAP_DEFAULT,
                   byte_cap: int = BYTE_CAP_DEFAULT) -> tuple[list[dict], set[str]]:
    """Read through Python sqlite3 with three read-only layers and bounds at acquisition.

    Returns (rows, tables_read). Raises Refusal on a write attempt, multiple statements, the row cap
    (rows > cap), the byte cap, or the VM step budget.
    """
    con = ro_connect(db)
    tables: set[str] = set()
    denied: list[str] = []

    def auth(action: int, a1: str | None, a2: str | None, dbname: str | None, trigger: str | None) -> int:
        if action == sqlite3.SQLITE_READ:
            if a1 and not a1.startswith("sqlite_"):
                tables.add(a1)
            return sqlite3.SQLITE_OK
        if action in READ_ACTIONS:
            return sqlite3.SQLITE_OK
        if action == sqlite3.SQLITE_PRAGMA and a1 and a1.lower() in READ_PRAGMAS and a2 is None:
            return sqlite3.SQLITE_OK
        denied.append(f"action={action} arg={a1}")
        return sqlite3.SQLITE_DENY

    steps = {"n": 0}

    def progress() -> int:
        steps["n"] += 1
        return 1 if steps["n"] * 1000 > VM_STEP_BUDGET else 0

    con.set_authorizer(auth)
    con.set_progress_handler(progress, 1000)
    try:
        try:
            cur = con.execute(sql, params)
        except sqlite3.ProgrammingError as e:
            if "one statement" in str(e):
                raise Refusal("refused_multi_statement", "q takes exactly one statement") from e
            raise Refusal("sql_error", str(e)) from e
        except sqlite3.DatabaseError as e:
            if denied or "not authorized" in str(e):
                raise Refusal("refused_not_read_only",
                              f"statement needs a non-read action ({'; '.join(denied) or e}); writes go through named verbs") from e
            if "interrupted" in str(e):
                raise Refusal("refused_step_budget", f"vm_steps>{VM_STEP_BUDGET} budget={VM_STEP_BUDGET}") from e
            raise Refusal("sql_error", str(e)) from e
        cols = [d[0] for d in cur.description or []]
        rows: list[dict] = []
        nbytes = 0
        while True:
            try:
                batch = cur.fetchmany(min(64, row_cap + 1 - len(rows)) or 1)
            except sqlite3.OperationalError as e:
                if "interrupted" in str(e):
                    raise Refusal("refused_step_budget", f"vm_steps>{VM_STEP_BUDGET} budget={VM_STEP_BUDGET}") from e
                raise Refusal("sql_error", str(e)) from e
            if not batch:
                break
            for r in batch:
                d = {c: (v.hex() if isinstance(v, bytes) else v) for c, v in zip(cols, r, strict=True)}
                nbytes += len(json.dumps(d, ensure_ascii=False, default=str).encode())
                if nbytes > byte_cap:
                    raise Refusal("refused_byte_cap", f"bytes>{byte_cap} cap={byte_cap} after rows={len(rows)}; add LIMIT or select fewer columns")
                rows.append(d)
                if len(rows) > row_cap:
                    raise Refusal("refused_row_cap", f"rows>{row_cap} cap={row_cap}; add LIMIT/WHERE or pass --rows (max {ROW_CAP_MAX})")
        return rows, tables
    finally:
        con.close()


def world_rows(db: Path, tables: set[str]) -> int:
    con = ro_connect(db)
    try:
        real = {r[0] for r in con.execute("SELECT name FROM sqlite_schema WHERE type IN ('table','view')")}
        n = 0
        for t in sorted(tables & real):
            n += con.execute(f'SELECT count(*) FROM "{t}"').fetchone()[0]
        return n
    finally:
        con.close()


class Writer:
    """The one write door: one transaction, synchronous=FULL read back, rollback on any error,
    flock against a second hee4db writer, and a second-engine read-back after COMMIT."""

    def __init__(self, db: Path):
        self.db = db

    def __enter__(self) -> sqlite3.Connection:
        self.db.parent.mkdir(parents=True, exist_ok=True)
        self.lockfh = open(str(self.db) + ".writer.lock", "w")
        try:
            fcntl.flock(self.lockfh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as e:
            raise Refusal("writer_busy", f"another hee4db writer holds {self.db}.writer.lock") from e
        self.con = sqlite3.connect(str(self.db), isolation_level=None, timeout=10)
        self.con.execute("PRAGMA journal_mode=WAL")
        self.con.execute("PRAGMA synchronous=FULL")
        self.con.execute("PRAGMA foreign_keys=ON")
        if self.con.execute("PRAGMA synchronous").fetchone()[0] != 2:
            raise Refusal("setup_synchronous", "PRAGMA synchronous did not read back FULL(2)", EXIT_SETUP)
        if self.con.execute("PRAGMA foreign_keys").fetchone()[0] != 1:
            raise Refusal("setup_foreign_keys", "PRAGMA foreign_keys did not read back 1", EXIT_SETUP)
        self.con.execute("BEGIN IMMEDIATE")
        return self.con

    def __exit__(self, et: type[BaseException] | None, ev: BaseException | None, tb: object) -> bool:
        try:
            if et is None:
                self.con.execute("COMMIT")
            else:
                try:
                    self.con.execute("ROLLBACK")
                except sqlite3.Error:
                    pass  # SQLite may already have rolled back (learn:2026-09-24-sqlite-full-autorollback)
                sys.stderr.write(f"WRITE_FAILED ROLLED_BACK {et.__name__}: {ev}\n")
        finally:
            self.con.close()
            fcntl.flock(self.lockfh, fcntl.LOCK_UN)
            self.lockfh.close()
        return False


def readback_counts(db: Path, tables: list[str]) -> dict[str, int]:
    """Second-engine read-back after a commit: tursodb --readonly counts."""
    if not tables:
        return {}
    sql = " UNION ALL ".join(f"SELECT '{t}', count(*) FROM \"{t}\"" for t in tables)
    out = turso_ro(db, sql)
    got = {}
    for ln in out.splitlines():
        if "|" in ln:
            k, v = ln.rsplit("|", 1)
            got[k] = int(v)
    return got


def check_readback(db: Path, expected: dict[str, int], o: Out) -> None:
    got = readback_counts(db, sorted(expected))
    bad = {t: (expected[t], got.get(t)) for t in expected if got.get(t) != expected[t]}
    o.line(f"readback engine=tursodb-readonly tables={len(expected)} matched={len(expected) - len(bad)}/{len(expected)}")
    if bad:
        raise Refusal("readback_mismatch", f"python-vs-tursodb counts differ: {bad}")


def py_counts(db: Path, tables: list[str]) -> dict[str, int]:
    con = ro_connect(db)
    try:
        return {t: con.execute(f'SELECT count(*) FROM "{t}"').fetchone()[0] for t in tables}
    finally:
        con.close()


# ─────────────────────────────── markdown parsing ───────────────────────────────
# Structure is parsed (fences, headings, table cells with code spans and escaped pipes), never
# matched by a free regex over the whole file.

def md_lines(text: str) -> list[tuple[int, str, bool]]:
    """(1-based line number, line, inside_fence)."""
    res, fence = [], None
    for i, ln in enumerate(text.splitlines(), 1):
        s = ln.lstrip()
        if s.startswith("```") or s.startswith("~~~"):
            mark = s[:3]
            if fence is None:
                fence = mark
                res.append((i, ln, True))
                continue
            if fence == mark:
                fence = None
                res.append((i, ln, True))
                continue
        res.append((i, ln, fence is not None))
    return res


def heading(ln: str) -> tuple[int, str] | None:
    s = ln.rstrip()
    if not s.startswith("#"):
        return None
    n = len(s) - len(s.lstrip("#"))
    if n > 6 or len(s) <= n or s[n] != " ":
        return None
    return n, s[n + 1:].strip()


def split_row(ln: str) -> list[str] | None:
    s = ln.strip()
    if not s.startswith("|"):
        return None
    cells, cur, i, code = [], [], 1, 0
    while i < len(s):
        ch = s[i]
        if ch == "\\" and i + 1 < len(s) and s[i + 1] == "|":
            cur.append("|")
            i += 2
            continue
        if ch == "`":
            j = i
            while j < len(s) and s[j] == "`":
                j += 1
            run = j - i
            if code == 0:
                code = run
            elif code == run:
                code = 0
            cur.append(s[i:j])
            i = j
            continue
        if ch == "|" and code == 0:
            cells.append("".join(cur).strip())
            cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    if "".join(cur).strip():
        cells.append("".join(cur).strip())
    return cells


def is_sep(cells: list[str]) -> bool:
    return bool(cells) and all(c and set(c) <= set("-: ") and "-" in c for c in cells)


def md_tables(lines: list[tuple[int, str, bool]]) -> list[dict]:
    """Every pipe table outside fences: {'line', 'header', 'rows': [(line, cells)], 'heading'}."""
    out, cur_head, i = [], "", 0
    while i < len(lines):
        no, ln, fenced = lines[i]
        h = None if fenced else heading(ln)
        if h:
            cur_head = h[1]
        cells = None if fenced else split_row(ln)
        if cells and i + 1 < len(lines) and not lines[i + 1][2]:
            sep = split_row(lines[i + 1][1])
            if sep and is_sep(sep):
                tbl = {"line": no, "header": cells, "rows": [], "heading": cur_head}
                j = i + 2
                while j < len(lines) and not lines[j][2]:
                    rc = split_row(lines[j][1])
                    if rc is None:
                        break
                    tbl["rows"].append((lines[j][0], rc))
                    j += 1
                out.append(tbl)
                i = j
                continue
        i += 1
    return out


def sections(lines: list[tuple[int, str, bool]], level: int) -> list[dict]:
    """Sections at exactly `level`, ending at the next heading of level <= `level` (outside fences)."""
    out, cur = [], None
    for no, ln, fenced in lines:
        h = None if fenced else heading(ln)
        if h and h[0] <= level:
            if cur:
                out.append(cur)
                cur = None
            if h[0] == level:
                cur = {"line": no, "title": h[1], "body": []}
                continue
        if cur is not None:
            cur["body"].append(ln)
    if cur:
        out.append(cur)
    for s in out:
        s["text"] = "\n".join(s["body"]).strip()
    return out


def strip_md(s: str) -> str:
    """Drop bold markers; KEEP ~~struck~~ markers so superseded text stays visibly superseded."""
    return s.replace("**", "").strip()


def drop_struck(s: str) -> str:
    """Remove ~~struck~~ spans (superseded text) before reading a value out of a cell."""
    out, i = [], 0
    while True:
        a = s.find("~~", i)
        if a < 0:
            out.append(s[i:])
            break
        b = s.find("~~", a + 2)
        if b < 0:
            out.append(s[i:])
            break
        out.append(s[i:a])
        i = b + 2
    return "".join(out)


def first_bold(s: str) -> str:
    a = s.find("**")
    if a < 0:
        return ""
    b = s.find("**", a + 2)
    return s[a + 2:b].strip() if b > 0 else ""


def id_token(s: str, prefixes: tuple[str, ...]) -> str | None:
    """First whitespace token of s (markdown stripped) if it is <prefix><digits>[a-z]?."""
    t = strip_md(s).split()
    if not t:
        return None
    tok = t[0].rstrip(".:,")
    for p in prefixes:
        if tok.startswith(p) and tok[len(p):].rstrip("abcdefghijklmnopqrstuvwxyz").isdigit():
            return tok
    return None


def header_map(header: list[str], required: dict[str, tuple[str, ...]], src: str,
               optional: dict[str, tuple[str, ...]] | None = None) -> dict[str, int]:
    """Map logical names to column indexes by header text. Missing required → malformed;
    a missing optional column maps to -1 (empty cell)."""
    norm = [h.lower().strip() for h in header]
    out = {}
    for key, names in (optional or {}).items():
        out[key] = next((i for i, h in enumerate(norm) if any(h.startswith(n) for n in names)), -1)
    for key, names in required.items():
        idx = next((i for i, h in enumerate(norm) if any(h.startswith(n) for n in names)), None)
        if idx is None:
            raise Refusal("ingest_malformed", f"source={src} table header {header} lacks column '{key}'")
        out[key] = idx
    return out


def cell(cells: list[str], i: int) -> str:
    return cells[i] if 0 <= i < len(cells) else ""


# ─────────────────────────────── parsers (one per source) ───────────────────────────────

DEC_ID = ("V4-", "D-U")


def parse_decisions(text: str, src: str) -> dict:
    lines = md_lines(text)
    decs, mentions = [], []
    section, cur = "", None
    for no, ln, fenced in lines:
        if fenced:
            continue
        h = heading(ln)
        if h and h[0] == 2:
            section, cur = h[1], None
            continue
        if ln.startswith("- **"):
            did = id_token(first_bold(ln), DEC_ID)
            if did:
                bold = first_bold(ln)
                title = strip_md(bold)[len(did):].strip(" .:")
                cur = {"id": did, "kind": "decision", "section": section, "title": title or did,
                       "body": strip_md(ln[2:]), "line": no}
                decs.append(cur)
                continue
        if cur is not None and ln.strip() and not (h and h[0] <= 2):
            cur["body"] += "\n" + ln.strip()
    for t in md_tables(lines):
        hm = {h.lower(): i for i, h in enumerate(t["header"])}
        if "id" in hm and "proposal" in hm:
            for no, cells in t["rows"]:
                pid = id_token(cell(cells, hm["id"]), DEC_ID)
                if pid:
                    decs.append({"id": pid, "kind": "proposal", "section": t["heading"],
                                 "title": strip_md(cell(cells, hm["proposal"]))[:200],
                                 "body": strip_md(" | ".join(cells)), "line": no})
    if not decs:
        raise Refusal("ingest_malformed", f"source={src} no decision bullets or proposal rows parsed")
    seen = set()
    for d in decs:
        if d["id"] in seen:
            raise Refusal("ingest_malformed", f"source={src} duplicate decision id {d['id']} (line {d['line']})")
        seen.add(d["id"])
    ids = seen
    for d in decs:
        for sent in split_sentences(d["body"]):
            toks = {w.strip("*.,;:()`'\"") for w in sent.split()}
            for m in sorted((toks & ids) - {d["id"]}):
                mentions.append({"decision_id": d["id"], "mentioned_id": m,
                                 "has_supersede": int("supersed" in sent.lower()), "sentence": sent[:600]})
    return {"decisions": decs, "decision_mentions": mentions}


def split_sentences(body: str) -> list[str]:
    out, cur = [], []
    for w in body.replace("\n", " ").split(" "):
        cur.append(w)
        if w.endswith((".", ";")) and not w.endswith(("e.g.", "i.e.", "etc.")):
            out.append(" ".join(cur).strip())
            cur = []
    if cur:
        out.append(" ".join(cur).strip())
    return [s for s in out if s]


def expand_phases(cell_text: str) -> list[str]:
    s = strip_md(drop_struck(cell_text))
    if s.lower().startswith("none"):
        return []
    s = s.replace("–", "-").replace("…", "-")
    phases: set[str] = set()
    for raw in s.replace(",", " ").replace("(", " ").replace(")", " ").replace("/", " ").split():
        tok = raw.strip(".;:")
        if "-" in tok and tok.count("P") == 2:
            a, b = tok.split("-", 1)
            if a[1:].isdigit() and b.startswith("P") and b[1:].isdigit():
                phases.update(f"P{n}" for n in range(int(a[1:]), int(b[1:]) + 1))
                continue
        if len(tok) == 2 and tok[0] == "P" and tok[1].isdigit():
            phases.add(tok)
    return sorted(phases)


def held_table_rows(text: str, src: str):
    """Yield (line_no, cells, header_map, id, item_cell, status) for every H- row of ATLAS §5.
    One home for the row grammar: parse_held (ingest) and held_checks (`check=held`) both read through it.
    The status word is read from the Item cell only: `**CLOSED` there → closed; anywhere else it is invisible."""
    lines = md_lines(text)
    sec = [s for s in sections(lines, 2) if s["title"].startswith("5 ")]
    if not sec:
        raise Refusal("ingest_malformed", f"source={src} has no '## 5 ·' held-for-Luke section")
    start = sec[0]["line"]
    end = start + len(sec[0]["body"])
    tbls = [t for t in md_tables(lines) if start <= t["line"] <= end]
    if not tbls:
        raise Refusal("ingest_malformed", f"source={src} §5 has no table")
    for t in tbls:
        hm = header_map(t["header"], {"id": ("#",), "item": ("item",), "why": ("why",), "blocks": ("blocks",),
                                      "form": ("form",), "source": ("source",)}, src)
        for no, cells in t["rows"]:
            hid = id_token(cell(cells, hm["id"]), ("H-",))
            if not hid:
                continue
            item = cell(cells, hm["item"])
            inner = id_token(first_bold(item), ("H-",))
            if inner and inner.startswith(hid):
                hid = inner
            low = item.lower()
            status = "closed" if "**closed" in low else ("merged" if "merged into" in low[:200] else "open")
            yield no, cells, hm, hid, item, status


def parse_held(text: str, src: str) -> dict:
    rows, phases = [], []
    for no, cells, hm, hid, item, status in held_table_rows(text, src):
        bolds = [strip_md(b) for b in item.split("**")[1::2]]
        title = next((b for b in bolds if b and b != hid), "") or strip_md(item)[:120]
        rows.append({"id": hid, "owner": "Luke", "status": status, "title": title[:300], "item": strip_md(item),
                     "why": strip_md(cell(cells, hm["why"])), "blocks": strip_md(drop_struck(cell(cells, hm["blocks"]))).strip(),
                     "answer_form": strip_md(cell(cells, hm["form"])), "cite": strip_md(cell(cells, hm["source"])),
                     "line": no})
        for p in expand_phases(cell(cells, hm["blocks"])):
            phases.append({"held_id": hid, "phase": p})
    if not rows:
        raise Refusal("ingest_malformed", f"source={src} §5 table has no H- rows")
    ids = [r["id"] for r in rows]
    if len(ids) != len(set(ids)):
        dup = sorted({i for i in ids if ids.count(i) > 1})
        raise Refusal("ingest_malformed", f"source={src} duplicate held ids {dup}")
    return {"held_items": rows, "held_item_phases": phases}


def parse_antipatterns(text: str, src: str) -> dict:
    lines = md_lines(text)
    rows = []
    ap_tables = [t for t in md_tables(lines) if t["header"] and t["header"][0].strip().lower() in ("id", "**id**")
                 and any(id_token(c[0], ("AP-",)) for _, c in t["rows"])]
    candidate = [t for t in md_tables(lines) if any(id_token(c[0] if c else "", ("AP-",)) for _, c in t["rows"])]
    if not candidate:
        raise Refusal("ingest_malformed", f"source={src} no table rows with AP- ids")
    for t in candidate:
        if t not in ap_tables:
            raise Refusal("ingest_malformed", f"source={src} line {t['line']} AP rows under a header without an ID column: {t['header'][:3]}")
        hm = header_map(t["header"], {"id": ("id",), "name": ("name",), "definition": ("definition",),
                                      "tell": ("the tell", "tell"), "detector": ("detector",),
                                      "source": ("source",)}, src,
                        optional={"v3": ("v3", "record"), "mirror": ("mirror",)})
        cat = t["heading"]
        for no, cells in t["rows"]:
            aid = id_token(cell(cells, hm["id"]), ("AP-",))
            if not aid:
                continue
            det = strip_md(cell(cells, hm["detector"]))
            rows.append({"id": aid, "category": cat, "name": strip_md(cell(cells, hm["name"])),
                         "definition": strip_md(cell(cells, hm["definition"])), "tell": strip_md(cell(cells, hm["tell"])),
                         "detector": det, "is_trigger": int(det.startswith("TRIGGER")),
                         "v3_instance": strip_md(cell(cells, hm["v3"])), "mirror": strip_md(cell(cells, hm["mirror"])),
                         "cite": strip_md(cell(cells, hm["source"])), "line": no})
    ids = [r["id"] for r in rows]
    if len(ids) != len(set(ids)):
        raise Refusal("ingest_malformed", f"source={src} duplicate AP ids")
    return {"antipatterns": rows}


def parse_exemplars(text: str, src: str) -> dict:
    lines = md_lines(text)
    index = {}
    for t in md_tables(lines):
        hm = {h.lower(): i for i, h in enumerate(t["header"])}
        if "id" in hm and "pattern" in hm:
            v3 = next((i for h, i in hm.items() if h.startswith("v3")), None)
            pv = hm.get("prevents")
            for _, cells in t["rows"]:
                eid = id_token(cell(cells, hm["id"]), ("EX-",))
                if eid:
                    index[eid] = (strip_md(cell(cells, v3)) if v3 is not None else "",
                                  strip_md(cell(cells, pv)) if pv is not None else "")
    if not index:
        raise Refusal("ingest_malformed", f"source={src} has no EX index table (ID | Pattern | …)")
    themes = {s["line"]: s["title"] for s in sections(lines, 2)}
    rows = []
    for s in sections(lines, 3):
        head = s["title"]
        if "·" not in head:
            continue
        idpart, title = head.split("·", 1)
        eid = id_token(idpart, ("EX-", "A-"))
        if not eid:
            continue
        theme = themes[max([ln for ln in themes if ln < s["line"]], default=min(themes, default=0))] if themes else ""
        kind = "exemplar" if eid.startswith("EX-") else "anti-exemplar"
        v3site, prevents = index.get(eid, ("", ""))
        if kind == "anti-exemplar":
            prevents = title[title.rfind("(") + 1:title.rfind(")")] if "(" in title else ""
        rows.append({"id": eid, "kind": kind, "theme": theme, "title": title.strip(), "v3_site": v3site,
                     "prevents": prevents, "body": s["text"], "line": s["line"]})
    have = {r["id"] for r in rows}
    missing = sorted(set(index) - have)
    if missing:
        raise Refusal("ingest_malformed", f"source={src} index ids without a section: {missing}")
    return {"exemplars": rows}


def parse_drift(text: str, src: str) -> dict:
    rows = []
    for s in sections(md_lines(text), 3):
        if "·" not in s["title"]:
            continue
        idpart, title = s["title"].split("·", 1)
        did = id_token(idpart, ("D-",))
        if did:
            rows.append({"id": did, "title": title.strip(), "body": s["text"], "line": s["line"]})
    if not rows:
        raise Refusal("ingest_malformed", f"source={src} no '### D-NN · title' sections")
    return {"drift_controls": rows}


MODULE_LIST_KEYS = {"phases": "phase", "ap": "ap", "ex": "ex", "anti": "anti", "d": "d", "jev": "jev", "h": "h",
                    "v4": "v4", "errata": "errata", "depends_on": "depends_on", "v3_origin": "v3_origin",
                    "migrated_paths": "migrated_path"}


def parse_modules(text: str, src: str) -> dict:
    try:
        doc = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        raise Refusal("ingest_malformed", f"source={src} TOML: {e}") from e
    mods = doc.get("module")
    if not isinstance(mods, list) or not mods:
        raise Refusal("ingest_malformed", f"source={src} has no [[module]] entries")
    # line of each [[module]] header, in order (for provenance)
    hdr_lines = [i for i, ln in enumerate(text.splitlines(), 1) if ln.strip() == "[[module]]"]
    rows, refs = [], []
    for k, m in enumerate(mods):
        for req in ("name", "crate", "cluster", "phases", "card"):
            if req not in m:
                raise Refusal("ingest_malformed", f"source={src} module #{k + 1} lacks '{req}'")
        rows.append({"name": m["name"], "crate": m["crate"], "cluster": m["cluster"], "flag": m.get("flag", ""),
                     "recommendation": m.get("recommendation", ""), "card": m["card"],
                     "line": hdr_lines[k] if k < len(hdr_lines) else 0})
        for key, kind in MODULE_LIST_KEYS.items():
            vals = m.get(key, [])
            if not isinstance(vals, list):
                raise Refusal("ingest_malformed", f"source={src} module {m['name']} '{key}' is not a list")
            for i, v in enumerate(vals):
                refs.append({"module": m["name"], "kind": kind, "ref": str(v), "ordinal": i})
    names = [r["name"] for r in rows]
    if len(names) != len(set(names)):
        raise Refusal("ingest_malformed", f"source={src} duplicate module names")
    return {"modules": rows, "module_refs": refs}


def parse_loops(text: str, src: str) -> dict:
    rows = []
    for t in md_tables(md_lines(text)):
        if len(t["header"]) < 3 or t["header"][0].strip() != "#":
            continue
        second = t["header"][1].strip().lower()
        kind = "loop" if second == "loop" else ("keep" if second == "rule" else None)
        if kind is None:
            continue
        ev = next((i for i, h in enumerate(t["header"]) if h.lower().startswith("evidence")), None)
        if ev is None:
            raise Refusal("ingest_malformed", f"source={src} line {t['line']} loop table lacks Evidence column")
        for no, cells in t["rows"]:
            lid = id_token(cell(cells, 0), ("L", "K"))
            if not lid:
                continue
            cols = {t["header"][i]: strip_md(c) for i, c in enumerate(cells) if i < len(t["header"])}
            rows.append({"id": lid, "kind": kind, "title": strip_md(first_bold(cell(cells, 1)) or cell(cells, 1))[:300],
                         "evidence": strip_md(cell(cells, ev)), "columns_json": json.dumps(cols, ensure_ascii=False),
                         "line": no})
    if not rows:
        raise Refusal("ingest_malformed", f"source={src} no loop (L) or keep (K) rows")
    return {"loops": rows}


VERDICT_TOKENS = ("PASS_WITH_GAPS", "PASS", "FAIL")


def parse_verification(text: str, src: str) -> dict:
    vid = Path(src).name.split("-", 1)[0]
    if not (vid.startswith("V") and vid[1:].isdigit()):
        raise Refusal("ingest_malformed", f"source={src} file name does not start with V<n>-")
    for no, ln, fenced in md_lines(text):
        if fenced:
            continue
        low = ln.lower()
        k = low.find("verdict")
        while k >= 0:
            rest = ln[k + 7:].lstrip("*:= \t")
            tok = next((v for v in VERDICT_TOKENS if rest.startswith(v)), None)
            if tok:
                return {"verifications": [{"id": vid, "subject": Path(src).stem, "verdict": tok,
                                           "verdict_text": strip_md(ln)[:500], "line": no}]}
            k = low.find("verdict", k + 7)
    return {"verifications": [{"id": vid, "subject": Path(src).stem, "verdict": "UNTYPED",
                               "verdict_text": "", "line": 0}]}


def parse_design_note(text: str, src: str) -> dict:
    p = Path(src)
    body = text
    b = body.encode()
    trunc = len(b) > NOTE_BODY_CAP
    if trunc:
        body = b[:NOTE_BODY_CAP].decode("utf-8", "ignore")
    title = p.stem
    for _, ln, fenced in md_lines(text):
        h = None if fenced else heading(ln)
        if h and h[0] == 1:
            title = h[1]
            break
    return {"design_notes": [{"path": src, "folder": p.parent.name, "title": title, "body": body,
                              "body_bytes": len(b), "truncated": int(trunc), "line": 0}]}


DC_STATUS = ("RESOLVED", "PROPOSED", "PARTIAL", "OPEN")
UM_CITE_MARKS = ("UM §", "UM-P")   # the ONE rule for "this conflict amends ULTRAMAP" (generator and checker share it)


def cites_um(*texts: str) -> bool:
    return any(m in t for t in texts for m in UM_CITE_MARKS)


def parse_design_index(text: str, src: str) -> dict:
    """The Module Design Index: a design note AND the DC register (one home of design conflicts)."""
    res = parse_design_note(text, src)
    regs = [t for t in md_tables(md_lines(text))
            if any(h.lower().startswith("conflict") for h in t["header"]) and any(h.lower().startswith("status") for h in t["header"])]
    if len(regs) != 1:
        raise Refusal("ingest_malformed", f"source={src} expected exactly 1 DC register table (| Id | Conflict | … | Status |), found {len(regs)}")
    t = regs[0]
    hm = header_map(t["header"], {"id": ("id",), "conflict": ("conflict",), "found": ("found in",), "phase": ("phase",),
                                  "modules": ("modules",), "status": ("status",)}, src)
    rows, links = [], []
    for no, cells in t["rows"]:
        did = id_token(cell(cells, hm["id"]), ("DC-",))
        if not did:
            raise Refusal("ingest_malformed", f"source={src} line {no} register row without a DC- id: {cell(cells, 0)[:40]!r}")
        if len(cells) != len(t["header"]):
            raise Refusal("ingest_malformed", f"source={src} line {no} {did} has {len(cells)} cells, header has {len(t['header'])} (an unescaped '|'?)")
        conflict, status = strip_md(cell(cells, hm["conflict"])), strip_md(cell(cells, hm["status"]))
        toks = status.replace("·", " ").split()
        cls = toks[0].strip(",.:;(") if toks else ""
        if cls not in DC_STATUS:
            raise Refusal("ingest_malformed", f"source={src} line {no} {did} status class {cls!r} not in {DC_STATUS}")
        ph_cell = strip_md(cell(cells, hm["phase"])).strip()
        mod_cell = strip_md(cell(cells, hm["modules"])).replace("`", "").strip()
        if ph_cell in ("—", "-", ""):
            phase = None
        else:
            ps = expand_phases(ph_cell)
            if len(ps) != 1:
                raise Refusal("ingest_malformed", f"source={src} line {no} {did} phase cell {ph_cell!r} is not one P-phase")
            phase = ps[0]
        if (cls == "RESOLVED") != (phase is None):
            raise Refusal("ingest_malformed", f"source={src} line {no} {did} status {cls} with phase {ph_cell!r}: a closed row has phase '—', an open row has one phase")
        if mod_cell in ("—", "-", ""):
            scope = "none"
        elif mod_cell.lower().startswith("all "):
            scope = "all"
        else:
            scope = "modules"
            names = [m.strip() for m in mod_cell.split(",") if m.strip()]
            for k, m in enumerate(names):
                if m in names[:k]:
                    raise Refusal("ingest_malformed", f"source={src} line {no} {did} names module {m!r} twice")
                links.append({"dc_id": did, "module": m, "line": no})
        if cls != "RESOLVED" and scope == "none":
            raise Refusal("ingest_malformed", f"source={src} line {no} {did} is {cls} but names no module")
        title = strip_md(first_bold(cell(cells, hm["conflict"]))) or (conflict if len(conflict) <= 140 else conflict[:140].rsplit(" ", 1)[0] + "…")
        rows.append({"id": did, "title": title.rstrip(".")[:300], "conflict": conflict, "found_in": strip_md(cell(cells, hm["found"])),
                     "phase": phase, "modules": mod_cell, "scope": scope, "status_class": cls, "recommendation": status,
                     "cites_um": int(cites_um(conflict, status)), "line": no})
    ids = [r["id"] for r in rows]
    if not rows or len(ids) != len(set(ids)):
        raise Refusal("ingest_malformed", f"source={src} DC register empty or duplicate ids")
    res["design_conflicts"] = rows
    res["conflict_modules"] = links
    return res


def parse_budget(text: str, src: str) -> dict:
    """The Anti-Bloat Budget: a design note AND §2's per-module rows (the single home of size budgets)."""
    res = parse_design_note(text, src)
    tbls = [t for t in md_tables(md_lines(text)) if t["header"] and t["header"][0].strip() == "K"
            and any(h.lower().startswith("module") for h in t["header"]) and any(h.lower().startswith("v4 target") for h in t["header"])]
    if len(tbls) != 1:
        raise Refusal("ingest_malformed", f"source={src} expected exactly 1 per-module budget table (| K | Module | … | v4 target |), found {len(tbls)}")
    t = tbls[0]
    hm = header_map(t["header"], {"k": ("k",), "module": ("module",), "rec": ("rec",), "v3": ("v3 size",),
                                  "target": ("v4 target",), "scope": ("scope",), "driver": ("driver",)}, src)
    rows = []
    for no, cells in t["rows"]:
        path = strip_md(cell(cells, hm["module"])).strip("` ")
        if "/" not in path:
            raise Refusal("ingest_malformed", f"source={src} line {no} budget module cell {path!r} is not `crate/module`")
        crate, mod = path.split("/", 1)
        rows.append({"module": mod, "cluster": strip_md(cell(cells, hm["k"])), "crate": crate, "rec": strip_md(cell(cells, hm["rec"])),
                     "v3_size": strip_md(cell(cells, hm["v3"]))[:600], "target": strip_md(cell(cells, hm["target"])),
                     "scope": strip_md(cell(cells, hm["scope"])), "driver": strip_md(cell(cells, hm["driver"]))[:600], "line": no})
    names = [r["module"] for r in rows]
    if not rows or len(names) != len(set(names)):
