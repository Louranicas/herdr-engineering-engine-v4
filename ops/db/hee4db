def code_words(text: str) -> list[str]:
    """Words over [A-Za-z0-9_-]: the unit both registry rules match on (never a free regex over the file)."""
    return "".join(c if (c.isalnum() or c in "-_") else " " for c in text.lower()).split()


def skill_v4(name: str, description: str) -> tuple[int, str]:
    if name in SKILL_V4_EXCLUDED:
        return 0, f"excluded:{SKILL_V4_EXCLUDED[name]}"
    for w in code_words(name) + code_words(description):
        for part in [w] + w.replace("_", "-").split("-"):
            if part in SKILL_V4_WORDS or part.startswith(SKILL_V4_PREFIXES):
                return 1, f"rule:{part}"
    if name in SKILL_V4_CURATED:
        return 1, f"curated:{SKILL_V4_CURATED[name]}"
    return 0, ""


def jev_sender(name: str, code: str) -> tuple[int, str]:
    stem = name.lower().removesuffix(".sh")
    hits = sorted({w for w in code_words(code) if w != stem and (w.startswith("jevpack") or w.startswith("jev_")
                   or (w.startswith("jev-") and len(w) > 4 and w[4].isalpha()))})
    by_name = name.startswith("jev-")
    if by_name and hits:
        return 1, f"name+code:{hits[0]}"
    if by_name:
        return 1, "name"
    if hits:
        return 1, f"code:{hits[0]}"
    return 0, ""


FRONTMATTER_BLOCK = ("|", ">", "|-", ">-", "|+", ">+")


def parse_frontmatter(text: str) -> tuple[dict[str, str], str | None]:
    """The leading `---` block as flat `key: value` scalars: quoted values unquoted, indented continuation
    lines and `- item` lists folded in, block scalars (`|`, `>`) folded to one line. Returns (fields, error)."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, "frontmatter_absent"
    end = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if end is None:
        return {}, "frontmatter_unterminated"
    fm: dict[str, str] = {}
    key: str | None = None
    for i, ln in enumerate(lines[1:end], start=2):
        if not ln.strip() or ln.lstrip().startswith("#"):
            continue
        if ln[0] not in " \t" and not ln.startswith("- "):
            if ":" not in ln:
                return fm, f"frontmatter_line_unparsed line={i}"
            k, v = ln.split(":", 1)
            key, v = k.strip(), v.strip()
            if not key or " " in key:
                return fm, f"frontmatter_bad_key line={i}"
            if v in FRONTMATTER_BLOCK:
                v = ""
            elif len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
            fm[key] = v
        else:
            if key is None:
                return fm, f"frontmatter_indent_without_key line={i}"
            item = ln.strip()
            if item.startswith("- "):
                fm[key] = (fm[key] + ", " + item[2:].strip()).strip(", ")
            else:
                fm[key] = (fm[key] + " " + item).strip()
    return fm, None


def reg_read(p: Path, cap: int = REGISTRY_FILE_CAP) -> bytes:
    st = p.stat()
    if st.st_size > cap:
        raise Refusal("source_over_cap", f"{p} bytes={st.st_size} cap={cap}")
    with open(p, "rb") as fh:
        data = fh.read(cap + 1)
    if len(data) > cap:
        raise Refusal("source_over_cap", f"{p} bytes>{cap} cap={cap}")
    return data


def reg_text(p: Path, data: bytes) -> str:
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError as e:
        raise Refusal("ingest_malformed", f"source={p} not UTF-8: {e}") from e


def read_crontab() -> tuple[str, str | None, str]:
    """(status, text, detail). The crontab is read, never written: `crontab -l` only. Status absent is a
    measured fact (no binary on PATH, or the seam file does not exist); unreadable is a binary or file that
    exists and fails (rc!=0, a bounded-run refusal, a permission error)."""
    if CRONTAB_FILE is not None:
        p = Path(CRONTAB_FILE)
        if not p.exists():
            return "absent", None, f"HEE4DB_CRONTAB_FILE={p} absent"
        try:
            return "ok", reg_text(p, reg_read(p, CRONTAB_CAP)), f"file={p}"
        except OSError as e:
            return "unreadable", None, f"HEE4DB_CRONTAB_FILE={p} {type(e).__name__}: {e}"[:200]
    if shutil.which("flatpak-spawn"):
        argv = ["flatpak-spawn", "--host", "crontab", "-l"]
    elif shutil.which("crontab"):
        argv = ["crontab", "-l"]
    else:
        return "absent", None, "neither flatpak-spawn nor crontab on PATH"
    try:
        rc, out, err = run_bounded(argv, CRONTAB_CAP, timeout=20)
    except Refusal as r:
        return "unreadable", None, f"{r.diag}: {r.detail[:200]}"
    if rc != 0:
        return "unreadable", None, f"rc={rc} {err.strip()[:200]}"
    return "ok", out, " ".join(argv)


def parse_crontab(text: str, label: str) -> list[dict]:
    rows = []
    for i, raw in enumerate(text.splitlines(), start=1):
        ln = raw.strip()
        if not ln or ln.startswith("#"):
            continue
        head = ln.split(None, 1)[0]
        if "=" in head and head.split("=", 1)[0].replace("_", "a").isalnum() and not head[0].isdigit():
            continue                                              # an environment line (NAME=value)
        nf = 1 if ln.startswith("@") else 5
        parts = ln.split(None, nf)
        if len(parts) != nf + 1:
            raise Refusal("ingest_malformed", f"source={label} line {i} cron line has fewer than {nf} schedule fields and a command")
        sched, cmd = " ".join(parts[:nf]), parts[nf]
        try:
            toks = shlex.split(cmd)
        except ValueError as e:
            raise Refusal("ingest_malformed", f"source={label} line {i} command does not tokenize: {e}") from e
        at = [j for j, t in enumerate(toks) if Path(t).name == "run-agent.sh"]
        if at:
            j = at[0]
            if len(toks) < j + 3:
                raise Refusal("ingest_malformed", f"source={label} line {i} run-agent.sh without <agent> <mode>")
            rows.append({"kind": "roster", "schedule": sched, "agent": toks[j + 1], "mode": toks[j + 2], "command": cmd, "line": i})
        else:
            rows.append({"kind": "other", "schedule": sched, "agent": None, "mode": None, "command": cmd, "line": i})
    return rows


def parse_unit(text: str) -> dict[str, list[tuple[int, str, str]]]:
    """A systemd unit file as {section: [(line, key, value)]}. Comments (# ;) and blank lines are skipped; a
    key line before any section goes under ''. Structure only: no value is interpreted here."""
    sections: dict[str, list[tuple[int, str, str]]] = {}
    cur = ""
    for i, raw in enumerate(text.splitlines(), start=1):
        ln = raw.strip()
        if not ln or ln.startswith(("#", ";")):
            continue
        if ln.startswith("[") and ln.endswith("]"):
            cur = ln[1:-1].strip()
            sections.setdefault(cur, [])
            continue
        key, sep, val = ln.partition("=")
        if sep:
            sections.setdefault(cur, []).append((i, key.strip(), val.strip()))
    return sections


def scan_timers() -> tuple[str, list[tuple[Path, bytes, Path, bytes | None]], str | None, str]:
    """(status, [(timer, timer_bytes, service, service_bytes)], sha256, detail): the bytes of every top-level
    *.timer in TIMERS_DIR (sorted, no recursion) and of its paired .service in the same directory (None when
    absent), without parsing. The sha256 is over the concatenated bytes in that order, so `stale` compares one
    number. absent: no directory; unreadable: a listing or read failed (the listing is os.listdir, which raises on an
    unreadable directory; Path.glob swallows PermissionError and would print a zero from a source it never read)."""
    d = TIMERS_DIR
    if not d.is_dir():
        return "absent", [], None, "directory absent"
    units: list[tuple[Path, bytes, Path, bytes | None]] = []
    h = hashlib.sha256()
    try:
        names = sorted(os.listdir(d))
        timers = [d / n for n in names if n.endswith(".timer") and (d / n).is_file()]
        for t in timers:
            tb = reg_read(t, CRONTAB_CAP)
            unit = next((v for _, k, v in parse_unit(reg_text(t, tb)).get("Timer", []) if k == "Unit" and v), f"{t.stem}.service")
            if Path(unit).name != unit or not unit.endswith(".service"):   # the paired service is a sibling, never a path
                raise Refusal("ingest_malformed", f"source={t} Unit={unit} is not a .service name in the timer directory")
            s = d / unit
            sb = reg_read(s, CRONTAB_CAP) if s.is_file() else None
            h.update(tb)
            if sb is not None:
                h.update(sb)
            units.append((t, tb, s, sb))
    except OSError as e:
        return "unreadable", [], None, f"{type(e).__name__}: {e}"[:200]
    return "ok", units, h.hexdigest(), f"timers={len(units)}"


def read_timers() -> tuple[str, list[dict], str | None, str]:
    """(status, rows, sha256, detail). systemd user timers as a schedule source, read from files only (never
    the systemd CLI). One agent_schedules row per schedule line of each .timer: schedule = the line's value verbatim,
    command = the paired .service's first ExecStart= verbatim (`unit_absent:<name>.service` when the service is
    missing), kind by the schedule-source rule. A .timer with no [Timer] section or no schedule line refuses the
    ingest by name. detail on ok: `timers=T jobs=N roster=R daily=D enabled=E` (enabled = a timers.target.wants link)."""
    status, units, sha, detail = scan_timers()
    if status != "ok":
        return status, [], sha, detail
    rows: list[dict] = []
    enabled = 0
    for t, tb, s, sb in units:
        sections = parse_unit(reg_text(t, tb))
        if "Timer" not in sections:
            raise Refusal("ingest_malformed", f"source={t} no [Timer] section")
        timer = sections["Timer"]
        scheds = [(i, v) for i, k, v in timer if k in TIMER_SCHEDULE_KEYS and v]
        if not scheds:
            scheds = [(i, v) for i, k, v in timer if k in TIMER_MONOTONIC_KEYS and v]
        if not scheds:
            raise Refusal("ingest_malformed", f"source={t} no schedule line ({'/'.join(TIMER_SCHEDULE_KEYS + TIMER_MONOTONIC_KEYS)}=) in [Timer]")
        if sb is None:
            cmd = f"unit_absent:{s.name}"
        else:
            cmd = next((v for _, k, v in parse_unit(reg_text(s, sb)).get("Service", []) if k == "ExecStart" and v), f"execstart_absent:{s.name}")
        try:
            toks = shlex.split(cmd)
        except ValueError as e:
            raise Refusal("ingest_malformed", f"source={s} ExecStart does not tokenize: {e}") from e
        kind, agent, mode = "other", None, None
        at = [j for j, x in enumerate(toks) if Path(x).name == "run-agent.sh"]
        if at:
            j = at[0]
            if len(toks) <= j + 2:
                raise Refusal("ingest_malformed", f"source={s} ExecStart runs run-agent.sh without <agent> <mode>")
            kind, agent, mode = "roster", toks[j + 1], toks[j + 2]
        elif any(Path(x).name == "daily.sh" and Path(x).parent.parts[-2:] == ("ops", "db") for x in toks):
            kind = "daily"
        enabled += os.path.lexists(t.parent / "timers.target.wants" / t.name)
        tsha = sha256_bytes(tb)
        for i, v in scheds:
            rows.append({"kind": kind, "schedule": v, "agent": agent, "mode": mode, "command": cmd, "line": i,
                         "source_path": str(t), "source_sha256": tsha})
    detail = (f"timers={len(units)} jobs={len(rows)} roster={sum(r['kind'] == 'roster' for r in rows)} "
              f"daily={sum(r['kind'] == 'daily' for r in rows)} enabled={enabled}")
    return "ok", rows, sha, detail


def parse_modes(text: str, agent: str, src: Path) -> list[dict]:
    rows, seen = [], set()
    for i, raw in enumerate(text.splitlines(), start=1):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        parts = raw.split("|", 2)
        if len(parts) != 3 or not parts[0].strip():
            raise Refusal("ingest_malformed", f"source={src} line {i} modes.conf wants `mode|budget_usd|prompt`")
        mode = parts[0].strip()
        try:
            budget = float(parts[1].strip())
        except ValueError as e:
            raise Refusal("ingest_malformed", f"source={src} line {i} budget {parts[1].strip()!r} is not a number") from e
        if mode in seen:
            raise Refusal("ingest_malformed", f"source={src} line {i} duplicate mode {mode!r}")
        seen.add(mode)
        rows.append({"agent": agent, "mode": mode, "budget_usd": budget, "prompt": parts[2].strip(), "line": i})
    return rows


def hook_wiring(settings: dict, label: str) -> list[dict]:
    """settings.json `hooks` block → one entry per command: event, matcher, command, script path (if any)."""
    out = []
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        raise Refusal("ingest_malformed", f"source={label} `hooks` is not an object")
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            raise Refusal("ingest_malformed", f"source={label} hooks.{event} is not a list")
        for g in groups:
            for h in (g.get("hooks") or []) if isinstance(g, dict) else []:
                cmd = str(h.get("command", "")) if isinstance(h, dict) else ""
                expanded = os.path.expandvars(cmd.replace("$CLAUDE_PROJECT_DIR", str(ROOTS["repo"])))
                try:
                    toks = shlex.split(expanded)
                except ValueError:
                    toks = expanded.split()
                script = next((t for t in toks if t.endswith(".sh")), None)
                if script:
                    # a wired path under ~/.claude is read against CLAUDE_HOME (identical unless HEE4DB_CLAUDE_HOME is set)
                    sp = Path(script).expanduser()
                    try:
                        sp = CLAUDE_HOME / sp.relative_to(HOME / ".claude")
                    except ValueError:
                        pass
                    script = str(sp)
                out.append({"event": event, "matcher": str(g.get("matcher", "") or "*"), "command": cmd, "script": script})
    return out


def collect_registry(ts: str) -> tuple[dict[str, list[dict]], list[str]]:
    """Read every registry source (bounded). Returns rows per table and typed lines. Refuses on a malformed
    roster file or crontab line; records an absent directory or unreadable crontab as a registry_sources row."""
    res: dict[str, list[dict]] = {t: [] for t in REGISTRY_TABLES}
    lines: list[str] = []
    srcs = res["registry_sources"]

    def src(kind: str, scope: str, path: str, status: str, sha: str | None, entries: int, detail: str) -> None:
        srcs.append({"kind": kind, "scope": scope, "path": path, "status": status, "sha256": sha, "entries": entries,
                     "detail": detail, "ingested_at": ts})

    # skills ----------------------------------------------------------------
    for scope, base in (("user", CLAUDE_HOME / "skills"), ("project", ROOTS["repo"] / ".claude" / "skills")):
        if not base.is_dir():
            src("skills_dir", scope, str(base), "absent", None, 0, "directory absent (recorded, never read as zero skills)")
            continue
        n, no_md = 0, []
        for d in sorted(p for p in base.iterdir() if p.is_dir()):
            f = d / "SKILL.md"
            if not f.is_file():
                no_md.append(d.name)
                continue
            data = reg_read(f)
            text = reg_text(f, data)
            fm, err = parse_frontmatter(text)
            name, desc = fm.get("name", ""), fm.get("description", "")
            if err is None and (not name or not desc):
                err = "frontmatter_missing " + ",".join(k for k in ("name", "description") if not fm.get(k))
            if err is None and name != d.name:
                err = f"name_mismatch name={name} dir={d.name}"
            rel, why = skill_v4(name or d.name, desc)
            res["skills"].append({"scope": scope, "dir_name": d.name, "name": name, "description": desc, "parse_error": err,
                                  "lines": len(text.splitlines()), "has_reference": int((d / "reference").is_dir()),
                                  "v4_relevant": rel, "v4_reason": why, "source_path": str(f),
                                  "source_sha256": sha256_bytes(data), "ingested_at": ts})
            n += 1
        detail = f"skills={n}" + (f" dirs_without_SKILL.md={','.join(no_md)}" if no_md else "")
        src("skills_dir", scope, str(base), "ok", None, n, detail)
        if no_md:
            lines.append(f"registry_skill_dir_without_skill_md scope={scope} dirs={','.join(no_md)} (not a skill; listed, not ingested)")
    # agents ----------------------------------------------------------------
    for scope, base in (("project", ROOTS["repo"] / ".claude" / "agents"), ("user", CLAUDE_HOME / "agents")):
        if not base.is_dir():
            src("agents_dir", scope, str(base), "absent", None, 0, "directory absent")
            continue
        files = sorted(p for p in base.glob("*.md") if p.is_file())
        for f in files:
            data = reg_read(f)
            fm, err = parse_frontmatter(reg_text(f, data))
            name = fm.get("name") or f.stem
            if err is None and name != f.stem:
                err = f"name_mismatch name={name} file={f.stem}"
            if err is None and not fm.get("description"):
                err = "frontmatter_missing description"
            if any(r["scope"] == scope and r["name"] == name for r in res["agents"]):
                raise Refusal("ingest_malformed", f"source={f} agent name {name!r} declared twice in scope {scope}")
            res["agents"].append({"scope": scope, "name": name, "model": fm.get("model") or None, "tools": fm.get("tools") or None,
                                  "description": fm.get("description", ""), "parse_error": err, "source_path": str(f),
                                  "source_sha256": sha256_bytes(data), "ingested_at": ts})
        src("agents_dir", scope, str(base), "ok", None, len(files), f"agents={len(files)}")
    # roster modes ----------------------------------------------------------
    roster = ROOTS["repo"] / "ops" / "roster"
    if not roster.is_dir():
        src("roster_dir", "project", str(roster), "absent", None, 0, "directory absent")
    else:
        dirs = sorted(p for p in roster.iterdir() if p.is_dir() and not p.name.startswith((".", "__")))
        for d in dirs:
            f = d / "modes.conf"
            if not f.is_file():
                src("modes", "project", str(f), "absent", None, 0, f"roster dir {d.name} has no modes.conf")
                continue
            data = reg_read(f)
            rows = parse_modes(reg_text(f, data), d.name, f)
            sha = sha256_bytes(data)
            for r in rows:
                res["agent_modes"].append({**r, "source_path": str(f), "source_sha256": sha, "source_line": r["line"], "ingested_at": ts})
            src("modes", "project", str(f), "ok", sha, len(rows), f"agent={d.name} modes={len(rows)}")
        src("roster_dir", "project", str(roster), "ok", None, len(dirs), f"agent_dirs={len(dirs)}")
    # crontab ---------------------------------------------------------------
    status, text, detail = read_crontab()
    label = CRONTAB_FILE or CRONTAB_LABEL
    if status != "ok" or text is None:
        src("crontab", "host", label, status, None, 0, detail)
        lines.append(f"registry_crontab_{'absent' if status == 'absent' else 'unmeasured'} {detail}")
    else:
        sha = sha256_bytes(text.encode())
        rows = parse_crontab(text, label)
        for r in rows:
            res["agent_schedules"].append({**r, "source_path": label, "source_sha256": sha, "source_line": r["line"], "ingested_at": ts})
        src("crontab", "host", label, "ok", sha, len(rows), f"{detail} jobs={len(rows)} roster={sum(r['kind'] == 'roster' for r in rows)}")
    # systemd user timers (rev 2026-10-05 schedule): files only, through the TIMERS_DIR seam ----------------
    tstatus, trows, tsha, tdetail = read_timers()
    for r in trows:
        res["agent_schedules"].append({**r, "source_line": r["line"], "ingested_at": ts})
    src("timers", "user", str(TIMERS_DIR), tstatus, tsha, len(trows), tdetail)
    if tstatus != "ok":
        lines.append(f"registry_timers_{'absent' if tstatus == 'absent' else 'unmeasured'} {tdetail}")
    # reflexes --------------------------------------------------------------
    for scope, settings_p, hooks_dir in (("user", CLAUDE_HOME / "settings.json", CLAUDE_HOME / "hooks"),
                                         ("project", ROOTS["repo"] / ".claude" / "settings.json", ROOTS["repo"] / ".claude" / "hooks")):
        if not settings_p.is_file():
            src("settings", scope, str(settings_p), "absent", None, 0, "settings file absent")
            wiring, s_sha = [], None
        else:
            s_data = reg_read(settings_p)
            try:
                settings = json.loads(reg_text(settings_p, s_data))
            except json.JSONDecodeError as e:
                raise Refusal("ingest_malformed", f"source={settings_p} not JSON: {e}") from e
            wiring, s_sha = hook_wiring(settings if isinstance(settings, dict) else {}, str(settings_p)), sha256_bytes(s_data)
            src("settings", scope, str(settings_p), "ok", s_sha, len(wiring), f"hook_commands={len(wiring)}")
        by_script: dict[str, list[dict]] = {}
        for w in wiring:
            key = w["script"] or w["command"]
            by_script.setdefault(key, []).append(w)
        # every *.sh in the hooks dir (wired or not), plus every wired command that is not one of them
        scripts: list[tuple[str, Path | None]] = []
        if not hooks_dir.is_dir():
            src("hooks_dir", scope, str(hooks_dir), "absent", None, 0, "directory absent")
            found = []
        else:
            found = sorted(p for p in hooks_dir.glob("*.sh") if p.is_file())
            src("hooks_dir", scope, str(hooks_dir), "ok", None, len(found), f"scripts={len(found)}")
        scripts += [(p.name, p) for p in found]
        listed = {str(p) for p in found}
        for k in sorted(by_script):
            if k in listed:
                continue
            sp = by_script[k][0]["script"]
            lines.append(f"registry_reflex_wired_outside_hooks_dir scope={scope} command={k[:120]}")
            scripts.append((Path(sp).name if sp else (k.split() or ["inline"])[0][:80], Path(sp) if sp else None))
        for name, p in scripts:
            ws = by_script.get(str(p) if p else name, [])
            if p is not None and p.is_file():
                data = reg_read(p)
                code, sha, spath = data.decode("utf-8", "replace"), sha256_bytes(data), str(p)
            else:
                code = " ".join(w["command"] for w in ws)
                sha, spath = s_sha or sha256_bytes(code.encode()), str(settings_p)
            js, jr = jev_sender(name, code + " " + " ".join(w["command"] for w in ws))
            if any(r["scope"] == scope and r["name"] == name for r in res["reflexes"]):
                raise Refusal("ingest_malformed", f"source={settings_p} reflex name {name!r} twice in scope {scope}")
            res["reflexes"].append({"scope": scope, "name": name, "path": str(p) if p else name,
                                    "events": ",".join(sorted({w["event"] for w in ws})),
                                    "matchers": ",".join(f"{w['event']}:{w['matcher']}" for w in ws), "wired": int(bool(ws)),
                                    "jev_sender": js, "jev_reason": jr, "settings_path": str(settings_p),
                                    "source_path": spath, "source_sha256": sha, "ingested_at": ts})
    lines.append(f"registry_rule {SKILL_V4_RULE}")
    lines.append(f"registry_rule {JEV_SENDER_RULE}")
    return res, lines


def reg_loc(path: str) -> tuple[str, str]:
    """(source_root, source_rel) for a registry location: the crontab is host:crontab; a path under ~/.claude
    or the v4 repo is stored relative to it (portable, as `sources` is); anything else is abs:<path>."""
    if path in (CRONTAB_LABEL, CRONTAB_FILE):
        return "host", "crontab"
    p = Path(path)
    for root, base in (("repo", ROOTS["repo"]), ("claude", CLAUDE_HOME)):
        try:
            return root, str(p.relative_to(base))
        except ValueError:
            continue
    return "abs", path


def reg_resolve(root: str, rel: str) -> Path | None:
    """The current location of a registry row (None for the crontab, which is re-read, not stat'ed)."""
    return {"repo": ROOTS["repo"] / rel, "claude": CLAUDE_HOME / rel, "abs": Path(rel)}.get(root)


REG_COLS = {
