        refs: dict[str, dict[str, list[str]]] = {}
        for m, k, ref in con.execute("SELECT module, kind, ref FROM module_refs ORDER BY module, kind, ordinal"):
            refs.setdefault(m, {}).setdefault(k, []).append(ref)
        held = {r[0]: {"id": r[0], "status": r[1], "title": r[2], "blocks": r[3], "answer_form": r[4]}
                for r in con.execute("SELECT id, status, title, blocks, answer_form FROM held_items")}
        hph: dict[str, list[str]] = {}
