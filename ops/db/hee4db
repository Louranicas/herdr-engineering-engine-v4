DENOMINATORS = {"v3_refs": "v3_refs.files_scanned", "backlinks.broken": "backlinks.notes_scanned",
                "backlinks.one_way": "backlinks.notes_scanned", "funnel.checks_failed": None}


def parse_value(v: str) -> tuple[float | None, str | None, float | None, int]:
    s = v.strip()
    if s.startswith("UNMEASURED"):
        return None, s[:200], None, 1
    if "/" in s:
        n, _, d = s.partition("/")
        try:
            return float(n), None, float(d), 0
        except ValueError:
            pass
    try:
        return float(s), None, None, 0
    except ValueError:
        return None, s[:200], None, 0


def parse_measure_file(text: str, rel: str) -> tuple[str, list[dict]]:
    measured_at, rows = None, []
    for ln in text.splitlines():
        if not ln or ln[0].isspace():
            continue          # indented lines are lists (links, per-agent detail), not measurements
        s = ln.strip()
        section = None
        if ":" in s.split("=", 1)[0] and not s.split(":", 1)[0].count(" "):
            section, _, s = s.partition(":")
            s = s.strip()
            if not s:
                continue
        toks = s.split()
        pairs = [t.split("=", 1) for t in toks if "=" in t]
        if not pairs:
            continue
        first = pairs[0][0]
        for i, (k, v) in enumerate(pairs):
            if k == "measured_at_utc":
                measured_at = v
                continue
            if section:
                name = f"{section}.{k}"
            else:
                name = k if i == 0 else f"{first}.{k}"
            if "," in v and not v.replace(",", "").replace(".", "").isdigit():
                continue      # id lists such as learning_ids=L1,L2,… are not measurements
            val, txt, den, unm = parse_value(v)
            rows.append({"name": name, "value": val, "value_text": txt, "denominator": den, "unmeasured": unm})
    if measured_at is None:
        raise Refusal("ingest_malformed", f"measure file {rel} has no measured_at_utc= line")
    byname = {r["name"]: r for r in rows}
    for name, den in DENOMINATORS.items():
        if den and name in byname and byname[name]["denominator"] is None and den in byname:
            byname[name]["denominator"] = byname[den]["value"]
    return measured_at, rows


def verb_record_measurement(a, o: Out) -> int:
    need_db(a.db)
    if a.from_measure_files or a.file:
        base = ROOTS["evidence"] / "roster"
        if a.file:
            # One measure file, as the runner records it (CN-04); same upsert, so --from-measure-files later is a no-op.
            fp = Path(a.file).resolve()
            if fp.parent.parent != base.resolve() or not fp.name.startswith("measure-") or fp.suffix != ".txt":
                raise Refusal("usage_record_measurement", f"--file must be {base}/<agent>/measure-*.txt, got {fp}", EXIT_USAGE)
            files = [Path(base / fp.parent.name / fp.name)]
        else:
            files = sorted(base.glob("*/measure-*.txt"))
        if not files:
            o.line(f"unmeasured_empty_world glob={base}/*/measure-*.txt")
            return o.emit(EXIT_UNMEASURED, "0/0")
        batch = []
        for p in files:
            data = read_source(p)
            rel = str(p.relative_to(ROOTS["evidence"]))
            at, rows = parse_measure_file(data.decode("utf-8", "replace"), rel)
            batch.append((rel, sha256_bytes(data), at, rows))
        before = py_counts(a.db, ["measurements"])["measurements"]
        new = 0
        with Writer(a.db) as con:
            for rel, sha, at, rows in batch:
                n0 = con.total_changes
                for r in rows:
                    con.execute("INSERT INTO measurements(name, value, value_text, denominator, unmeasured, measured_at, source, source_sha256, recorded_at) "
                                "VALUES(?,?,?,?,?,?,?,?,?) ON CONFLICT(name, measured_at, source) DO UPDATE SET value=excluded.value, "
                                "value_text=excluded.value_text, denominator=excluded.denominator, unmeasured=excluded.unmeasured, "
                                "source_sha256=excluded.source_sha256",
                                (r["name"], r["value"], r["value_text"], r["denominator"], r["unmeasured"], at, rel, sha, now_utc()))
                o.line(f"measure_file={rel} measured_at={at} measurements={len(rows)}")
                new += con.total_changes - n0
        after = py_counts(a.db, ["measurements"])
        check_readback(a.db, after, o)
        unm = sum(r["unmeasured"] for _, _, _, rows in batch for r in rows)
        total = sum(len(rows) for _, _, _, rows in batch)
        o.doc.update({"files": len(files), "measurements": total, "rows_before": before, "rows_after": after["measurements"]})
        return o.emit(EXIT_GAPS if unm else EXIT_OK, f"{len(batch)}/{len(files)}", f"measurements={total} unmeasured={unm}")
    if not a.name or (a.value is None and a.value_text is None):
        raise Refusal("usage_record_measurement", "--name and --value (or --value-text) required, or --from-measure-files", EXIT_USAGE)
    before = py_counts(a.db, ["measurements"])["measurements"]
    with Writer(a.db) as con:
        con.execute("INSERT INTO measurements(name, value, value_text, denominator, unmeasured, measured_at, source, source_sha256, recorded_at) "
                    "VALUES(?,?,?,?,?,?,?,?,?)", (a.name, a.value, a.value_text, a.denominator, int(a.unmeasured),
                                                   a.measured_at or now_utc(), a.source or "cli", None, now_utc()))
    check_readback(a.db, {"measurements": before + 1}, o)
    return o.emit(EXIT_OK, "1/1")


