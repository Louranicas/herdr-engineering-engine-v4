def ids_in(text: str, prefix: str) -> list[str]:
    out = []
    for raw in text.replace(",", " ").replace(";", " ").split():
        t = raw.strip("*`()[].:~")
        if t.startswith(prefix) and t[len(prefix):].isdigit():
            out.append(t)
    return out


def atlas_section9(text: str) -> list[dict] | None:
    lines = md_lines(text)
    sec = [s for s in sections(lines, 2) if s["title"].startswith("9 ")]
    if not sec:
        return None
    start, end = sec[0]["line"], sec[0]["line"] + len(sec[0]["body"])
    tb = [t for t in md_tables(lines) if start <= t["line"] <= end and t["header"] and t["header"][0].strip().lower() == "phase"]
    if len(tb) != 1:
        return None
    hm = header_map(tb[0]["header"], {"phase": ("phase",), "ids": ("open dc",), "mods": ("modules",)}, "ATLAS §9")
    return [{"phase": strip_md(cell(c, hm["phase"])), "dc_ids": ids_in(cell(c, hm["ids"]), "DC-"),
             "modules": sorted(x.strip() for x in strip_md(cell(c, hm["mods"])).split(",") if x.strip() not in ("", "—")), "line": no}
            for no, c in tb[0]["rows"]]


def um_marked_ids(text: str) -> list[str] | None:
    lines = text.splitlines()
    try:
        a, b = lines.index(UM_BEGIN), lines.index(UM_END)
    except ValueError:
        return None
    if b < a:
        return None
    out = []
    for ln in lines[a + 1:b]:
        s = ln.strip()
        if s.startswith("- "):
            ids = ids_in(s[2:].split(":", 1)[0], "DC-")
            out += ids[:1]
    return out


# the funnel: card ⇄ design section ------------------------------------------------------------------

def read_text(p: Path) -> str:
    return read_source(p).decode("utf-8", "replace")


def card_design_link(text: str) -> tuple[str, str, int] | None:
    """(note, heading, line) from the card's `**Design section:** [..](obsidian://open?vault=..&file=..)` line."""
    from urllib.parse import parse_qs, urlsplit
    for no, ln, fenced in md_lines(text):
        if fenced or not ln.startswith("**Design section:**"):
            continue
        a = ln.find("](obsidian://")
        if a < 0:
            return ("", "", no)
        b = ln.find(")", a + 2)
        url = ln[a + 2:b]
        q = parse_qs(urlsplit(url).query)
        f = q.get("file", [""])[0]
        if q.get("vault", [""])[0] != VAULT_NAME or "#" not in f:
            return ("", "", no)
        note, head = f.split("#", 1)
        return (note, head, no)
    return None


def note_headings(text: str) -> dict[str, int]:
    return {h[1]: no for no, ln, fenced in md_lines(text) if not fenced and (h := heading(ln))}


def card_rel_of_url(url: str) -> str | None:
    """`file:///…/herdr-engineering-engine-v4/modules/<crate>/<m>/MODULE.md` → `modules/<crate>/<m>/MODULE.md`."""
    k = url.find("/modules/")
    return url[k + 1:] if k >= 0 and url.endswith("MODULE.md") else None


def design_sections() -> dict[str, dict]:
    """Every level-3 module section in the crate notes, keyed by its first heading token: note, heading, line, card link."""
    out: dict[str, dict] = {}
    base = ROOTS["vault"] / DESIGN_DIR
    for p in sorted(base.glob("*.md")):
        if p.stem == DESIGN_INDEX_NOTE:
            continue
        lines = md_lines(read_text(p))
        for s in sections(lines, 3):
            key = s["title"].split()[0] if s["title"].split() else ""
            k = s["text"].find("(file://")
            card = None
            while k >= 0:
                e = s["text"].find(")", k)
                rel = card_rel_of_url(s["text"][k + 1:e])
                if rel:
                    card = rel
                    break
                k = s["text"].find("(file://", e)
            out.setdefault(key, {"note": f"{DESIGN_DIR}/{p.stem}", "heading": s["title"], "line": s["line"], "card": card})
    return out


def card_phases(text: str) -> tuple[list[str], int] | None:
    """Phases named in the first cell of each row of the card's `## 3 · Deployment` table (parsed, not regexed)."""
    lines = md_lines(text)
    sec = [s for s in sections(lines, 2) if s["title"].startswith("3 ")]
    if not sec:
        return None
    start, end = sec[0]["line"], sec[0]["line"] + len(sec[0]["body"])
    tb = [t for t in md_tables(lines) if start <= t["line"] <= end and t["header"] and t["header"][0].lower().startswith("phase")]
    if not tb:
        return None
    phs: set[str] = set()
    for _, c in tb[0]["rows"]:
        first = strip_md(drop_struck(cell(c, 0)))
        lead = first.split("(")[0] if not first.startswith("(") else first
        phs.update(expand_phases(lead))
    return sorted(phs, key=lambda p: int(p[1:])), tb[0]["line"]


def funnel_links_report(w: dict) -> dict:
    secs = design_sections()
    note_cache: dict[str, dict[str, int] | None] = {}
    bad, resolved, sec_ok = [], 0, 0
    for m in w["modules"]:
        cp = ROOTS["repo"] / m["card"]
        if not cp.exists():
            bad.append(f"funnel_card_absent module={m['name']} card={m['card']}")
            continue
        lk = card_design_link(read_text(cp))
        if lk is None or not lk[0]:
            bad.append(f"funnel_card_no_design_link module={m['name']} card={m['card']}")
            continue
        note, head, _ = lk
        if note not in note_cache:
            np_ = ROOTS["vault"] / f"{note}.md"
            note_cache[note] = note_headings(read_text(np_)) if np_.exists() else None
        hs = note_cache[note]
        if hs is None:
            bad.append(f"funnel_design_note_absent module={m['name']} note={note!r}")
        elif head not in hs:
            bad.append(f"funnel_heading_absent module={m['name']} note={note!r} heading={head!r}")
        else:
            resolved += 1
        s = secs.get(m["name"])
        if s is None:
            bad.append(f"funnel_section_absent module={m['name']} (no level-3 section named for it in {DESIGN_DIR})")
        elif not s["card"] or not (ROOTS["repo"] / s["card"]).exists():
            bad.append(f"funnel_section_card_absent module={m['name']} section={s['note']}#{s['heading']} card={s['card']}")
        elif s["card"] != m["card"]:
            bad.append(f"funnel_section_card_mismatch module={m['name']} section_card={s['card']} manifest_card={m['card']}")
        else:
            sec_ok += 1
    return {"modules": len(w["modules"]), "card_links_resolved": resolved, "sections_ok": sec_ok, "bad": bad, "sections": secs}


def funnel_phases_report(w: dict) -> dict:
    bad, ok = [], 0
    for m in w["modules"]:
        want = sorted(w["refs"].get(m["name"], {}).get("phase", []), key=lambda p: int(p[1:]))
        cp = ROOTS["repo"] / m["card"]
        got = card_phases(read_text(cp)) if cp.exists() else None
        if got is None:
            bad.append(f"funnel_phase_table_absent module={m['name']} card={m['card']}")
        elif got[0] != want:
            bad.append(f"funnel_phase_mismatch module={m['name']} card={','.join(got[0])} manifest={','.join(want)} card_line={got[1]}")
        else:
            ok += 1
    return {"modules": len(w["modules"]), "ok": ok, "bad": bad}


