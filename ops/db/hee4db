def verb_mcp(a, o: Out) -> int:
    """Serve a READ-ONLY SNAPSHOT over MCP (stdio), confined by bwrap.

    `tursodb --mcp --readonly` alone is NOT a boundary (measured 2026-10-01: open_database reached another
    file and delete_data emptied it). Inside bwrap the snapshot is the only host file visible, mounted
    read-only; open_database on any other path lands in a private tmpfs; no network namespace."""
    need_db(a.db)
    bw = shutil.which("bwrap")
    if not bw:
        raise Refusal("mcp_unconfined_refused", "bwrap not found; refusing to serve tursodb --mcp unconfined", EXIT_SETUP)
    snapdir = Path(tempfile.mkdtemp(prefix="hee4db-mcp-"))
    snap = snapdir / "hee4-ops.db"
    turso_ro(a.db, f"VACUUM INTO '{snap}'")
    snap.chmod(0o444)
    argv = [bw, "--unshare-all", "--die-with-parent", "--new-session", "--clearenv",
            "--ro-bind", "/usr", "/usr", "--symlink", "usr/lib64", "/lib64", "--symlink", "usr/lib", "/lib",
            "--ro-bind", TURSODB, "/tursodb", "--ro-bind", str(snapdir), "/db", "--tmpfs", "/tmp",
            "--proc", "/proc", "--dev", "/dev", "--chdir", "/tmp",
            "/tursodb", "--mcp", "--readonly", "/db/hee4-ops.db"]
    if a.print_argv:
        o.doc["argv"] = argv
        o.doc["snapshot"] = str(snap)
        o.doc["text"] = " ".join(argv)
        return o.emit(EXIT_OK, "1/1", "mode=print")
    sys.stderr.write(f"hee4db mcp snapshot={snap} confined=bwrap readonly=1 (stdio follows)\n")
    try:
        rc = subprocess.call(argv)
    finally:
        shutil.rmtree(snapdir, ignore_errors=True)
    return rc


