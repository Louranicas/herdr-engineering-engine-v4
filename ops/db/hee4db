# roster logs ------------------------------------------------------------------

RUN_KEYS = ("cost_usd=", "verdict_line=", "exit=", "degraded_by=")
# CN-20: the runner's `exit=N` contract (V4-24/V4-26) starts with this stamp; an older log without `exit=` is
# legacy_no_exit (marked, never rewritten), a newer one is a real gap (`missing`).
EXIT_CONTRACT_STAMP = "20261001T013317Z"
# The runner appends one `db_record=` line AFTER recording (CN-04); it is not part of the run, so the log's digest
# leaves it out and a later --from-logs sees the run unchanged.
DB_RECORD_PREFIX = b"db_record="


def log_digest(data: bytes) -> str:
    return sha256_bytes(b"".join(ln for ln in data.splitlines(keepends=True) if not ln.startswith(DB_RECORD_PREFIX)))


def exit_status(r: dict) -> str:
    if r["exit_code"] is not None:
        return "recorded"
    return "legacy_no_exit" if r["stamp"] < EXIT_CONTRACT_STAMP else "missing"


def parse_run_log(text: str, agent: str, rel: str) -> dict:
    lines = text.splitlines()
    if not lines:
        raise Refusal("ingest_malformed", f"run log {rel} is empty")
    # A lock-skip log (run-agent.sh exit 40) starts `<agent>: lock held; skipped <stamp> <mode> exit=40`.
    sk = lines[0].split()
    if len(sk) >= 6 and sk[0] == f"{agent}:" and sk[1:4] == ["lock", "held;", "skipped"] and sk[6:7] == ["exit=40"]:
        ex = next((t for ln in lines[1:] for t in ln.split() if t.startswith("exit=")), "exit=40")
        return {"agent": agent, "mode": sk[5], "stamp": sk[4], "measure_rc": "NA",
                "exit_code": int(ex[5:]) if ex[5:].isdigit() else None, "claude_rc": None, "verdict": "SKIPPED",
                "verdict_line": None, "cost_usd": None, "is_error": None, "subtype": None, "degraded_by": None}
    head = lines[0].split()
    if not head or not head[0].endswith(agent.replace("hee4-", "")):
        raise Refusal("ingest_malformed", f"run log {rel} first line does not name the agent: {lines[0][:80]}")
    kv = dict(t.split("=", 1) for t in head[1:] if "=" in t)
    r = {"agent": agent, "mode": kv.get("mode", ""), "stamp": kv.get("start", ""), "measure_rc": kv.get("measure_rc"),
         "exit_code": None, "claude_rc": None, "verdict": "NONE", "verdict_line": None, "cost_usd": None,
         "is_error": None, "subtype": None, "degraded_by": None}
    for ln in lines[1:]:
        s = ln.strip()
        if s.startswith("verdict_line="):
            vl = s[len("verdict_line="):]
            r["verdict_line"] = vl[:500]
            if vl.startswith("REFUSED"):
                r["verdict"] = "REFUSED"
            else:
                tok = vl.split()
                v = next((t.split("=", 1)[1] for t in tok if t.startswith("verdict=")), None)
                if v in ("PASS", "PASS_WITH_GAPS", "FAIL"):
                    r["verdict"] = v
        elif s.startswith("cost_usd=") or s.startswith("exit=") or s.startswith("degraded_by="):
            for t in s.split():
                if "=" not in t:
                    continue
                k, v = t.split("=", 1)
                if k == "cost_usd":
                    try:
                        r["cost_usd"] = float(v)
                    except ValueError:
                        r["cost_usd"] = None
                elif k == "is_error":
                    r["is_error"] = v
                elif k == "subtype":
                    r["subtype"] = v
                elif k == "exit":
                    r["exit_code"] = int(v) if v.lstrip("-").isdigit() else None
                elif k == "measure_rc":
                    r["measure_rc"] = v
                elif k == "degraded_by":
                    r["degraded_by"] = s[len("degraded_by="):] if s.startswith("degraded_by=") else v
        elif s.startswith(head[0] + " claude_rc="):
            for t in s.split()[1:]:
                if t.startswith("claude_rc="):
                    v = t.split("=", 1)[1]
                    r["claude_rc"] = int(v) if v.lstrip("-").isdigit() else None
        elif "SKIPPED" in s and r["verdict"] == "NONE" and s.startswith("skipped"):
            r["verdict"] = "SKIPPED"
    if not r["stamp"] or not r["mode"]:
        raise Refusal("ingest_malformed", f"run log {rel} first line lacks mode= or start=")
    return r


def upsert_run(con: sqlite3.Connection, r: dict, source: str, rel: str | None, sha: str | None) -> str:
    cols = ["agent", "mode", "stamp", "log_path", "exit_code", "measure_rc", "claude_rc", "verdict", "verdict_line",
            "cost_usd", "is_error", "subtype", "degraded_by", "source", "source_sha256", "recorded_at", "exit_status"]
    vals = [r["agent"], r["mode"], r["stamp"], rel, r["exit_code"], r["measure_rc"], r["claude_rc"], r["verdict"],
            r["verdict_line"], r["cost_usd"], r["is_error"], r["subtype"], r["degraded_by"], source, sha, now_utc(),
            exit_status(r)]
    if rel is not None:
        old = con.execute("SELECT source_sha256, exit_status FROM roster_runs WHERE log_path=?", (rel,)).fetchone()
        if old and old[0] == sha and old[1] == vals[-1]:
            return "unchanged"
        if old:
            con.execute(f"UPDATE roster_runs SET {', '.join(c + '=?' for c in cols)} WHERE log_path=?", vals + [rel])
            return "changed"
    con.execute(f"INSERT INTO roster_runs({','.join(cols)}) VALUES({','.join('?' * len(cols))})", vals)
    return "new"


def run_gap(r: dict) -> bool:
    """A real gap: a contract-era log (not legacy_no_exit) missing exit= or cost_usd=. Skips carry no cost by design."""
    st = exit_status(r)
    if st == "legacy_no_exit":
        return False
    return st == "missing" or (r["cost_usd"] is None and r["verdict"] != "SKIPPED")


def verb_record_run(a, o: Out) -> int:
    need_db(a.db)
    if a.log:
        # One log, as the runner records it after its typed exit line (CN-04). Idempotent by log path and digest.
        p = Path(a.log).resolve()
        base = (ROOTS["evidence"] / "roster").resolve()
        if p.parent.parent != base or not p.name.startswith("run-") or p.suffix != ".log":
            raise Refusal("usage_record_run", f"--log must be {base}/<agent>/run-*.log, got {p}", EXIT_USAGE)
        data = read_source(p)
        rel = str(p.relative_to(ROOTS["evidence"].resolve()))
        r = parse_run_log(data.decode("utf-8", "replace"), p.parent.name, rel)
        with Writer(a.db) as con:
            st = upsert_run(con, r, "cli", rel, log_digest(data))
        check_readback(a.db, py_counts(a.db, ["roster_runs"]), o)
        gap = run_gap(r)
        o.line(f"run={rel} verdict={r['verdict']} exit={r['exit_code']} exit_status={exit_status(r)} cost_usd={r['cost_usd']} {st}")
        o.doc.update({"state": st, "exit_status": exit_status(r), "gap": gap})
        return o.emit(EXIT_GAPS if gap else EXIT_OK, "1/1", f"{st} exit_status={exit_status(r)}")
    if a.from_logs:
        base = ROOTS["evidence"] / "roster"
        logs = sorted(base.glob("*/run-*.log"))
        if not logs:
            o.line(f"unmeasured_empty_world glob={base}/*/run-*.log")
            return o.emit(EXIT_UNMEASURED, "0/0")
        parsed, states = [], {"new": 0, "changed": 0, "unchanged": 0}
        for p in logs:
            data = read_source(p)
            rel = str(p.relative_to(ROOTS["evidence"]))
            parsed.append((parse_run_log(data.decode("utf-8", "replace"), p.parent.name, rel), rel, log_digest(data)))
        with Writer(a.db) as con:
            for r, rel, sha in parsed:
                st = upsert_run(con, r, "backfill", rel, sha)
                states[st] += 1
                o.line(f"run={rel} verdict={r['verdict']} exit={r['exit_code']} exit_status={exit_status(r)} cost_usd={r['cost_usd']} {st}")
        legacy = sorted((ROOTS["evidence"] / "curator").glob("run-*.log"))
        if legacy:
            o.line(f"excluded_logs={len(legacy)} path=curator/run-*.log reason=pre-roster runner ops/curator (retired by V4-19); not roster runs")
        n = py_counts(a.db, ["roster_runs"])
        check_readback(a.db, n, o)
        gaps = sum(1 for r, _, _ in parsed if run_gap(r))
        legacy = sum(1 for r, _, _ in parsed if exit_status(r) == "legacy_no_exit")
        if legacy:
            o.line(f"excluded_pre_contract={legacy} exit_status=legacy_no_exit reason=stamp < {EXIT_CONTRACT_STAMP} predates the "
                   "V4-24/V4-26 exit= contract; logs are never rewritten, so the rows are marked, not counted as gaps")
        o.doc.update(states)
        o.doc["runs_missing_exit_or_cost"] = gaps
        o.doc["excluded_pre_contract"] = legacy
        code = EXIT_GAPS if gaps else EXIT_OK
        return o.emit(code, f"{len(parsed)}/{len(logs)}", f"new={states['new']} changed={states['changed']} unchanged={states['unchanged']} missing_exit_or_cost={gaps} excluded_pre_contract={legacy}")
    for req in ("agent", "mode", "stamp", "verdict"):
        if not getattr(a, req):
            raise Refusal("usage_record_run", f"--{req} is required (or use --from-logs)", EXIT_USAGE)
    r = {"agent": a.agent, "mode": a.mode, "stamp": a.stamp, "exit_code": a.exit, "measure_rc": a.measure_rc,
         "claude_rc": a.claude_rc, "verdict": a.verdict, "verdict_line": a.verdict_line, "cost_usd": a.cost_usd,
         "is_error": a.is_error, "subtype": a.subtype, "degraded_by": a.degraded_by}
    before = py_counts(a.db, ["roster_runs"])["roster_runs"]
    with Writer(a.db) as con:
        upsert_run(con, r, "cli", None, None)
    check_readback(a.db, {"roster_runs": before + 1}, o)
    return o.emit(EXIT_OK, "1/1")


