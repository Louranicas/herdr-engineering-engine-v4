class CaptureOut(Out):
    """An Out that records the verdict instead of printing it (a verb run inside another verb)."""

    def emit(self, code: int, measured: str | None = None, extra: str = "") -> int:
        self.doc.update({"verdict": VERDICT_OF.get(code, "FAIL"), "exit": code, "measured": measured, "extra": extra, "lines": self.lines})
        return code


def newest_verify() -> dict:
    """The newest `just verify` log dir. The recipe prints its summary line to stdout only, so the line itself
    is UNMEASURED here; each step log's last verdict line (the same grep the recipe uses) is reported instead."""
    dirs = sorted(p for p in VERIFY_LOGS.glob("verify-*") if p.is_dir()) if VERIFY_LOGS.is_dir() else []
    if not dirs:
        return {"state": "UNMEASURED", "why": f"no {VERIFY_LOGS}/verify-*/ log dir"}
    d = dirs[-1]
    steps = []
    for f in sorted(d.glob("*.log")):
        txt = reg_read(f, 4 * 1024 * 1024).decode("utf-8", "replace").splitlines()
        hits = [ln for ln in txt if not ln.startswith("{") and ("verdict=" in ln or ln.startswith("pins ") or "refused" in ln)]
        last = hits[-1][:220] if hits else ""
        tok = "PASS" if ("verdict=PASS" in last or (last.startswith("pins ") and " stale=0 " in last and "unpinned=0" in last)) else ("FAIL" if last else "NONE")
        steps.append({"step": f.stem, "last": last, "reads": tok})
    npass = sum(s["reads"] == "PASS" for s in steps)
    return {"state": "UNMEASURED_LINE", "dir": str(d), "stamp": d.name.removeprefix("verify-"),
            "why": "`just verify` prints its `verify verdict=` line to stdout only; its log dir holds step logs, not the line",
            "steps_read_pass": f"{npass}/{len(steps)}", "steps": steps}


