def split_statements(script: str) -> list[str]:
    """Split a script with sqlite3.complete_statement (the engine's own completeness test)."""
    out, buf = [], []
    for ln in script.splitlines(keepends=True):
        buf.append(ln)
        chunk = "".join(buf)
        if sqlite3.complete_statement(chunk):
            stmt = chunk.strip()
            if stmt and not all(x.strip().startswith("--") or not x.strip() for x in stmt.splitlines()):
                out.append(stmt)
            buf = []
    rest = "".join(buf).strip()
    if rest and not all(x.strip().startswith("--") or not x.strip() for x in rest.splitlines()):
        raise Refusal("migration_malformed", f"trailing incomplete statement: {rest[:120]}")
    return out


def migration_files() -> list[tuple[int, str, Path]]:
    res = []
    for p in sorted(SCHEMA_DIR.glob("[0-9][0-9][0-9]_*.sql")):
        res.append((int(p.name[:3]), p.stem[4:], p))
    return res


def verb_migrate(a, o: Out) -> int:
    db = a.db
    files = migration_files()
    if not files:
        raise Refusal("setup_no_migrations", f"no NNN_*.sql in {SCHEMA_DIR}", EXIT_SETUP)
    applied = {}
    if db.exists():
        con = ro_connect(db)
        try:
            if con.execute("SELECT 1 FROM sqlite_schema WHERE name='schema_migrations'").fetchone():
                applied = {r[0]: r[1] for r in con.execute("SELECT version, sha256 FROM schema_migrations")}
        finally:
            con.close()
    else:
        db.parent.mkdir(parents=True, exist_ok=True)
        # The file is CREATED by tursodb (habitat finding: tursodb reads SQLite-written files and vice versa).
        rc, _, err = run_bounded([TURSODB, "-q", str(db), "PRAGMA journal_mode"], 4096)
        if rc != 0:
            raise Refusal("setup_create", f"tursodb could not create {db}: {err[:200]}", EXIT_SETUP)
        o.line(f"created db={db} engine=tursodb")
    done, drift = 0, []
    for ver, name, path in files:
        sha = sha256_bytes(read_source(path))
        if ver in applied:
            if applied[ver] != sha:
                drift.append(f"{path.name} applied_sha={applied[ver][:12]} file_sha={sha[:12]}")
            continue
        stmts = split_statements(path.read_text())
        with Writer(db) as con:
            for s in stmts:
                con.execute(s)
            con.execute("INSERT INTO schema_migrations(version,name,sha256,applied_at) VALUES(?,?,?,?)",
                        (ver, name, sha, now_utc()))
        o.line(f"migration={path.name} statements={len(stmts)} applied")
        done += 1
    if drift:
        for d in drift:
            o.line(f"migration_drift {d}")
        raise Refusal("migration_drift", "an applied migration file changed; add a new migration instead")
    # second engine: tursodb must parse the resulting schema
    out = turso_ro(db, "SELECT count(*) FROM schema_migrations")
    n = int(out.strip().splitlines()[-1])
    o.doc.update({"applied_now": done, "migrations": n})
    return o.emit(EXIT_OK, f"{n}/{len(files)}", f"applied_now={done}")


def verb_schema(a, o: Out) -> int:
    con = ro_connect(a.db)
    try:
        if a.table:
            r = con.execute("SELECT type, sql FROM sqlite_schema WHERE name=?", (a.table,)).fetchone()
            if not r:
                raise Refusal("not_found", f"no table or view named {a.table}")
            cols = [dict(cid=c[0], name=c[1], type=c[2], notnull=c[3], pk=c[5])
                    for c in con.execute("SELECT * FROM pragma_table_info(?)", (a.table,))]
            fks = [dict(col=f[3], ref_table=f[2], ref_col=f[4]) for f in con.execute("SELECT * FROM pragma_foreign_key_list(?)", (a.table,))]
            n = con.execute(f'SELECT count(*) FROM "{a.table}"').fetchone()[0]
            o.doc.update({"table": a.table, "type": r[0], "columns": cols, "foreign_keys": fks, "rows": n, "sql": r[1]})
            o.doc["text"] = r[1]
            return o.emit(EXIT_OK, f"{len(cols)}/{len(cols)}", f"rows={n}")
        objs = con.execute("SELECT name, type FROM sqlite_schema WHERE type IN ('table','view') AND name NOT LIKE 'sqlite_%' ORDER BY type, name").fetchall()
        rows = []
        for name, typ in objs:
            ncol = con.execute("SELECT count(*) FROM pragma_table_info(?)", (name,)).fetchone()[0]
            nrow = con.execute(f'SELECT count(*) FROM "{name}"').fetchone()[0]
            rows.append({"name": name, "type": typ, "columns": ncol, "rows": nrow, "role": table_role(name)})
        o.doc["rows"] = rows
        return o.emit(EXIT_OK, f"{len(rows)}/{len(rows)}")
    finally:
        con.close()


def table_role(name: str) -> str:
    if name in DERIVED_TABLES or name == "sources":
        return "derived"
    if name in REGISTRY_TABLES:
        return "derived(registry)"
    if name == "agent_status":
        return "view"
    if name.startswith("habitat_"):
        return "imported"
    if name.startswith("v_"):
        return "view"
    if name == "schema_migrations":
        return "meta"
    return "primary"


# ─────────────────────────────── verbs: reads ───────────────────────────────

def caps(a) -> tuple[int, int]:
    rc = min(max(1, a.rows), ROW_CAP_MAX)
    bc = min(max(1024, a.bytes), BYTE_CAP_MAX)
    return rc, bc


def verb_q(a, o: Out) -> int:
    rc, bc = caps(a)
    sql = a.sql.strip().rstrip(";").strip()
    if a.engine == "turso":
        return q_turso(a, o, sql, rc, bc)
    rows, tables = bounded_select(a.db, sql, tuple(a.param or ()), rc, bc)
    o.doc["rows"] = rows
    o.doc["tables_read"] = sorted(tables)
    if not rows:
        w = world_rows(a.db, tables) if tables else 0
        o.doc["world_rows"] = w
        if w == 0:
            o.line(f"unmeasured_empty_world tables={','.join(sorted(tables)) or 'none'} world_rows=0")
            return o.emit(EXIT_UNMEASURED, "0/0", "world_rows=0")
        return o.emit(EXIT_OK, "0/0", f"world_rows={w}")
    return o.emit(EXIT_OK, f"{len(rows)}/{len(rows)}", f"row_cap={rc} byte_cap={bc}")


def q_turso(a, o: Out, sql: str, rc: int, bc: int) -> int:
    # Same read-only guarantee: the RAW statement must pass the Python authorizer first. EXPLAIN
    # compiles it (the authorizer fires at prepare) without running it.
    bounded_select(a.db, f"EXPLAIN {sql}", (), 100000, BYTE_CAP_MAX)
    out = turso_ro(a.db, f"SELECT * FROM ({sql}) LIMIT {rc + 1}", bc)
    lines = [ln for ln in out.splitlines() if ln != ""]
    if len(lines) > rc:
        raise Refusal("refused_row_cap", f"rows>{rc} cap={rc}")
    o.doc["format"] = "tursodb-list (| separated; use the default engine for typed JSON)"
    o.doc["rows"] = lines
    o.doc["text"] = "\n".join(lines)
    if not lines:
        return o.emit(EXIT_OK, "0/0")
    return o.emit(EXIT_OK, f"{len(lines)}/{len(lines)}", "engine=tursodb")


