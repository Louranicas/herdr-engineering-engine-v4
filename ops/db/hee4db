def phase_table(w: dict) -> list[dict]:
    rows = []
    for ph in PHASES:
        ids = sorted((d for d, v in w["dcs"].items() if v["status_class"] != "RESOLVED" and v["phase"] == ph), key=dc_sort)
        mods: set[str] = set()
        for d in ids:
            if w["dcs"][d]["scope"] == "all":
                mods.add(w["dcs"][d]["modules"])
            mods.update(w["modules_of_dc"].get(d, []))
        rows.append({"phase": ph, "dc_ids": ids, "modules": sorted(mods)})
    return rows


def phase_table_md(rows: list[dict]) -> str:
    out = ["| Phase | Open DC ids | Modules affected |", "|---|---|---|"]
    for r in rows:
        out.append(f"| {r['phase']} | {', '.join(r['dc_ids']) or '—'} | {', '.join(r['modules']) or '—'} |")
    return "\n".join(out) + "\n"


def um_amendments(w: dict) -> list[dict]:
