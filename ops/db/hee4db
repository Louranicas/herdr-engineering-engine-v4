        verdicts = {r_[0]: r_[1] for r_ in con.execute("SELECT id, verdict FROM verifications")}
        fits = [{"id": f[0], "grade": f[1], "allowed_now": f[2], "gates": f[3].split(",") if f[3] else [], "phases": f[4],
                 "decision": clip(f[5], 160)}
                for f in con.execute("SELECT j.id, j.grade, j.allowed_now, j.gates, j.phases, j.decision FROM jev_fit_modules m "
                                     "JOIN jev_fits j ON j.id = m.fit_id WHERE m.module = ? ORDER BY j.section, j.source_line", (name,))]
        fits_all = [r_[0] for r_ in con.execute("SELECT id FROM jev_fits WHERE modules = 'ALL' ORDER BY source_line")]
    finally:
        con.close()
    vers = []
    for p in sorted((ROOTS["evidence"] / "verification").glob("V*.md")):
        t = read_text(p)
