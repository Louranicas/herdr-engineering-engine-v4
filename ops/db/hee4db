def local_day(ts: str) -> str | None:
    try:
        return dt.datetime.fromisoformat(ts).astimezone().strftime("%Y-%m-%d")
    except (ValueError, TypeError):
        return None


def is_v4(cwd: str | None) -> bool:
    return bool(cwd) and any(m in cwd for m in V4_CWD_MARKERS)


JEV_SENDERS = [
    # sender, file, sent predicate, has cwd, method
    ("verifier", "jev-verifier/verdicts.jsonl", lambda o: o.get("usage") is not None, True,
     "sent = usage non-null (V8 selection rule); v4 = cwd names the v4 repo or hee4-evidence"),
    ("router", "jev-router/decisions.jsonl", lambda o: "votes" in o, True,
     "sent = a Jev vote was requested ('votes' present); v4 by cwd; rows without cwd counted in rows_no_cwd"),
    ("read-gate", "jev-read-gate/decisions.jsonl",
     lambda o: (o.get("sent_chars") or 0) > 0 and o.get("action") != "refused" and not str(o.get("action") or "").startswith("skipped"), False,
     "sent = a non-refused, non-skipped row with sent_chars > 0 (a refused row carries sent_chars but never reached Jev; Jev Fit Map C3, 2026-10-01); the log carries no cwd, so rows_v4_cwd is UNMEASURED"),
    # rev 2026-10-02 (V4-74): jev-recall appends one row per live match since the round-9 install; before that it kept
    # counters only (V4-29), so a day before its first row is UNMEASURED, never zero (see `first_day` below)
    ("recall", "jev-recall/sends.jsonl", lambda o: o.get("sent") is True, True,
     "sent = the row's own `sent` (jevpack.ask was called: matched, no_match, malformed, transport_error); v4 by cwd"),
]


def verb_record_jev_daily(a, o: Out) -> int:
    need_db(a.db)
    day = a.day or dt.datetime.now().astimezone().strftime("%Y-%m-%d")
    rows, gaps = [], 0
    for sender, rel, sent_pred, has_cwd, method in JEV_SENDERS:
        p = JEV_STATE / rel
        if not p.exists():
            rows.append({"sender": sender, "rows_total": None, "rows_sent": None, "rows_v4_cwd": None, "rows_no_cwd": None,
                         "measured": "unmeasured", "method": f"UNMEASURED (absent: {p})", "source_path": str(p), "sha": None})
            gaps += 1
            continue
        data = read_source(p)
        tot = sent = v4 = nocwd = bad = 0
        first_day = None
        for line in data.splitlines():
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                bad += 1
                continue
            d = local_day(rec.get("ts")) if isinstance(rec, dict) else None
            if d and (first_day is None or d < first_day):
                first_day = d
            if d != day:
                continue
            tot += 1
            if sent_pred(rec):
                sent += 1
                if has_cwd:
                    if rec.get("cwd"):
                        v4 += is_v4(rec.get("cwd"))
                    else:
                        nocwd += 1
        measured = "full" if has_cwd and nocwd == 0 and bad == 0 else ("partial" if has_cwd or tot else "unmeasured")
        if not has_cwd:
            measured = "partial"
        if first_day is None or day < first_day:
            # the log did not exist yet on that day: a zero there would read as "nothing sent" (rev 2026-10-02, V4-74)
            rows.append({"sender": sender, "rows_total": None, "rows_sent": None, "rows_v4_cwd": None, "rows_no_cwd": None,
                         "measured": "unmeasured", "method": f"UNMEASURED (log begins {first_day or 'with no dated row'}): " + method,
                         "source_path": str(p), "sha": sha256_bytes(data)})
            gaps += 1
            continue
        gaps += measured != "full"
        rows.append({"sender": sender, "rows_total": tot, "rows_sent": sent, "rows_v4_cwd": v4 if has_cwd else None,
                     "rows_no_cwd": nocwd if has_cwd else None, "measured": measured,
                     "method": method + (f"; unparseable_lines={bad}" if bad else ""), "source_path": str(p), "sha": sha256_bytes(data)})
    with Writer(a.db) as con:
        for r in rows:
            con.execute("INSERT INTO jev_egress_daily(day, sender, rows_total, rows_sent, rows_v4_cwd, rows_no_cwd, measured, method, source_path, source_sha256, recorded_at) "
                        "VALUES(?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(day, sender) DO UPDATE SET rows_total=excluded.rows_total, rows_sent=excluded.rows_sent, "
                        "rows_v4_cwd=excluded.rows_v4_cwd, rows_no_cwd=excluded.rows_no_cwd, measured=excluded.measured, method=excluded.method, "
                        "source_path=excluded.source_path, source_sha256=excluded.source_sha256, recorded_at=excluded.recorded_at",
                        (day, r["sender"], r["rows_total"], r["rows_sent"], r["rows_v4_cwd"], r["rows_no_cwd"], r["measured"],
                         r["method"], r["source_path"], r["sha"], now_utc()))
            o.line(f"jev day={day} sender={r['sender']} total={r['rows_total']} sent={r['rows_sent']} v4_cwd={r['rows_v4_cwd']} "
                   f"no_cwd={r['rows_no_cwd']} measured={r['measured']}")
    check_readback(a.db, py_counts(a.db, ["jev_egress_daily"]), o)
    full = sum(r["measured"] == "full" for r in rows)
    o.doc["rows"] = [{k: v for k, v in r.items() if k != "sha"} for r in rows]
    return o.emit(EXIT_GAPS if gaps else EXIT_OK, f"{full}/{len(rows)}", f"day={day} senders_fully_measured={full}/{len(rows)}")


# jev entry: the ATLAS P0 Jev entry read-back (H-8, H-19; rev 2026-10-02, V4-74) ----------------------------------
# Prints the two lines P0 entry names: JP0 (`jev-boundary text` refuses every v4 line, the controls hold) and
# `sent_engine_rows=E/S` over EVERY sender since the door last changed, each sent row's logged head and cwd replayed
# through the same door. The door is run as its CLI and never imported (the one door stays the door). Readers: ATLAS
# P0 entry and `hee4-module-slice` §0. Method limits, printed with the result: the verifier logs a 120-char claim head,
# the router a 49-char description and recall a 120-char prompt head, so a marker past the head is not replayed
# (under-count); the read gate logs only sha256(path)[:12], matched against every file path in the v4 homes (a v4
# file read through another spelling of its path is missed: under-count).
JEV_DOOR = os.environ.get("HEE4DB_JEV_DOOR", "jev-boundary")
JEV_DOOR_LIB = Path(os.environ.get("HEE4DB_JEV_DOOR_LIB", HOME / ".local/lib/jevpack/boundary.py"))
JEV_ENTRY_ROW_CAP = int(os.environ.get("HEE4DB_JEV_ENTRY_ROW_CAP", "5000"))
JEV_ENTRY_PATH_CAP = int(os.environ.get("HEE4DB_JEV_ENTRY_PATH_CAP", "200000"))
JEV_ENTRY_PROSE = ("HEE v4", "HEE-v4", "HEEv4", "herdr engineering engine v4", "hee4", "run hee4db recipe restart",
                   "read ~/handoffs/HEE4_RESTART.md", "the hee4-namespace-shim binary", "systemctl --user start hee4.service",
                   "~/.local/state/hee4/active.json", "$XDG_RUNTIME_DIR/hee4/control.sock")
JEV_ENTRY_CONTROLS = (("v3_control", "see the notes under ~/hee3-evidence/T28", 3),
                      ("clean_control", "what time zone is Canberra in", 0))
JEV_ENTRY_REPLAY = {   # sender -> the logged fields replayed through the door (text, joined by newlines)
    "verifier": ("claim_head", "cwd"), "router": ("description", "cwd"), "recall": ("prompt_head", "cwd")}
# A sender whose per-send log is younger than its traffic: the log is complete from the moment the code that writes it
# was installed, not from its first row (a logger that has sent nothing yet has no row). Other senders' logs are
# ready from their first row.
JEV_ENTRY_LOGGER = {"recall": Path(os.environ.get("HEE4DB_JEV_RECALL_CODE", HOME / ".local/lib/jevpack/jev_recall.py"))}


def logger_ready(sender: str) -> dt.datetime | None:
    p = JEV_ENTRY_LOGGER.get(sender)
    try:
        return dt.datetime.fromtimestamp(p.stat().st_mtime, dt.timezone.utc) if p else None
    except OSError:
        return None


def jev_entry_verdict(battery: list[tuple[str, int]], controls: list[tuple[str, int, int]],
                      senders: list[dict]) -> tuple[int, list[str]]:
    """Pure: the P0 Jev entry verdict from values. A control that does not hold comes FIRST and yields UNMEASURED: a
    door that refuses or passes everything makes every other answer it gave meaningless (the control found a FAIL
    built on engine rows a broken door had invented, 2026-10-02). Then FAIL when the door passes a v4 line or any
    measured sender sent an engine row (a measured red outranks a gap); UNMEASURED when the door answered neither 0
    nor 3 or a sender could not be measured; PASS otherwise. The battery is never empty: it always holds the three
    home paths, and a world with no hee4 crate is refused before this runs (jev_entry_no_world)."""
    bad_ctl = [name for name, rc, want in controls if rc != want]
    if bad_ctl:
        return EXIT_UNMEASURED, ["control_wrong=" + ",".join(bad_ctl)]
    reasons: list[str] = []
    passed = [line for line, rc in battery if rc == 0]
    odd = [line for line, rc in battery if rc not in (0, 3)]
    engine = [s["sender"] for s in senders if s["measured"] and (s["engine"] or 0) > 0]
    if passed:
        reasons.append(f"jp0_v4_line_passes={len(passed)}")
    if engine:
        reasons.append("sent_engine_rows_from=" + ",".join(engine))
    if reasons:
        return EXIT_REFUSED, reasons
    if odd:
        reasons.append(f"door_rc_unexpected={len(odd)}")
    unm = [s["sender"] for s in senders if not s["measured"]]
    if unm:
        reasons.append("sender_unmeasured=" + ",".join(unm))
    return (EXIT_UNMEASURED, reasons) if reasons else (EXIT_OK, [])


def door_rc(arg: str, mode: str = "text") -> int:
    cmd = [JEV_DOOR, "text"] if mode == "text" else [JEV_DOOR, "path", arg]
    try:
        r = subprocess.run(cmd, input=arg if mode == "text" else None, capture_output=True, text=True,
                           stdin=None if mode == "text" else subprocess.DEVNULL, timeout=SUBPROC_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired):
        return -1
    return r.returncode


def jev_entry_battery() -> list[str]:
    """v4 phrasings from the world: every hee4 crate in MODULES.toml (the one home of module data), the V4-11
    namespace and Luke's prose spellings, and the three v4 homes as text."""
    try:
        mods = tomllib.loads(read_source(ROOTS["repo"] / "modules" / "MODULES.toml").decode())["module"]
    except (OSError, KeyError, tomllib.TOMLDecodeError) as e:
        raise Refusal("jev_entry_no_world", f"modules/MODULES.toml unreadable ({e.__class__.__name__})") from e
    crates = sorted({str(m.get("crate", "")) for m in mods if str(m.get("crate", "")).startswith("hee4")})
    if not crates:
        raise Refusal("jev_entry_no_world", "modules/MODULES.toml names no hee4 crate")
    return ([f"edit crates/{c}/src/lib.rs" for c in crates] + [f"synthetic: {p}" for p in JEV_ENTRY_PROSE]
            + [f"see {r}" for r in ROOTS.values()])


def v4_path_hashes() -> tuple[set[str], int]:
    """sha256(path)[:12] of every file in the v4 homes and the HEE4 handoffs, in both spellings the read gate may
    have been handed (plain and /run/host); bounded, refused by name past the cap."""
    paths: list[str] = []
    for root in list(ROOTS.values()):
        for dirpath, dirs, files in os.walk(root):
            dirs[:] = [d for d in dirs if d not in (".git", "__pycache__", "node_modules")]
            paths += [os.path.join(dirpath, f) for f in files]
            if len(paths) > JEV_ENTRY_PATH_CAP:
                raise Refusal("jev_entry_paths_over_cap", f"files>{JEV_ENTRY_PATH_CAP} cap={JEV_ENTRY_PATH_CAP} under {root}")
    paths += [str(p) for p in sorted(HANDOFFS.glob("HEE4_*"))]
    hs = set()
    for p in paths:
        for s in (p, "/run/host" + p):
            hs.add(hashlib.sha256(s.encode("utf-8", "surrogatepass")).hexdigest()[:12])
    return hs, len(paths)


def jev_entry_sender(sender: str, rel: str, sent_pred, since: dt.datetime, v4_hashes: set[str]) -> dict:
    p = JEV_STATE / rel
    out = {"sender": sender, "measured": False, "sent": 0, "engine": 0, "rows_since": 0, "method": ""}
    if not p.exists():
        out["method"] = f"UNMEASURED (absent: {p})"
        return out
    rows, bad, first = [], 0, None
    for line in read_source(p).splitlines():
        try:
            rec = json.loads(line)
            t = dt.datetime.fromisoformat(str(rec.get("ts")))
        except (json.JSONDecodeError, ValueError, TypeError, AttributeError):
            bad += 1
            continue
        if t.tzinfo is None:
            bad += 1
            continue
        first = t if first is None or t < first else first
        if t >= since:
            rows.append(rec)
    ready = logger_ready(sender) or first
    if ready is None or ready > since:
        out["method"] = f"UNMEASURED (log ready {ready.isoformat() if ready else 'never: no dated row'}, after since)"
        return out
    sent = [r for r in rows if sent_pred(r)]
    if len(sent) > JEV_ENTRY_ROW_CAP:
        raise Refusal("jev_entry_rows_over_cap", f"sender={sender} sent_rows={len(sent)} cap={JEV_ENTRY_ROW_CAP}")
    if sender == "read-gate":
        eng = sum(1 for r in sent if r.get("path_sha256_12") in v4_hashes)
        how = "path hash matched against the v4 homes"
    else:
        fields = JEV_ENTRY_REPLAY[sender]
        rcs = [door_rc("\n".join(str(r.get(f) or "") for f in fields)) for r in sent]
        if any(rc not in (0, 3) for rc in rcs):
            out["method"] = f"UNMEASURED (door rc not 0/3 on {sum(rc not in (0, 3) for rc in rcs)} replays)"
            return out
        eng = sum(rc == 3 for rc in rcs)
        how = "replayed " + "+".join(fields) + " through the door"
    out.update(measured=True, sent=len(sent), engine=eng, rows_since=len(rows),
               method=how + (f"; unparseable_lines={bad}" if bad else ""))
    return out


def verb_jev_entry(a, o: Out) -> int:
    if a.since:
        try:
            since = dt.datetime.fromisoformat(a.since)
        except ValueError as e:
            raise Refusal("usage", f"--since {a.since!r} is not ISO-8601", EXIT_USAGE) from e
        if since.tzinfo is None:
            raise Refusal("usage", f"--since {a.since!r} has no UTC offset", EXIT_USAGE)
        since_src = "arg"
    else:
        try:
            since = dt.datetime.fromtimestamp(JEV_DOOR_LIB.stat().st_mtime, dt.timezone.utc)
        except OSError as e:
            raise Refusal("jev_entry_no_door", f"{JEV_DOOR_LIB} unreadable ({e.__class__.__name__}); pass --since") from e
        # from the moment the door AND every per-send logger were in place: earlier rows predate the fix
        since = max([since] + [t for t in (logger_ready(s) for s in JEV_ENTRY_LOGGER) if t])
        since_src = "door_and_loggers_mtime"
    battery = [(line, door_rc(line)) for line in jev_entry_battery()]
    battery += [(str(r), door_rc(str(r), "path")) for r in ROOTS.values()]
    controls = [(name, door_rc(text), want) for name, text, want in JEV_ENTRY_CONTROLS]
    hashes, nfiles = v4_path_hashes()
    senders = [jev_entry_sender(s, rel, pred, since, hashes) for s, rel, pred, _cwd, _m in JEV_SENDERS]
    code, reasons = jev_entry_verdict(battery, controls, senders)
    refused = sum(rc == 3 for _, rc in battery)
    o.line(f"jp0 lines={len(battery)} refused={refused} passed={sum(rc == 0 for _, rc in battery)} "
           f"odd_rc={sum(rc not in (0, 3) for _, rc in battery)} door={JEV_DOOR}")
    for line, rc in battery:
        if rc != 3:
            o.line(f"jp0_line_not_refused rc={rc} line={line[:120]!r}")
    for name, rc, want in controls:
        o.line(f"control name={name} rc={rc} want={want} {'ok' if rc == want else 'WRONG'}")
    for s in senders:
        o.line(f"sender={s['sender']} measured={'yes' if s['measured'] else 'no'} sent={s['sent']} engine={s['engine']} "
               f"rows_since={s['rows_since']} method={s['method']}")
    sent_total = sum(s["sent"] for s in senders if s["measured"])
    eng_total = sum(s["engine"] for s in senders if s["measured"])
    m = sum(s["measured"] for s in senders)
    o.doc.update(since=since.isoformat(), since_source=since_src, reasons=reasons, v4_files_hashed=nfiles,
                 rows=[{k: v for k, v in s.items()} for s in senders])
    return o.emit(code, f"{refused}/{len(battery)}",
                  f"sent_engine_rows={eng_total}/{sent_total} senders_measured={m}/{len(senders)} "
                  f"since={since.isoformat()} since_source={since_src}" + (" reasons=" + ";".join(reasons) if reasons else ""))


