def verb_help(a, o: Out) -> int:
    o.doc["rows"] = [{"verb": v, "what": w, "example": e} for v, w, e in VERBS]
    o.doc["exit_codes"] = {"0": "ok", "10": "ok-with-gaps", "20": "refused/failed check", "30": "unmeasured", "2": "usage", "3": "setup"}
    o.doc["db"] = str(a.db)
    return o.emit(EXIT_OK, f"{len(VERBS)}/{len(VERBS)}")


GLOBAL_VALUE_FLAGS = ("--db", "--rows", "--bytes")
GLOBAL_BOOL_FLAGS = ("--table", "--json")


def hoist_globals(argv: list[str]) -> list[str]:
    """Global flags may appear anywhere; move them in front of the verb for argparse."""
    front, rest, i = [], [], 0
    while i < len(argv):
        t = argv[i]
        if t in GLOBAL_BOOL_FLAGS:
            front.append(t)
        elif t in GLOBAL_VALUE_FLAGS and i + 1 < len(argv):
            front += [t, argv[i + 1]]
            i += 1
        elif any(t.startswith(f + "=") for f in GLOBAL_VALUE_FLAGS):
            front.append(t)
        else:
            rest.append(t)
        i += 1
    return front + rest


def parse(argv: list[str]):
    import argparse

    class P(argparse.ArgumentParser):
        def error(self, message: str) -> None:  # argparse hook: usage errors become a typed refusal
            raise Refusal("usage", message, EXIT_USAGE)

    p = P(prog="hee4db", add_help=False)
    p.add_argument("--db", type=Path, default=DEFAULT_DB)
    p.add_argument("--table", dest="fmt", action="store_const", const="table", default="json")
    p.add_argument("--json", dest="fmt", action="store_const", const="json")
    p.add_argument("--rows", type=int, default=ROW_CAP_DEFAULT)
    p.add_argument("--bytes", type=int, default=BYTE_CAP_DEFAULT)
    sub = p.add_subparsers(dest="verb")
    sub.add_parser("help", add_help=False)
    s = sub.add_parser("schema", add_help=False)
    s.add_argument("table", nargs="?")
    sub.add_parser("recipes", add_help=False)
    s = sub.add_parser("recipe", add_help=False)
    s.add_argument("name")
    s.add_argument("args", nargs="*")
    s = sub.add_parser("q", add_help=False)
    s.add_argument("sql")
    s.add_argument("--param", action="append")
    s.add_argument("--engine", choices=["python", "turso"], default="python")
    s = sub.add_parser("get", add_help=False)
    s.add_argument("entity")
    s.add_argument("id")
    s = sub.add_parser("search", add_help=False)
    s.add_argument("text", nargs="+")
    sub.add_parser("migrate", add_help=False)
    sub.add_parser("ingest", add_help=False)
    sub.add_parser("migrate-habitat", add_help=False)
    sub.add_parser("check", add_help=False)
    s = sub.add_parser("highway", add_help=False)
    s.add_argument("module", nargs="?")
    s.add_argument("--phase")
    s.add_argument("--dc")
    s.add_argument("--phase-table", action="store_true")
    s.add_argument("--um-amendments", action="store_true")
    s.add_argument("--jev", action="store_true")
    s.add_argument("--grade", choices=list(JEV_GRADES))
    s.add_argument("--md", action="store_true")
    s = sub.add_parser("readiness", add_help=False)
    s.add_argument("--md", action="store_true")
    s = sub.add_parser("stale", add_help=False)
    s.add_argument("--no-habitat", action="store_true")
    s = sub.add_parser("jev-entry", add_help=False)
    s.add_argument("--since")
    s = sub.add_parser("mcp", add_help=False)
    s.add_argument("--print-argv", action="store_true")
    r = sub.add_parser("record", add_help=False)
    rs = r.add_subparsers(dest="what")
    x = rs.add_parser("run", add_help=False)
    x.add_argument("--from-logs", action="store_true")
    x.add_argument("--log")
    for f in ("agent", "mode", "stamp", "verdict", "verdict-line", "measure-rc", "is-error", "subtype", "degraded-by"):
        x.add_argument(f"--{f}")
    x.add_argument("--exit", type=int)
    x.add_argument("--claude-rc", type=int)
    x.add_argument("--cost-usd", type=float)
    x = rs.add_parser("measurement", add_help=False)
    x.add_argument("--from-measure-files", action="store_true")
    x.add_argument("--file")
    x.add_argument("--name")
    x.add_argument("--value", type=float)
    x.add_argument("--value-text")
    x.add_argument("--denominator", type=float)
    x.add_argument("--unmeasured", action="store_true")
    x.add_argument("--measured-at")
    x.add_argument("--source")
    x = rs.add_parser("jev-daily", add_help=False)
    x.add_argument("--day")
    x = rs.add_parser("claim", add_help=False)
    for f in ("who", "claim", "evidence"):
        x.add_argument(f"--{f}")
    x = rs.add_parser("verify", add_help=False)
    x.add_argument("--id", type=int)
    for f in ("by", "result"):
        x.add_argument(f"--{f}")
    x.add_argument("--status", choices=["verified", "refuted", "unmeasured"])
    return p.parse_args(hoist_globals(argv))


DISPATCH = {"help": verb_help, "schema": verb_schema, "recipes": verb_recipes, "recipe": verb_recipe, "q": verb_q,
            "get": verb_get, "search": verb_search, "migrate": verb_migrate, "ingest": verb_ingest,
            "migrate-habitat": verb_migrate_habitat, "check": verb_check, "stale": verb_stale, "mcp": verb_mcp,
            "highway": verb_highway, "readiness": verb_readiness, "jev-entry": verb_jev_entry}
RECORD = {"run": verb_record_run, "measurement": verb_record_measurement, "jev-daily": verb_record_jev_daily,
          "claim": verb_record_claim, "verify": verb_record_verify}


def main(argv: list[str]) -> int:
    fmt = "table" if "--table" in argv else "json"
    verb = "usage"
    try:
        a = parse(argv)
        verb = a.verb or "help"
        if verb == "record":
            if not a.what:
                raise Refusal("usage", "record needs one of: " + ", ".join(RECORD), EXIT_USAGE)
            verb = f"record-{a.what}"
            fn = RECORD[a.what]
        else:
            fn = DISPATCH[verb]
        a.db = a.db.expanduser()
        return fn(a, Out(verb, a.fmt))
    except Refusal as r:
        o = Out(verb, fmt)
        o.doc["diagnostic"] = r.diag
        o.doc["detail"] = r.detail
        o.line(f"{r.diag} {r.detail}")
        return o.emit(r.code)
    except sqlite3.DatabaseError as e:
        o = Out(verb, fmt)
        o.line(f"db_error {e}")
        return o.emit(EXIT_REFUSED)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
