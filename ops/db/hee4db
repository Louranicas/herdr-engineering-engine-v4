def verb_recipe(a, o: Out) -> int:
    if a.name in COMPOSITE_RECIPES:
        return recipe_restart(a, o)
    if a.name not in RECIPES:
        raise Refusal("usage_recipe", f"unknown recipe {a.name}; see `hee4db recipes`", EXIT_USAGE)
    what, sql, defaults = RECIPES[a.name]
    given = list(a.args)
    vals = []
    for i, d in enumerate(defaults):
        if d.startswith("@"):
            vals.append(vals[int(d[1:])])
        else:
            vals.append(given[i] if i < len(given) else d)
    rc, bc = caps(a)
    rows, tables = bounded_select(a.db, sql, tuple(vals), rc, bc)
    o.doc.update({"recipe": a.name, "what": what, "params": vals, "rows": rows})
    if a.name in RECIPE_NOTES:
        o.doc["rule"] = globals()[RECIPE_NOTES[a.name]]
        o.line(f"rule {o.doc['rule']}")
    if a.name == "reflexes" and rows:
        o.line(f"reflexes={len(rows)} jev_senders={sum(r['jev_sender'] for r in rows)}")
    if not rows:
        w = world_rows(a.db, tables)
        o.doc["world_rows"] = w
        if w == 0:
            o.line(f"unmeasured_empty_world tables={','.join(sorted(tables))}")
            return o.emit(EXIT_UNMEASURED, "0/0", "world_rows=0")
        return o.emit(EXIT_OK, "0/0", f"world_rows={w}")
    return o.emit(EXIT_OK, f"{len(rows)}/{len(rows)}")


