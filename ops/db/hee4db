def rs_count(repo: Path) -> int:
    """`.rs` files under the repo outside migrated/ and .git/ (the "is there code" fact). Bounded walk."""
    n, seen = 0, 0
    for dirpath, dirnames, filenames in os.walk(repo):
        rel = Path(dirpath).relative_to(repo)
        if rel.parts[:1] in (("migrated",), (".git",), ("target",)):
            dirnames[:] = []
            continue
        seen += len(dirnames) + len(filenames)
        if seen > RS_WALK_CAP:
            raise Refusal("refused_walk_cap", f"repo entries>{RS_WALK_CAP} cap={RS_WALK_CAP} while counting .rs files")
        n += sum(f.endswith(".rs") for f in filenames)
    return n


