def stale_report(db: Path, include_habitat: bool = True) -> dict:
    con = ro_connect(db)
    try:
        srcs = con.execute("SELECT id, root, rel_path, sha256, rows_derived FROM sources").fetchall()
        hab = []
        if include_habitat:
            for t, (_, _, target, _cols, _where) in HABITAT_PLAN.items():
                hab += [(t, target, r[0], r[1]) for r in con.execute(f'SELECT source_rowid, source_row_sha256 FROM "{target}"')]
    finally:
        con.close()
    stale, absent = [], []
    for _sid, root, rel, sha, n in srcs:
        p = ROOTS[root] / rel
        if not p.exists():
            absent.append({"source": f"{root}:{rel}", "rows": n})
            continue
        cur = sha256_bytes(read_source(p))
        if cur != sha:
            stale.append({"source": f"{root}:{rel}", "rows": n, "ingested_sha": sha[:12], "current_sha": cur[:12]})
    known = {(r, rel) for _, r, rel, _, _ in srcs}
    plan, _acct = enumerate_world()
    new_files = sorted(f"{r}:{rel}" for r, rel, _ in plan if (r, rel) not in known and (ROOTS[r] / rel).exists())
    hab_stale, hab_checked, hab_state = [], 0, "skipped"
    if include_habitat and hab:
        if HABITAT_DB.exists():
            hab_state = "checked"
            for t, (_, _, _target, cols, _where) in HABITAT_PLAN.items():
                current = {r["rowid"]: row_sha(r) for r in habitat_rows(t, cols, "1=1")}
                for tt, _tgt, rowid, sha in hab:
                    if tt != t:
                        continue
                    hab_checked += 1
                    if current.get(rowid) != sha:
                        hab_stale.append({"table": t, "rowid": rowid, "state": "deleted" if rowid not in current else "changed"})
        else:
            hab_state = "unmeasured"
    con = ro_connect(db)
    try:
        reg_stale = registry_stale(con)
    finally:
        con.close()
    return {"sources": len(srcs), "stale": stale, "absent": absent, "new_files": new_files, "habitat_checked": hab_checked,
            "habitat_rows": len(hab), "habitat_stale": hab_stale, "habitat_state": hab_state, "registry_stale": reg_stale}


def verb_stale(a, o: Out) -> int:
    rep = stale_report(a.db, not a.no_habitat)
    for s in rep["stale"]:
        o.line(f"stale_source source={s['source']} rows={s['rows']} ingested_sha={s['ingested_sha']} current_sha={s['current_sha']}")
    for s in rep["absent"]:
        o.line(f"stale_source_absent source={s['source']} rows={s['rows']}")
    for s in rep["habitat_stale"]:
        o.line(f"stale_habitat_row table={s['table']} rowid={s['rowid']} state={s['state']}")
    for f in rep["new_files"]:
        o.line(f"stale_world_new_file source={f} (in the ingest world, not yet ingested)")
    for s in rep["registry_stale"]:
        o.line(f"stale_registry path={s['path']} state={s['state']}")
    o.doc.update(rep)
    o.doc["rows"] = rep["stale"] + rep["absent"]
    if rep["sources"] == 0:
        o.line("unmeasured_empty_world sources=0 (run `hee4db ingest`)")
        return o.emit(EXIT_UNMEASURED, "0/0")
    nstale = len(rep["stale"]) + len(rep["absent"]) + len(rep["habitat_stale"]) + len(rep["new_files"]) + len(rep["registry_stale"])
    fresh = rep["sources"] - len(rep["stale"]) - len(rep["absent"])
    extra = f"stale_sources={len(rep['stale'])} absent={len(rep['absent'])} new_files={len(rep['new_files'])} habitat_stale={len(rep['habitat_stale'])} habitat={rep['habitat_state']} registry_stale={len(rep['registry_stale'])}"
    if nstale:
        return o.emit(EXIT_REFUSED, f"{fresh}/{rep['sources']}", extra)
    if rep["habitat_state"] == "unmeasured":
        return o.emit(EXIT_GAPS, f"{fresh}/{rep['sources']}", extra)
    return o.emit(EXIT_OK, f"{fresh}/{rep['sources']}", extra)


def verb_check(a, o: Out) -> int:
    need_db(a.db)
    results: list[tuple[str, int, str]] = []

    def add(name: str, code: int, detail: str) -> None:
        results.append((name, code, detail))
        o.line(f"check={name} verdict={VERDICT_OF[code]} {detail}")

    # 1. integrity on two engines; the text must be exactly 'ok' (exit 0 is not a verdict)
    try:
        con = ro_connect(a.db)
        py = [r[0] for r in con.execute("PRAGMA integrity_check").fetchall()]
        con.close()
    except sqlite3.DatabaseError as e:
        py = [f"error: {e}"]
    try:
        tu = turso_ro(a.db, "PRAGMA integrity_check").strip().splitlines()
    except Refusal as r:
        tu = [f"error: {r.detail}"]
    ok = py == ["ok"] and tu == ["ok"]
    add("integrity", EXIT_OK if ok else EXIT_REFUSED,
        f"measured=2/2 python={'ok' if py == ['ok'] else 'integrity_not_ok:' + ';'.join(py)[:200]} "
        f"tursodb={'ok' if tu == ['ok'] else 'integrity_not_ok:' + ';'.join(tu)[:200]}")
    if not ok:
        o.line("integrity_not_ok (the remaining checks still run)")
    # 2. foreign keys: Python only (tursodb 0.7.2 returns no rows on a planted violation, rc=0)
    try:
        con = ro_connect(a.db)
        fk = con.execute("PRAGMA foreign_key_check").fetchall()
        nt = con.execute("SELECT count(*) FROM sqlite_schema WHERE type='table'").fetchone()[0]
        con.close()
        add("foreign_keys", EXIT_OK if not fk else EXIT_REFUSED,
            f"measured={nt}/{nt} violations={len(fk)}" + (f" foreign_key_violation first={fk[0]}" if fk else "") + " engine=python")
    except sqlite3.DatabaseError as e:
        add("foreign_keys", EXIT_REFUSED, f"measured=0/1 error={e}")
    # 3. migrations applied = files
    try:
        con = ro_connect(a.db)
        applied = {r[0]: r[1] for r in con.execute("SELECT version, sha256 FROM schema_migrations")}
        con.close()
        files = migration_files()
        bad = [p.name for v, _, p in files if applied.get(v) != sha256_bytes(read_source(p))]
        add("migrations", EXIT_OK if not bad else EXIT_REFUSED, f"measured={len(files) - len(bad)}/{len(files)}" + (f" migration_drift={bad}" if bad else ""))
    except sqlite3.DatabaseError as e:
        add("migrations", EXIT_REFUSED, f"error={e}")
    # 4. world: an empty derived world is UNMEASURED, never PASS. (rev 2026-10-05 schedule) An empty REGISTRY table
    #    whose registry_sources kind was read with status ok is a measured zero (an empty present source), printed
    #    as measured_empty=<table>:<kind>=ok; one whose sources are all absent/unreadable stays unmeasured.
    try:
        cnt = py_counts(a.db, DERIVED_TABLES + ["sources"] + REGISTRY_TABLES)
        con = ro_connect(a.db)
        try:
            kinds_ok = {r[0] for r in con.execute("SELECT DISTINCT kind FROM registry_sources WHERE status='ok'")}
        finally:
            con.close()
        empty, measured_empty = [], []
        for t, n in cnt.items():
            if n:
                continue
            ok_kinds = [k for k in REGISTRY_SOURCE_KINDS.get(t, ()) if k in kinds_ok]
            if ok_kinds:
                measured_empty.append(f"{t}:" + ",".join(f"{k}=ok" for k in ok_kinds))
            else:
                empty.append(t)
        add("world", EXIT_OK if not empty else EXIT_UNMEASURED,
            f"measured={len(cnt) - len(empty)}/{len(cnt)} derived_rows={sum(cnt.values())}"
            + "".join(f" measured_empty={m}" for m in measured_empty)
            + (f" unmeasured_empty_world empty={','.join(empty)}" if empty else ""))
    except (sqlite3.DatabaseError, Refusal) as e:
        add("world", EXIT_REFUSED, f"error={e}")
    # 5. stale derived rows
    try:
        rep = stale_report(a.db, include_habitat=False)
        n = len(rep["stale"]) + len(rep["absent"]) + len(rep["new_files"])
        add("stale", EXIT_UNMEASURED if rep["sources"] == 0 else (EXIT_OK if n + len(rep["registry_stale"]) == 0 else EXIT_REFUSED),
            f"measured={rep['sources'] - n}/{rep['sources']} stale_rows={sum(s['rows'] for s in rep['stale'] + rep['absent'])}"
            + "".join(f" stale_source={s['source']}" for s in rep["stale"] + rep["absent"])
            + "".join(f" stale_world_new_file={f}" for f in rep["new_files"])
            + (f" registry_stale={len(rep['registry_stale'])}" if rep["registry_stale"] else "")
            + "".join(f" stale_registry={s['path']}:{s['state']}" for s in rep["registry_stale"][:20]))
    except (sqlite3.DatabaseError, Refusal) as e:
        add("stale", EXIT_REFUSED, f"error={e}")
    # 6. orphans: module cross-references to ids that no ingested table holds
    try:
        con = ro_connect(a.db)
        orphan_sql = {
            "ap": "SELECT ref FROM module_refs WHERE kind='ap' AND ref NOT IN (SELECT id FROM antipatterns)",
            "ex": "SELECT ref FROM module_refs WHERE kind='ex' AND ref NOT IN (SELECT id FROM exemplars WHERE kind='exemplar')",
            "anti": "SELECT ref FROM module_refs WHERE kind='anti' AND ref NOT IN (SELECT id FROM exemplars WHERE kind='anti-exemplar')",
            "d": "SELECT ref FROM module_refs WHERE kind='d' AND ref NOT IN (SELECT id FROM drift_controls)",
            "h": "SELECT ref FROM module_refs WHERE kind='h' AND ref NOT IN (SELECT id FROM held_items)",
            "v4": "SELECT ref FROM module_refs WHERE kind='v4' AND ref NOT IN (SELECT id FROM decisions)",
            "held_phase": "SELECT held_id FROM held_item_phases WHERE held_id NOT IN (SELECT id FROM held_items)",
        }
        total = con.execute("SELECT count(*) FROM module_refs WHERE kind IN ('ap','ex','anti','d','h','v4')").fetchone()[0]
        orphans = {k: sorted({r[0] for r in con.execute(s)}) for k, s in orphan_sql.items()}
        con.close()
        n = sum(len(v) for v in orphans.values())
        add("orphans", EXIT_UNMEASURED if total == 0 else (EXIT_OK if n == 0 else EXIT_GAPS),
            f"measured={total}/{total} orphan_refs={n}" + "".join(f" orphan_{k}={','.join(v)}" for k, v in orphans.items() if v))
    except sqlite3.DatabaseError as e:
        add("orphans", EXIT_REFUSED, f"error={e}")
    # 7. FTS sidecar freshness
    try:
        st, _ = sidecar_state(a.db)
        add("sidecar", EXIT_OK if st == "fresh" else EXIT_GAPS, f"measured=1/1 state={st}")
    except (Refusal, sqlite3.DatabaseError) as e:
        add("sidecar", EXIT_GAPS, f"error={e}")
    # 8-12. alignment of the planning substrates (ATLAS §9, ULTRAMAP §7, card ⇄ design funnel, readiness note)
    alignment_checks(a.db, add)
    # 13-15. the Jev Fit Map (rev 2026-10-01 jev-fit): self-check line, scope box, gates in ATLAS §5
    jev_checks(a.db, add)
    # 16-17. the registry (rev 2026-10-01 registry, V4-70): v4-relevant skills parse; every scheduled agent is defined
    registry_checks(a.db, add)
    # 18. held: every ATLAS §5 status word sits in the Item cell, the one cell parse_held reads (rev 2026-10-05)
    held_checks(add)
    # aggregate refuses as one unit: worst code wins (20 > 30 > 10 > 0)
    order = {EXIT_OK: 0, EXIT_GAPS: 1, EXIT_UNMEASURED: 2, EXIT_REFUSED: 3}
    worst = max((c for _, c, _ in results), key=lambda c: order[c])
    passed = sum(c == EXIT_OK for _, c, _ in results)
    o.doc["checks"] = [{"check": n, "verdict": VERDICT_OF[c], "detail": d} for n, c, d in results]
    return o.emit(worst, f"{passed}/{len(results)}", f"checks={len(results)}")


