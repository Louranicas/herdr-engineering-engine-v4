def write_registry(con: sqlite3.Connection, res: dict[str, list[dict]], ts: str) -> None:
    for t in REGISTRY_TABLES:
        con.execute(f'DELETE FROM "{t}"')
    for t in REGISTRY_TABLES:
        cols = REG_COLS[t] + ["source_root", "source_rel"]
        for r in res[t]:
            root, rel = reg_loc(r["path"] if t == "registry_sources" else r["source_path"])
            con.execute(f'INSERT INTO "{t}"({",".join(cols)}) VALUES({",".join("?" * len(cols))})',
                        [ts if c == "ingested_at" else r[c] for c in REG_COLS[t]] + [root, rel])


def registry_stale(con: sqlite3.Connection) -> list[dict]:
    """Registry rows whose file changed or vanished, registry files not yet ingested, and a changed crontab."""
    out: list[dict] = []
    known: dict[tuple[str, str], str] = {}
    for t in ("skills", "agents", "agent_modes", "reflexes"):
        for root, rel, sha in con.execute(f'SELECT DISTINCT source_root, source_rel, source_sha256 FROM "{t}"'):
            known[(root, rel)] = sha
    for root, rel, sha in con.execute("SELECT source_root, source_rel, sha256 FROM registry_sources WHERE kind='settings' AND status='ok'"):
        known[(root, rel)] = sha
    for (root, rel), sha in sorted(known.items()):
        fp = reg_resolve(root, rel)
        if fp is None:
            continue
        if not fp.is_file():
            out.append({"path": f"{root}:{rel}", "state": "absent"})
        elif sha256_bytes(reg_read(fp)) != sha:
            out.append({"path": f"{root}:{rel}", "state": "changed"})
    world = [d / "SKILL.md" for base in (CLAUDE_HOME / "skills", ROOTS["repo"] / ".claude" / "skills") if base.is_dir()
             for d in sorted(base.iterdir()) if (d / "SKILL.md").is_file()]
    world += [f for base in (ROOTS["repo"] / ".claude" / "agents", CLAUDE_HOME / "agents") if base.is_dir() for f in sorted(base.glob("*.md"))]
    world += [f for base in (CLAUDE_HOME / "hooks", ROOTS["repo"] / ".claude" / "hooks") if base.is_dir() for f in sorted(base.glob("*.sh"))]
    roster = ROOTS["repo"] / "ops" / "roster"
    world += sorted(roster.glob("*/modes.conf")) if roster.is_dir() else []
    world += [p for p in (CLAUDE_HOME / "settings.json", ROOTS["repo"] / ".claude" / "settings.json") if p.is_file()]
    for p in world:
        loc = reg_loc(str(p))
        if loc not in known:
            out.append({"path": f"{loc[0]}:{loc[1]}", "state": "new"})
    row = con.execute("SELECT sha256 FROM registry_sources WHERE kind='crontab' AND status='ok'").fetchone()
    if row:
        status, text, _ = read_crontab()
        if status == "ok" and text is not None and sha256_bytes(text.encode()) != row[0]:
            out.append({"path": CRONTAB_FILE or CRONTAB_LABEL, "state": "changed"})
    row = con.execute("SELECT sha256 FROM registry_sources WHERE kind='timers' AND status='ok'").fetchone()
    if row:
        tstatus, _units, tsha, _detail = scan_timers()
        if tstatus == "absent":
            out.append({"path": str(TIMERS_DIR), "state": "absent"})
        elif tstatus == "ok" and tsha != row[0]:
            out.append({"path": str(TIMERS_DIR), "state": "changed"})
    return out


def registry_checks(db: Path, add) -> None:
    """registry_skills: every v4_relevant skill file exists and parses, and every curated name is a skill.
    registry_agents: every agent a schedule source (crontab or timers) runs has a clean definition, a modes.conf, and
    the mode it is run in. UNMEASURED when no schedule source is readable; PASS over the readable sources (never
    measured=0/0, F138/AP-29) when they hold no roster job."""
    try:
        con = ro_connect(db)
        try:
            rel = con.execute("SELECT scope, name, dir_name, source_root, source_rel FROM skills WHERE v4_relevant = 1 ORDER BY scope, dir_name").fetchall()
            names = {r[0] for r in con.execute("SELECT dir_name FROM skills")}
        finally:
            con.close()
        bad = []
        for scope, name, dname, root, rp in rel:
            p = reg_resolve(root, rp)
            if p is None or not p.is_file():
                bad.append(f"registry_skill_absent skill={scope}:{dname} path={root}:{rp}")
                continue
            fm, err = parse_frontmatter(reg_read(p).decode("utf-8", "replace"))
            if err is None and (not fm.get("name") or not fm.get("description")):
                err = "frontmatter_missing"
            if err is None and fm.get("name") != dname:
                err = f"name_mismatch name={fm.get('name')}"
            if err:
                bad.append(f"registry_skill_unparsed skill={scope}:{dname} error={err}")
        bad += [f"registry_skill_curated_unknown name={c}" for c in sorted(SKILL_V4_CURATED) if c not in names]
        add("registry_skills", EXIT_UNMEASURED if not rel else (EXIT_OK if not bad else EXIT_REFUSED),
            f"measured={len(rel) - sum(not b.startswith('registry_skill_curated') for b in bad)}/{len(rel)} v4_relevant={len(rel)}"
            + ("" if rel else " unmeasured_empty_world v4_relevant=0") + "".join(" " + b for b in bad))
    except (sqlite3.DatabaseError, Refusal) as e:
        add("registry_skills", EXIT_REFUSED, f"error={e}")
    try:
        con = ro_connect(db)
        try:
            srcrows = con.execute("SELECT kind, status, detail, entries FROM registry_sources WHERE kind IN ('crontab','timers')").fetchall()
            roster_dir = con.execute("SELECT entries FROM registry_sources WHERE kind='roster_dir' AND status='ok'").fetchone()
            sched = con.execute("SELECT agent, mode, source_line, source_path FROM agent_schedules WHERE kind='roster' "
                                "ORDER BY source_path, source_line").fetchall()
            defs = {r[0]: r[1] for r in con.execute("SELECT name, parse_error FROM agents")}
            modes: dict[str, set[str]] = {}
            for ag, md in con.execute("SELECT agent, mode FROM agent_modes"):
                modes.setdefault(ag, set()).add(md)
        finally:
            con.close()
        by_kind = {k: (st, det, ent) for k, st, det, ent in srcrows}
        sources_ok = sorted(k for k, (st, _, _) in by_kind.items() if st == "ok")
        cstat = by_kind.get("crontab", ("no_row",))[0]
        tstat = by_kind.get("timers", ("no_row",))[0]
        if not sources_ok:
            add("registry_agents", EXIT_UNMEASURED, f"measured=0/0 registry_schedule_unmeasured crontab={cstat} timers={tstat}"
                + ("" if srcrows else " (no schedule rows: run `hee4db ingest`)"))
        elif not sched:
            n = len(sources_ok)      # the subjects measured are the readable schedule sources, never 0/0
            add("registry_agents", EXIT_OK, f"measured={n}/{n} roster_jobs=0 roster_dirs={roster_dir[0] if roster_dir else 0} "
                f"timers={by_kind.get('timers', (None, None, 0))[2]} crontab={cstat} sources=present")
        else:
            bad, failed = [], set()
            for ag, md, ln, sp in sched:
                loc = f"source={sp} line={ln}"
                if ag not in defs:
                    bad.append(f"registry_agent_undefined agent={ag} {loc}")
                    failed.add((sp, ln))
                elif defs[ag]:
                    bad.append(f"registry_agent_definition_unparsed agent={ag} error={defs[ag]}")
                    failed.add((sp, ln))
                if ag not in modes:
                    bad.append(f"registry_agent_no_modes agent={ag} {loc}")
                    failed.add((sp, ln))
                elif md not in modes[ag]:
                    bad.append(f"registry_agent_mode_unknown agent={ag} mode={md} {loc}")
                    failed.add((sp, ln))
            add("registry_agents", EXIT_OK if not bad else EXIT_REFUSED,
                f"measured={len(sched) - len(failed)}/{len(sched)} roster_jobs={len(sched)} agents={len({s[0] for s in sched})} "
                f"sources={','.join(sources_ok)}" + "".join(" " + b for b in bad))
    except (sqlite3.DatabaseError, Refusal) as e:
        add("registry_agents", EXIT_REFUSED, f"error={e}")


