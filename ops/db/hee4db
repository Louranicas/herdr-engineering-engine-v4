            hph.setdefault(hid, []).append(ph)
        budgets = {r[0]: dict(zip(("module", "cluster", "crate", "rec", "v3_size", "target", "scope", "driver"), r, strict=True))
                   for r in con.execute("SELECT module, cluster, crate, rec, v3_size, target, scope, driver FROM module_budgets")}
        dcs = {r[0]: dict(zip(("id", "title", "phase", "scope", "status_class", "recommendation", "cites_um", "modules", "line"), r, strict=True))
               for r in con.execute("SELECT id, title, phase, scope, status_class, recommendation, cites_um, modules, source_line FROM design_conflicts")}
        cm: dict[str, list[str]] = {}
        for dc, m in con.execute("SELECT dc_id, module FROM conflict_modules ORDER BY dc_id"):
            cm.setdefault(m, []).append(dc)
        dc_mods: dict[str, list[str]] = {}
        for dc, m in con.execute("SELECT dc_id, module FROM conflict_modules ORDER BY module"):
            dc_mods.setdefault(dc, []).append(m)
    finally:
        con.close()
    if not mods or not budgets or not dcs:
        raise Refusal("unmeasured_empty_world", f"modules={len(mods)} module_budgets={len(budgets)} design_conflicts={len(dcs)}; run `hee4db ingest`", EXIT_UNMEASURED)
    return {"modules": mods, "refs": refs, "held": held, "held_phases": hph, "budgets": budgets, "dcs": dcs,
            "dcs_of_module": cm, "modules_of_dc": dc_mods}


def open_holds(w: dict, phase: str) -> list[str]:
    ids = [h for h, phs in w["held_phases"].items() if phase in phs and w["held"].get(h, {}).get("status") == "open"]
    return sorted(ids, key=held_sort)


def held_sort(h: str) -> tuple:
    num = h[2:].rstrip("abcdefghijklmnopqrstuvwxyz")
    return (int(num) if num.isdigit() else 999, h)


def dc_sort(d: str) -> int:
    return int(d[3:]) if d[3:].isdigit() else 999


def readiness_rows(w: dict, rs_files: int) -> tuple[list[dict], dict]:
    """Apply the readiness rules. Order of precedence: DEFERRED > BLOCKED (LUKE) > ARCH REVIEW > READY TO BUILD."""
    universal = open_holds(w, "P0")
    rows = []
    for m in w["modules"]:
        name = m["name"]
        r = w["refs"].get(name, {})
        phases = sorted(r.get("phase", []), key=lambda p: int(p[1:]))
        b = w["budgets"].get(name)
        if b is None:
            raise Refusal("readiness_no_budget", f"module {name} has no Anti-Bloat budget row")
        scope_key = b["scope"].split()[0] if b["scope"].split() else ""
        open_in_phase = sorted((d for d in w["dcs_of_module"].get(name, [])
                                if w["dcs"][d]["status_class"] != "RESOLVED" and w["dcs"][d]["phase"] in phases), key=dc_sort)
        # module-specific held items: the module's own H refs, minus the universal P0 holds, open, blocking the phase in
        # which the module is first built (its entry); holds on later phases are listed by the highway, not here
        first = phases[0] if phases else None
        specific = [h for h in r.get("h", []) if h not in universal and w["held"].get(h, {}).get("status") == "open"
                    and first in w["held_phases"].get(h, [])]
        luke_dcs = [d for d in open_in_phase if w["dcs"][d]["status_class"] == "OPEN"]
        rec = ""
        if scope_key in DEFERRED_SCOPES:
            build = "DEFERRED"
        elif specific or luke_dcs:
            build = "BLOCKED (LUKE)"
            parts = [f"Luke decides {h} before {first}" for h in specific]
            for d in luke_dcs:
                hs = [t.strip(".,;:()") for t in w["dcs"][d]["recommendation"].split() if t.strip(".,;:()").startswith("H-")]
                parts.append(f"Luke decides {hs[0] + ' (' + d + ')' if hs else d} before {w['dcs'][d]['phase']}")
            rec = "; ".join(parts)
        elif open_in_phase:
            build = "ARCH REVIEW"
            # ratify every non-P3 conflict before the earliest phase among them; P3 conflicts are settled by the P3 flow
            # contract (V13: P3 is not codable until it settles DC-38…DC-41)
            ratify = [d for d in open_in_phase if w["dcs"][d]["phase"] != "P3"]
            settle = [d for d in open_in_phase if w["dcs"][d]["phase"] == "P3"]
            parts = []
            if ratify:
                parts.append(f"ratify {', '.join(ratify)} before {min((w['dcs'][d]['phase'] for d in ratify), key=lambda p: int(p[1:]))}")
            if settle:
                parts.append(f"settle {', '.join(settle)} in the P3 flow contract")
            rec = "; ".join(parts)
        else:
            build = "READY TO BUILD"
        rows.append({"cluster": b["cluster"], "module": name, "crate": m["crate"],
                     "deploy": "NOT READY" if rs_files == 0 else "UNMEASURED (code exists; no deploy gate yet)",
                     "build": build, "phases": phases, "scope": b["scope"], "audit_review": f"{m['flag']} / {b['rec']}",
                     "budget": b["target"], "migrated": len(r.get("migrated_path", [])), "open_dcs": open_in_phase,
                     "specific_holds": specific, "recommendation": rec})
    rows.sort(key=lambda x: (CLUSTER_ORDER.index(x["cluster"]) if x["cluster"] in CLUSTER_ORDER else 99, x["module"]))
    counts = {k: sum(x["build"] == k for x in rows) for k in ("READY TO BUILD", "ARCH REVIEW", "BLOCKED (LUKE)", "DEFERRED")}
    deploy_ready = sum(x["deploy"] == "READY" for x in rows)
    global_dcs = sorted((d for d, v in w["dcs"].items() if v["status_class"] != "RESOLVED" and v["scope"] == "all"), key=dc_sort)
    summary = {"deploy_ready": deploy_ready, "modules": len(rows), "counts": counts, "rs_files": rs_files,
               "universal_p0_holds": universal, "all_module_dcs": global_dcs}
    return rows, summary


