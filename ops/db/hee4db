def habitat_json(sql: str) -> list[dict]:
    out = turso_ro(HABITAT_DB, sql, HABITAT_JSON_CAP)
    s = out.strip()
    if not s:
        return []
    try:
        return json.loads(s)
    except json.JSONDecodeError as e:
        raise Refusal("habitat_read_malformed", f"tursodb JSON did not parse: {e}") from e


def habitat_rows(table: str, cols: str, where: str) -> list[dict]:
    keys = ["rowid"] + [c.strip() for c in cols.split(",")]
    obj = ", ".join(f"'{k}', {k}" for k in keys)
    return habitat_json(f"SELECT json_group_array(json_object({obj})) FROM (SELECT rowid, {cols} FROM \"{table}\" WHERE {where} ORDER BY rowid)")


def row_sha(row: dict) -> str:
    return sha256_bytes(json.dumps({k: v for k, v in row.items() if k != "rowid"}, sort_keys=True, ensure_ascii=False).encode())


def verb_migrate_habitat(a, o: Out) -> int:
    need_db(a.db)
    if not HABITAT_DB.exists():
        raise Refusal("setup_no_habitat_db", f"{HABITAT_DB} absent", EXIT_UNMEASURED)
    world = habitat_json("SELECT json_group_array(name) FROM sqlite_schema WHERE type='table' AND name NOT LIKE 'sqlite_%'")
    unexplained = sorted(set(world) - set(HABITAT_PLAN) - set(HABITAT_SKIP))
    if unexplained:
        raise Refusal("habitat_world_unexplained", f"tables with no disposition: {unexplained}")
    counts: dict[str, int] = {}
    for t in world:
        counts[t] = int(turso_ro(HABITAT_DB, f'SELECT count(*) FROM "{t}"').strip())
    payload = {}
    for t, (_disp, _reason, _target, cols, where) in HABITAT_PLAN.items():
        payload[t] = habitat_rows(t, cols, where)
    ts = now_utc()
    src = str(HABITAT_DB)
    with Writer(a.db) as con:
        con.execute("DELETE FROM habitat_migration_ledger")
        for t, rows in payload.items():
            disp, reason, target, _, _ = HABITAT_PLAN[t]
            con.execute(f'DELETE FROM "{target}"')
            for r in rows:
                base = [src, t, r["rowid"], row_sha(r)]
                if t == "learnings":
                    scope = "v3-provenance" if any(m in (r["title"] + r["body"]) for m in V3_MARKERS) else "general"
                    con.execute("INSERT INTO habitat_learnings VALUES(?,?,?,?,?,?,?,?,?,?)",
                                base + [r["id"], r["title"], r["body"], r["standing"], scope, ts])
                elif t == "engine_features":
                    con.execute("INSERT INTO habitat_engine_features VALUES(?,?,?,?,?,?,?,?,?,?)",
                                base + [r["id"], r["area"], r["status"], r["detail"], r["source_url"], ts])
                elif t == "composition_rules":
                    con.execute("INSERT INTO habitat_composition_rules VALUES(?,?,?,?,?,?,?,?,?)",
                                base + [r["id"], r["rule"], r["source"], r["how_to_check"], ts])
                elif t == "doc_sources":
                    con.execute("INSERT INTO habitat_doc_sources VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                                base + [r["id"], r["role"], r["title"], r["url"], r["deployed_here"], r["jev_note"], ts])
            if disp == "migrated" and len(rows) != counts[t]:
                disp = "partial"
            con.execute("INSERT INTO habitat_migration_ledger VALUES(?,?,?,?,?,?,?)",
                        (t, counts[t], len(rows), disp, reason, target, ts))
            o.line(f"habitat table={t} rows={counts[t]} migrated={len(rows)} disposition={disp} target={target}")
        for t in sorted(world):
            if t in HABITAT_SKIP:
                con.execute("INSERT INTO habitat_migration_ledger VALUES(?,?,?,?,?,?,?)",
                            (t, counts[t], 0, "not_migrated", HABITAT_SKIP[t], None, ts))
                o.line(f"habitat table={t} rows={counts[t]} migrated=0 disposition=not_migrated reason={HABITAT_SKIP[t]}")
    targets = [v[2] for v in HABITAT_PLAN.values()] + ["habitat_migration_ledger"]
    check_readback(a.db, py_counts(a.db, targets), o)
    migrated = sum(len(v) for v in payload.values())
    build_sidecar(a.db, o)          # habitat_learnings is part of the search corpus
    o.doc.update({"tables_in_source": len(world), "rows_migrated": migrated})
    return o.emit(EXIT_OK, f"{len(world)}/{len(world)}",
                  f"tables_with_disposition={len(world)}/{len(world)} rows_migrated={migrated} source_rows={sum(counts.values())}")


