def enumerate_world() -> tuple[list[tuple[str, str, str]], list[dict]]:
    """Returns (to_parse [(root, rel, parser)], accounting rows for every file seen)."""
    plan: dict[tuple[str, str], str] = {}
    acct = []
    for root, rel, parser in WORLD_FILES:
        plan[(root, rel)] = parser
    for root, pat, parser in WORLD_GLOBS:
        base = ROOTS[root]
        for p in sorted(base.glob(pat)):
            rel = str(p.relative_to(base))
            key = (root, rel)
            if key in plan:
                continue
            if key in EXCLUDED:
                acct.append({"root": root, "rel": rel, "status": "excluded", "reason": EXCLUDED[key]})
            elif parser:
                plan[key] = parser
            else:
                acct.append({"root": root, "rel": rel, "status": "unexplained",
                             "reason": "matched a world glob with no parser and no exclusion"})
    return [(r, rel, p) for (r, rel), p in plan.items()], acct


