def verb_readiness(a, o: Out) -> int:
    w = load_world(a.db)
    rows, s = readiness_rows(w, rs_count(ROOTS["repo"]))
    c = s["counts"]
    extra = (f"deploy_ready={s['deploy_ready']}/{s['modules']} ready_to_build={c['READY TO BUILD']} arch_review={c['ARCH REVIEW']} "
             f"blocked_luke={c['BLOCKED (LUKE)']} deferred={c['DEFERRED']} rs_files={s['rs_files']}")
    if a.md:
        sys.stdout.write(readiness_md(rows, s, w))
        sys.stderr.write(f"hee4db readiness verdict=PASS exit=0 measured={len(rows)}/{len(rows)} {extra}\n")
        return EXIT_OK
    o.doc.update({"summary": s, "rows": rows})
    return o.emit(EXIT_OK, f"{len(rows)}/{len(rows)}", extra)


