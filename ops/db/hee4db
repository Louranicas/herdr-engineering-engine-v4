def cross_check_parsed(parsed: list) -> None:
    """Rows from one source that name another source's ids are validated BEFORE the write, so a typo in the
    register refuses by name instead of surfacing as a foreign-key failure inside the transaction."""
    mods = {r["name"] for *_, res in parsed for r in res.get("modules", [])}
    for root, rel, _p, _s, _n, res in parsed:
        for r in res.get("conflict_modules", []):
            if r["module"] not in mods:
                raise Refusal("ingest_malformed", f"source={rel} line {r['line']} {r['dc_id']} names unknown module {r['module']!r} (not in MODULES.toml)")
        for r in res.get("module_budgets", []):
            if r["module"] not in mods:
                raise Refusal("ingest_malformed", f"source={rel} line {r['line']} budget row names unknown module {r['module']!r}")
        clusters = {r["name"]: r["cluster"] for *_, res_ in parsed for r in res_.get("modules", [])}
        for r in res.get("jev_fit_modules", []):
            if r["module"] not in mods:
                raise Refusal("ingest_malformed", f"source={rel} line {r['line']} {r['fit_id']} names unknown module {r['module']!r} (not in MODULES.toml)")
            if clusters[r["module"]] != r["cluster"]:
                raise Refusal("ingest_malformed", f"source={rel} line {r['line']} {r['fit_id']} names module {r['module']!r} under {r['cluster']}, MODULES.toml says {clusters[r['module']]}")
        if res.get("module_budgets") is not None and mods - {r["module"] for r in res["module_budgets"]}:
            raise Refusal("ingest_malformed", f"source={rel} budget table lacks modules {sorted(mods - {r['module'] for r in res['module_budgets']})}")


def insert_derived(con: sqlite3.Connection, table: str, r: dict, sid: int, sha: str, ts: str) -> None:
    cols = list(COLS[table])
    vals = [r[c] for c in cols]
    if table in LINK_TABLES:
        cols.append("source_id")
        vals.append(sid)
    else:
        cols += ["source_id", "source_sha256", "ingested_at"]
        vals += [sid, sha, ts]
        if table in HAS_LINE:
            cols.append("source_line")
            vals.append(r["line"])
    con.execute(f'INSERT INTO "{table}"({",".join(cols)}) VALUES({",".join("?" * len(cols))})', vals)


def record_failed_receipt(db: Path, verb: str, started: str, r: Refusal, seen: int) -> None:
    """A refusal writes itself into the record (in its own transaction, after the rollback)."""
    try:
        with Writer(db) as con:
            con.execute("INSERT INTO ingest_receipts(verb, started_at, finished_at, status, sources_seen, sources_changed, rows_written, detail_json) "
                        "VALUES(?,?,?,?,?,?,?,?)", (verb, started, now_utc(), "refused", seen, 0, 0,
                                                    json.dumps({"diag": r.diag, "detail": r.detail[:500]})))
    except Exception as e:  # the refusal itself stays the reported outcome
        sys.stderr.write(f"receipt_write_failed {e}\n")


