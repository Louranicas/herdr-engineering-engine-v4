def highway_phase(a, w: dict, ph: str) -> dict:
    if ph not in PHASES:
        raise Refusal("usage_phase", f"phase must be one of {PHASES}", EXIT_USAGE)
    rows, _ = readiness_rows(w, rs_count(ROOTS["repo"]))
    mods = [{"module": x["module"], "crate": x["crate"], "build": x["build"], "open_dcs_here": [d for d in x["open_dcs"] if w["dcs"][d]["phase"] == ph]}
            for x in rows if ph in x["phases"]]
    dcs = [{"id": d, "status_class": v["status_class"], "title": v["title"], "modules": w["modules_of_dc"].get(d, []) or [v["modules"]],
            "recommendation": clip(v["recommendation"])}
           for d, v in sorted(w["dcs"].items(), key=lambda kv: dc_sort(kv[0])) if v["status_class"] != "RESOLVED" and v["phase"] == ph]
    held = [{"id": h, "title": clip(w["held"][h]["title"], 160), "answer_form": clip(w["held"][h]["answer_form"], 200)} for h in open_holds(w, ph)]
    return {"phase": ph, "modules": capped(mods, 60), "open_dcs": capped(dcs), "held_open": capped(held),
            "atlas": f"design/DEPLOYMENT_ATLAS.md §2 row {ph}; §9 row {ph}"}


def highway_dc(a, w: dict, did: str) -> dict:
    v = w["dcs"].get(did)
    if v is None:
        raise Refusal("not_found", f"{did} not in the DC register (`hee4db q 'SELECT id, status_class FROM design_conflicts'`)")
    rows, _ = readiness_rows(w, rs_count(ROOTS["repo"]))
    rmap = {x["module"]: x for x in rows}
    mods = [{"module": mname, "phases": rmap[mname]["phases"], "build": rmap[mname]["build"], "card": next(x["card"] for x in w["modules"] if x["name"] == mname),
             "phase_in_module": v["phase"] in rmap[mname]["phases"]} for mname in w["modules_of_dc"].get(did, [])]
    held = [{"id": h, "title": clip(w["held"][h]["title"], 160)} for h in (open_holds(w, v["phase"]) if v["phase"] else [])]
    return {"id": did, "title": v["title"], "phase": v["phase"], "status_class": v["status_class"], "scope": v["scope"],
            "modules_cell": v["modules"], "cites_um": bool(v["cites_um"]), "recommendation": clip(v["recommendation"], 1200),
            "register": f"{DESIGN_DIR}/{DESIGN_INDEX_NOTE}.md line {v['line']}", "modules": capped(mods), "held_open_at_phase": capped(held)}


JEV_FIT_NOTE = "50 Jev/Jev Fit Map"
JEV_LIST_CAP = 60                                     # rows in a `highway --jev` answer (51 on 2026-10-01)


def highway_jev(a, grade: str | None) -> dict:
    """Every Jev fit (or one grade), bounded: id, grade, allowed_now, gates, phases, modules, decision."""
    con = ro_connect(a.db)
    try:
        q = "SELECT id, section, grade, allowed_now, gates, phases, modules, decision, source_line FROM jev_fits"
        rows = [dict(zip(("id", "section", "grade", "allowed_now", "gates", "phases", "modules", "decision", "line"), r, strict=True))
                for r in con.execute(q + (" WHERE grade = ?" if grade else "") + " ORDER BY source_line", (grade,) if grade else ())]
        tally = dict(con.execute("SELECT grade, count(*) FROM jev_fits GROUP BY grade").fetchall())
        mapped = con.execute("SELECT count(DISTINCT fit_id) FROM jev_fit_modules").fetchone()[0]
    finally:
        con.close()
    if not tally:
        raise Refusal("unmeasured_empty_world", "jev_fits=0; run `hee4db ingest`", EXIT_UNMEASURED)
    for r in rows:
        r["decision"] = clip(r["decision"], 140)
    return {"grade": grade or "all", "fits": capped(rows, JEV_LIST_CAP), "tally": {g: tally.get(g, 0) for g in JEV_GRADES},
            "module_mapped": mapped, "home": f"vault {JEV_FIT_NOTE} §3",
            "recipes": ["hee4db recipe jev-fits-now", "hee4db recipe jev-held"]}


def verb_highway(a, o: Out) -> int:
    w = load_world(a.db)
    if a.phase_table:
        rows = phase_table(w)
        if a.md:
            sys.stdout.write(phase_table_md(rows))
            sys.stderr.write(f"hee4db highway verdict=PASS exit=0 measured={len(rows)}/{len(rows)} mode=phase-table\n")
            return EXIT_OK
        o.doc["rows"] = rows
        return o.emit(EXIT_OK, f"{len(rows)}/{len(rows)}", "mode=phase-table")
    if a.um_amendments:
        rows = um_amendments(w)
        if a.md:
            sys.stdout.write(um_amendments_md(rows))
            sys.stderr.write(f"hee4db highway verdict=PASS exit=0 measured={len(rows)}/{len(rows)} mode=um-amendments rule='open DC citing {' or '.join(UM_CITE_MARKS)}'\n")
            return EXIT_OK
        o.doc["rows"] = rows
        o.doc["rule"] = f"open DC rows (status != RESOLVED) whose Conflict or Status text cites {' or '.join(repr(x) for x in UM_CITE_MARKS)}"
        return o.emit(EXIT_OK, f"{len(rows)}/{len(rows)}", "mode=um-amendments")
    if a.grade and not a.jev:
        raise Refusal("usage_highway", "--grade needs --jev", EXIT_USAGE)
    if a.jev:
        doc, mode = highway_jev(a, a.grade), f"jev grade={a.grade or 'all'}"
    elif a.phase:
        doc, mode = highway_phase(a, w, a.phase), f"phase={a.phase}"
    elif a.dc:
        doc, mode = highway_dc(a, w, a.dc), f"dc={a.dc}"
    elif a.module:
        doc, mode = highway_module(a, w, a.module), f"module={a.module}"
    else:
        raise Refusal("usage_highway", "highway <module> | --phase Pn | --dc DC-nn | --jev [--grade A|B|C|X] | --phase-table [--md] | --um-amendments [--md]", EXIT_USAGE)
    _, bc = caps(a)
    n = len(json.dumps(doc, ensure_ascii=False, default=str).encode())
    if n > bc:
        raise Refusal("refused_byte_cap", f"highway bytes={n} cap={bc}; pass --bytes (max {BYTE_CAP_MAX})")
    o.doc["highway"] = doc
    return o.emit(EXIT_OK, "1/1", f"{mode} bytes={n}")


def alignment_checks(db: Path, add) -> None:
    """The five alignment checks of `hee4db check` (rev 2026-10-01 alignment)."""
    try:
        w = load_world(db)
    except Refusal as r:
        for nm in ("alignment_atlas", "alignment_um", "funnel_links", "funnel_phases", "readiness_note"):
            add(nm, EXIT_UNMEASURED if r.code == EXIT_UNMEASURED else EXIT_REFUSED, f"measured=0/0 {r.diag} {r.detail[:160]}")
        return
    # alignment_atlas: ATLAS §9 rows == the register's open rows by phase
    try:
        want = {r["phase"]: r for r in phase_table(w)}
        got = atlas_section9(read_text(ROOTS["evidence"] / "design/DEPLOYMENT_ATLAS.md"))
        if got is None:
            add("alignment_atlas", EXIT_REFUSED, f"measured=0/{len(want)} alignment_atlas_no_section9 (no '## 9 ·' table | Phase | Open DC ids | Modules affected |)")
        else:
            gm = {r["phase"]: r for r in got}
            bad = [f"alignment_atlas_ids phase={p} atlas={','.join(gm[p]['dc_ids']) if p in gm else 'ABSENT'} register={','.join(want[p]['dc_ids'])}"
                   for p in want if p not in gm or gm[p]["dc_ids"] != want[p]["dc_ids"]]
            bad += [f"alignment_atlas_modules phase={p} atlas={','.join(gm[p]['modules'])} register={','.join(want[p]['modules'])}"
                    for p in want if p in gm and gm[p]["dc_ids"] == want[p]["dc_ids"] and gm[p]["modules"] != want[p]["modules"]]
            bad += [f"alignment_atlas_extra_row phase={p}" for p in gm if p not in want]
            n_open = sum(len(r["dc_ids"]) for r in want.values())
            add("alignment_atlas", EXIT_OK if not bad else EXIT_REFUSED,
                f"measured={len(want) - len([b for b in bad if 'extra_row' not in b])}/{len(want)} phases open_dcs={n_open}" + "".join(" " + b for b in bad[:6]))
    except (Refusal, OSError) as e:
        add("alignment_atlas", EXIT_REFUSED, f"error={e}")
    # alignment_um: ULTRAMAP §7 marked list == open rows citing UM (one rule: UM_CITE_MARKS)
    try:
        want_ids = [r["id"] for r in um_amendments(w)]
        got_ids = um_marked_ids(read_text(ROOTS["evidence"] / "design/ULTRAMAP.md"))
        if got_ids is None:
            add("alignment_um", EXIT_REFUSED, f"measured=0/{len(want_ids)} alignment_um_unmarked (no {UM_BEGIN} … {UM_END} block in ULTRAMAP §7)")
        else:
            miss, extra = sorted(set(want_ids) - set(got_ids), key=dc_sort), sorted(set(got_ids) - set(want_ids), key=dc_sort)
            dup = len(got_ids) != len(set(got_ids))
            ok = not miss and not extra and not dup
            add("alignment_um", EXIT_OK if ok else EXIT_REFUSED,
                f"measured={len(set(want_ids) & set(got_ids))}/{len(want_ids)} rule=open_dc_citing_UM§_or_UM-P"
                + (f" alignment_um_missing={','.join(miss)}" if miss else "") + (f" alignment_um_extra={','.join(extra)}" if extra else "")
                + (" alignment_um_duplicate" if dup else ""))
    except (Refusal, OSError) as e:
        add("alignment_um", EXIT_REFUSED, f"error={e}")
    # funnel_links: card → design heading, design section → card
    try:
        rep = funnel_links_report(w)
        n = rep["modules"]
        add("funnel_links", EXIT_UNMEASURED if n == 0 else (EXIT_OK if not rep["bad"] else EXIT_REFUSED),
            f"measured={min(rep['card_links_resolved'], rep['sections_ok'])}/{n} card_links_resolved={rep['card_links_resolved']}/{n} "
            f"sections_with_own_card={rep['sections_ok']}/{n}" + "".join(" " + b for b in rep["bad"][:6]))
    except (Refusal, OSError) as e:
        add("funnel_links", EXIT_REFUSED, f"error={e}")
    # funnel_phases: card §3 phase rows == MODULES.toml phases
    try:
        rep = funnel_phases_report(w)
        add("funnel_phases", EXIT_UNMEASURED if rep["modules"] == 0 else (EXIT_OK if not rep["bad"] else EXIT_REFUSED),
            f"measured={rep['ok']}/{rep['modules']}" + "".join(" " + b for b in rep["bad"][:6]))
    except (Refusal, OSError) as e:
        add("funnel_phases", EXIT_REFUSED, f"error={e}")
    # readiness_note: the vault note == `readiness --md`
    try:
        rows, s = readiness_rows(w, rs_count(ROOTS["repo"]))
        want_txt = readiness_md(rows, s, w)
        p = ROOTS["vault"] / READINESS_NOTE_REL
        if not p.exists():
            add("readiness_note", EXIT_REFUSED, f"measured=0/1 readiness_note_absent path={READINESS_NOTE_REL}")
        else:
            have = read_text(p)
            if have == want_txt:
                add("readiness_note", EXIT_OK, f"measured=1/1 modules={len(rows)} lines={want_txt.count(chr(10))}")
            else:
                hl, wl = have.splitlines(), want_txt.splitlines()
                k = next((i for i, (x, y) in enumerate(zip(hl, wl)) if x != y), min(len(hl), len(wl)))
                add("readiness_note", EXIT_REFUSED, f"measured=0/1 readiness_note_differs first_line={k + 1} note_lines={len(hl)} generated_lines={len(wl)} "
                    "(regenerate: hee4db readiness --md)")
    except (Refusal, OSError) as e:
        add("readiness_note", EXIT_REFUSED, f"error={e}")


def held_aliases(con: sqlite3.Connection) -> dict[str, str]:
    """alias → canonical H-id, read from the §5 row text '(alias H-10b; canonical id H-10 …)'."""
    out = {}
    for hid, title, item in con.execute("SELECT id, title, item FROM held_items"):
        txt = f"{title} {item}"
        k = txt.find("alias ")
        while k >= 0:
            tok = txt[k + 6:].split()[0].strip(";,.):") if txt[k + 6:].split() else ""
            if tok.startswith("H-") and tok != hid:
                out[tok] = hid
            k = txt.find("alias ", k + 6)
    return out


def held_checks(add) -> None:
    """`check=held` (rev 2026-10-05 watch-contradiction): an ATLAS §5 row whose Item cell parses as open while
    another cell of the same row carries `**CLOSED` has its status word where parse_held does not read it, so
    the DB keeps the item open (H-18 on 2026-10-01; H-27 and H-29 on 2026-10-05). Read from the ATLAS text, not
    the DB: the DB row is the symptom, the misplaced word is the cause."""
    try:
        rows = list(held_table_rows(read_text(ROOTS["evidence"] / "design/DEPLOYMENT_ATLAS.md"), "evidence:design/DEPLOYMENT_ATLAS.md"))
        bad = [hid for _, cells, hm, hid, _, status in rows
               if status == "open" and any("**closed" in c.lower() for i, c in enumerate(cells) if i != hm["item"])]
        add("held", EXIT_OK if not bad else EXIT_REFUSED,
            f"measured={len(rows) - len(bad)}/{len(rows)} rows" + "".join(f" held_closed_word_misplaced id={h}" for h in bad))
    except (Refusal, OSError) as e:
        add("held", EXIT_REFUSED, f"error={e}")


def jev_checks(db: Path, add) -> None:
    """jev_grades, jev_scope, jev_gates (rev 2026-10-01 jev-fit). Each prints what it looked at."""
    try:
        con = ro_connect(db)
        try:
            fits = [dict(zip(("id", "grade", "allowed_now", "engine_data", "gates", "grade_reason"), r, strict=True)) for r in
                    con.execute("SELECT id, grade, allowed_now, engine_data, gates, grade_reason FROM jev_fits ORDER BY source_line")]
            held = {r[0]: r[1] for r in con.execute("SELECT id, status FROM held_items")}
            aliases = held_aliases(con)
        finally:
            con.close()
    except sqlite3.DatabaseError as e:
        for nm in ("jev_grades", "jev_scope", "jev_gates"):
            add(nm, EXIT_REFUSED, f"measured=0/0 error={e}")
        return
    if not fits:
        for nm in ("jev_grades", "jev_scope", "jev_gates"):
            add(nm, EXIT_UNMEASURED, "measured=0/0 unmeasured_empty_world jev_fits=0 (run `hee4db ingest`)")
        return
    # jev_grades: the fit map's §0 self-check line == the table's counts (read from the file it certifies)
    try:
        sc = jev_selfcheck(read_text(ROOTS["vault"] / f"{JEV_FIT_NOTE}.md"))
        got = {g: sum(f["grade"] == g for f in fits) for g in JEV_GRADES}
        if sc is None:
            add("jev_grades", EXIT_REFUSED, f"measured=0/5 jev_grades_no_selfcheck (no '{JEV_SELFCHECK_PREFIX}… intersections=N A= B= C= X=' line)")
        else:
            want = {"intersections": sc.get("intersections"), **{g: sc.get(g) for g in JEV_GRADES}}
            have = {"intersections": str(len(fits)), **{g: str(got[g]) for g in JEV_GRADES}}
            bad = [f"jev_grades_mismatch key={k} selfcheck={want[k]} table={have[k]}" for k in want if want[k] != have[k]]
            add("jev_grades", EXIT_OK if not bad else EXIT_REFUSED,
                f"measured={5 - len(bad)}/5 intersections={len(fits)} " + " ".join(f"{g}={got[g]}" for g in JEV_GRADES)
                + "".join(" " + b for b in bad))
    except (Refusal, OSError) as e:
        add("jev_grades", EXIT_REFUSED, f"error={e}")
    # jev_scope: with the grant absent (H-8 open), no A/B row with engine data is allowed now or ungated;
    # an A row is allowed now and sends no engine data; every X row names its reason
    grant_absent = held.get("H-8") == "open"
    bad = []
    ab = [f for f in fits if f["grade"] in ("A", "B")]
    for f in ab:
        gates = f["gates"].split(",") if f["gates"] else []
        if f["engine_data"] and grant_absent and (f["allowed_now"] != "no" or not ({"H-8", "H-10a"} & set(gates))):
            bad.append(f"jev_scope_engine_data_allowed id={f['id']} grade={f['grade']} allowed_now={f['allowed_now']} gates={f['gates'] or '-'}")
        if f["grade"] == "A" and (f["allowed_now"] != "yes" or f["engine_data"]):
            bad.append(f"jev_scope_a_not_now id={f['id']} allowed_now={f['allowed_now']} engine_data={f['engine_data']}")
    xs = [f for f in fits if f["grade"] == "X"]
    bad += [f"jev_scope_x_no_reason id={f['id']}" for f in xs if not f["grade_reason"].strip()]
    n_eng = sum(f["engine_data"] for f in ab)
    add("jev_scope", EXIT_OK if not bad else EXIT_REFUSED,
        f"measured={len(ab) + len(xs) - len(bad)}/{len(ab) + len(xs)} ab_rows={len(ab)} ab_engine_data={n_eng} x_rows={len(xs)} "
        f"grant={'absent(H-8 open)' if grant_absent else 'present'}" + "".join(" " + b for b in bad[:6]))
    # jev_gates: every gate a B row cites exists in ATLAS §5 (aliases resolved by the §5 row's own text); every B row names one
    cited = sorted({g for f in fits if f["grade"] == "B" for g in (f["gates"].split(",") if f["gates"] else [])}, key=held_sort)
    bad = [f"jev_gates_absent gate={g}" for g in cited if aliases.get(g, g) not in held]
    bad += [f"jev_gates_b_ungated id={f['id']}" for f in fits if f["grade"] == "B" and not f["gates"]]
    used = sorted({f"{g}->{aliases[g]}" for g in cited if g in aliases})
    add("jev_gates", EXIT_UNMEASURED if not cited else (EXIT_OK if not bad else EXIT_REFUSED),
        f"measured={len(cited) - sum(b.startswith('jev_gates_absent') for b in bad)}/{len(cited)} gates={','.join(cited) or '-'}"
        + (f" aliases={','.join(used)}" if used else "") + "".join(" " + b for b in bad[:6]))


