def clip(s: str | None, n: int = TEXT_CAP) -> str:
    s = s or ""
    return s if len(s) <= n else s[:n] + "…"


def capped(xs: list, n: int = HIGHWAY_LIST_CAP) -> dict:
    return {"total": len(xs), "rows": xs[:n], "truncated": len(xs) > n}


def name_marks(m: dict) -> list[str]:
    # [:3] are the backticked spellings (the system-map rule); the rest are prose spellings for decisions and V-reports
    return [f"`{m['name']}`", f"`{m['crate']}/{m['name']}`", f"`{m['crate']}::{m['name']}`", f"card {m['name']}",
            f"{m['crate']}/{m['name']}", f"{m['cluster']} {m['name']}", f"crate::{m['name']}"]


