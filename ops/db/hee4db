def verb_record_claim(a, o: Out) -> int:
    need_db(a.db)
    if not (a.who and a.claim and a.evidence):
        raise Refusal("usage_record_claim", "--who, --claim and --evidence are required", EXIT_USAGE)
    with Writer(a.db) as con:
        cur = con.execute("INSERT INTO claims(who, claim, evidence, status, created_at, updated_at) VALUES(?,?,?,'open',?,?)",
                          (a.who, a.claim, a.evidence, now_utc(), now_utc()))
        cid = cur.lastrowid
    check_readback(a.db, py_counts(a.db, ["claims"]), o)
    o.doc["id"] = cid
    return o.emit(EXIT_OK, "1/1", f"claim_id={cid}")


def verb_record_verify(a, o: Out) -> int:
    need_db(a.db)
    if not (a.id and a.by and a.status and a.result):
        raise Refusal("usage_record_verify", "--id, --by, --status and --result are required", EXIT_USAGE)
    with Writer(a.db) as con:
        r = con.execute("SELECT who FROM claims WHERE id=?", (a.id,)).fetchone()
        if not r:
            raise Refusal("not_found", f"claim {a.id}")
        if r[0] == a.by:
            raise Refusal("refused_self_verify", f"claim {a.id} was made by {a.by}; the executor cannot verify its own claim")
        con.execute("UPDATE claims SET verified_by=?, status=?, result=?, updated_at=? WHERE id=?",
                    (a.by, a.status, a.result, now_utc(), a.id))
    return o.emit(EXIT_OK, "1/1")


