      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(/usr/bin/grep:*)",
      "Bash(/usr/bin/find:*)",
      "Bash(/usr/bin/ls:*)",
      "Bash(/usr/bin/wc:*)",
      "Bash(/usr/bin/sha256sum:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(just gate:*)",
      "Bash(just verify)",
      "Bash(tools/doctor:*)",
      "Bash(tools/gate:*)",
      "Bash(python3 ops/checks/module_funnel.py:*)",
      "Bash(python3 ops/checks/cite_pins.py status)",
      "Bash(hee4db highway:*)",
      "Bash(hee4db q:*)",
      "Bash(hee4db get:*)",
      "Bash(fm-db status)",
      "Bash(fm-db q:*)",
      "Bash(fm-db record claim:*)",
      "Bash(deep-diff-forge:*)",
      "Bash(/usr/bin/head:*)",
      "Bash(/usr/bin/tail:*)",
      "Bash(/usr/bin/cat:*)",
      "Bash(/usr/bin/sed -n:*)",
      "Bash(/usr/bin/sort:*)",
      "Bash(/usr/bin/uniq:*)",
      "Bash(/usr/bin/cut:*)",
      "Bash(/usr/bin/awk:*)",
      "Bash(/usr/bin/diff:*)",
      "Bash(/usr/bin/file:*)",
      "Bash(/usr/bin/stat:*)",
      "Bash(git worktree list)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)"
    ],
    "deny": [
      "Edit(//var/home/herdr-engineering-engine-v3/**)",
      "Edit(//run/host/var/home/herdr-engineering-engine-v3/**)",
      "Edit(//var/home/Louranicas/hee3-evidence/**)",
      "Edit(//var/home/Louranicas/.cache/hee3-worktrees/**)",
      "Edit(//var/home/Louranicas/.cache/hee3-implementation/**)",
      "Edit(//var/home/Louranicas/.local/lib/herdr-engineering-engine-v3/**)",
      "Edit(//mnt/storage-10tb/herdr-engineering-engine-v3-t3-backups/**)",
      "Edit(//mnt/storage-10tb/HEE-v3-SECOND-COPY/**)",
      "Edit(//mnt/storage-10tb/hee3-backup/**)",
      "Edit(//mnt/storage-10tb/fedora-obsidian-vaults/herdr-engineering-engine-v3.vault/**)",
      "Edit(~/hee3-evidence/**)",
      "Edit(~/.cache/hee3-worktrees/**)",
      "Edit(~/.cache/hee3-implementation/**)",
      "Edit(~/.local/lib/herdr-engineering-engine-v3/**)",
      "Bash(hee3-gate:*)",
      "Bash(hee3-recapture:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/hee4-session-start.sh\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-doctor.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/brain-inject.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/hee4-regen-nudge.sh\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/brain-auto-index.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/hee4-v3-guard.sh\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
