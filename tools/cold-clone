#!/usr/bin/env python3
"""cold-clone [--sha REV] [--origin DIR] [--tier commit] [--repo DIR] [--gate PATH] [--warm-root DIR] [--target-dir DIR]

Proves a sha gates the same on a fresh clone of the LOCAL bare mirror as it did warm
(REQUIREMENTS rank 5). Clones <origin> (--no-hardlinks) into a temp dir under ~/.cache, checks out
the sha, runs `<gate> <tier> --repo <clone> --subject <sha> --target-dir <target>` there relaying
its stdout unchanged, loads the cold run's summary.json (the gate prints summary=<path>) and
matches it against the newest warm run `<warm-root>/*-<sha12>/summary.json` of the same subject
whose tier is <tier> or a tier that includes it in the sha's gate.toml (cut-check's warm run is
`gate cut`, which includes commit): matched = cold steps whose (name, ok) equals the warm step of
that name. Prints
  gate=<path> registry=host_cache   (method limits: the gate runner is the invoking tree's; cargo's
                                     registry is the host's ~/.cargo until tools/offline-bundle.lock exists)
and last
  cold-clone sha=<sha12> origin=<path> tier=<t> steps=N matched=N verdict=PASS|FAIL|UNMEASURED
PASS (0) iff the cold gate passed and matched == steps; FAIL (1) otherwise; UNMEASURED (3) with
matched=UNMEASURED(no warm run at <sha12>) when no warm run exists; refused (2) when the sha is
not in the origin (`just mirror` first) or the gate itself refused. The clone is removed in a
finally; the target dir is kept so the second cold run is warm. The cut tier is refused: it needs
the live unit, forbidden in a clone. Never GitHub, never the network.
A cold run's own summary dir gets a `cold-clone` marker file and is never read back as the warm
reference, so a second cold run without a warm run stays UNMEASURED (prints cold=<path>).
Crash-safe: before the gate starts, an intent `<warm-root>/.cold-intents/<sha12>.<pid>.<ns>` holding
the start time is written; it is removed only after the marker is on disk (the marker is written the
moment the summary= line arrives). An intent left by a killed run makes every summary at that sha
stamped in [start-1s, start+INTENT_WINDOW_S] untrusted, so the unmarked cold summary it may have left
is never the warm reference (a warm run in that window is UNMEASURED too: never a false PASS).
"""
import argparse, calendar, glob, json, os, re, shutil, subprocess, sys, tempfile, time, tomllib

def die(msg, code=2):
    print(f"cold-clone: {msg}", file=sys.stderr)
    sys.exit(code)

def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    return r.returncode, r.stdout.strip(), r.stderr.strip()

def resolve(repo, rev):
    rc, out, _ = git(repo, "rev-parse", "--verify", "--quiet", rev + "^{commit}")
    return out if rc == 0 and out else None

COLD_MARK = "cold-clone"  # written beside a cold run's summary.json: a cold run is never a warm reference
INTENTS = ".cold-intents"  # under the warm root; a dot name, so no `*-<sha12>` glob reads it
INTENT_WINDOW_S = 300  # the gate stamps its summary dir at its own start, seconds after the intent

def write_intent(root, sha):
    d = os.path.join(root, INTENTS)
    os.makedirs(d, exist_ok=True)
    t0 = time.time()
    path = os.path.join(d, f"{sha[:12]}.{os.getpid()}.{time.time_ns()}")
    with open(path, "x") as f:
        f.write(f"{sha} {t0}\n")
        f.flush()
        os.fsync(f.fileno())
    return path

def intent_windows(root, sha):
    """[(lo, hi)] epoch windows of every intent at sha (a live or a killed cold run); unreadable counts as now."""
    out = []
    for p in glob.glob(os.path.join(root, INTENTS, f"{sha[:12]}.*")):
        try:
            with open(p) as f:
                t0 = float(f.read().split()[1])
        except (OSError, ValueError, IndexError):
            t0 = time.time()
        out.append((t0 - 1, t0 + INTENT_WINDOW_S))
    return out

def dir_stamp(path):
    m = re.match(r"(\d{8}T\d{6}Z)(?:\.\d+)?-", os.path.basename(path))
    return calendar.timegm(time.strptime(m.group(1), "%Y%m%dT%H%M%SZ")) if m else None

def covering_tiers(origin, sha, tier):
    """<tier> and every tier of the sha's gate.toml whose `includes` chain reaches it (the gate ran its steps)."""
    r = subprocess.run(["git", "-C", origin, "show", f"{sha}:gate.toml"], capture_output=True)
    try:
        tiers = tomllib.loads(r.stdout.decode()).get("tier", {}) if r.returncode == 0 else {}
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        tiers = {}
    if not isinstance(tiers, dict):
        tiers = {}
    out = {tier}
    for t in tiers:
        seen, cur = set(), t
        while isinstance(cur, str) and cur not in seen:
            if cur == tier:
                out.add(t)
                break
            seen.add(cur)
            cur = tiers.get(cur, {}).get("includes") if isinstance(tiers.get(cur), dict) else None
    return out

def warm_summary(root, sha, tiers):
    """The newest `<root>/*-<sha12>/summary.json` by stamp whose tier is in <tiers> and subject is sha, never a cold run's."""
    windows = intent_windows(root, sha)
    for p in sorted(glob.glob(os.path.join(root, f"*-{sha[:12]}", "summary.json")), reverse=True):
        if os.path.exists(os.path.join(os.path.dirname(p), COLD_MARK)):
            continue
        st = dir_stamp(os.path.dirname(p))
        if st is None or any(lo <= st <= hi for lo, hi in windows):
            continue
        try:
            with open(p) as f:
                s = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(s, dict) and isinstance(s.get("tier"), str) and s["tier"] in tiers and s.get("subject") == sha:
            return p, s
    return None, None

def main():
    here = os.path.dirname(os.path.abspath(__file__))
    ap = argparse.ArgumentParser(prog="cold-clone", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--sha", default="HEAD", help="rev to gate cold (resolved in --repo, then checked in --origin)")
    ap.add_argument("--origin", default="/mnt/storage-10tb/hee4-origin.git", help="the local bare mirror (`just mirror` fills it)")
    ap.add_argument("--tier", default="commit")
    ap.add_argument("--repo", default=os.getcwd())
    ap.add_argument("--gate", default=os.path.join(here, "gate"))
    ap.add_argument("--warm-root", default=os.path.expanduser("~/.cache/hee4-gate"))
    ap.add_argument("--target-dir", help="CARGO_TARGET_DIR for the cold gate (default ~/.cache/hee4-cold-target/<sha12>; kept)")
    a = ap.parse_args()
    if a.tier == "cut":
        die("the cut tier needs the live unit; it is forbidden in a clone")
    if not os.path.isdir(a.origin):
        die(f"origin {a.origin} is not a directory")
    sha = resolve(a.repo, a.sha) or a.sha
    if not resolve(a.origin, sha):
        die(f"sha {a.sha} not in {a.origin} (just mirror first)")
    sha = resolve(a.origin, sha)
    target = os.path.abspath(os.path.expanduser(a.target_dir or f"~/.cache/hee4-cold-target/{sha[:12]}"))
    os.makedirs(target, exist_ok=True)
    print(f"gate={os.path.abspath(a.gate)}")
    print("registry=host_cache")
    warm_root = os.path.expanduser(a.warm_root)
    cache = os.path.expanduser("~/.cache")
    os.makedirs(cache, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix="hee4-cold-", dir=cache)
    try:
        r = subprocess.run(["git", "clone", "-q", "--no-hardlinks", a.origin, tmp], capture_output=True, text=True)
        if r.returncode:
            die(f"clone of {a.origin} failed: {r.stderr.strip()}")
        rc, _, err = git(tmp, "checkout", "-q", sha)
        if rc:
            die(f"checkout {sha[:12]} failed: {err}")
        env = dict(os.environ, PYTHONUNBUFFERED="1")  # relay the gate's lines as they happen
        intent = write_intent(warm_root, sha)
        p = subprocess.Popen([a.gate, a.tier, "--repo", tmp, "--subject", sha, "--target-dir", target],
                             cwd=tmp, env=env, stdout=subprocess.PIPE, text=True)
        summary_path = None
        for line in p.stdout:
            m = re.fullmatch(r"summary=(\S+)\n?", line)
            if m and summary_path is None:
                summary_path = m.group(1)
                with open(os.path.join(os.path.dirname(summary_path), COLD_MARK), "w") as f:
                    f.write(f"cold run of {sha} cloned from {a.origin}\n")
                    f.flush()
                    os.fsync(f.fileno())
                os.unlink(intent)  # the marker now says cold; the intent's window is no longer needed
            sys.stdout.write(line)
            sys.stdout.flush()
        gate_rc = p.wait()
        if summary_path is None:  # the intent stays: the gate may have written a summary it never printed
            die(f"gate exited {gate_rc} without a summary= line", 2 if gate_rc == 2 else 1)
        with open(summary_path) as f:
            cold = json.load(f)
        print(f"cold={summary_path}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    steps = cold.get("steps", [])
    head = f"cold-clone sha={sha[:12]} origin={a.origin} tier={a.tier} steps={len(steps)}"
    warm_path, warm = warm_summary(warm_root, sha, covering_tiers(a.origin, sha, a.tier))
    if warm is None:
        print(f"{head} matched=UNMEASURED(no warm run at {sha[:12]}) verdict=UNMEASURED")
        sys.exit(3)
    by_name = {s.get("name"): s for s in warm.get("steps", [])}
    matched = sum(1 for s in steps if s.get("name") in by_name and by_name[s["name"]].get("ok") == s.get("ok"))
    print(f"warm={warm_path}")
    v = "PASS" if cold.get("verdict") == "PASS" and matched == len(steps) else "FAIL"
    print(f"{head} matched={matched} verdict={v}")
    sys.exit(0 if v == "PASS" else 1)

if __name__ == "__main__":
    main()
