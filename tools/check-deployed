            if n in skip:
                print(f"control {n} plant=skipped line={line or 'MISSING'}")
                continue
            hit = diag in line and not line.endswith(" PASS")
            if n == "D1" and hit:  # the PATH stub reports the tree; the row must have asked the unit's binary instead
                kv = dict(t.split("=", 1) for t in line.split() if "=" in t)
                hit = kv.get("binary", "") != kv.get("head", "?") and kv.get("binary", "") not in ("", "mismatch")
            met += hit
            print(f"control {n} plant={what!r} detected={'yes' if hit else 'no'} line={line or 'MISSING'}")
        v = "PASS" if met == len(ROWS) else "FAIL"
        print(f"check-deployed control cases={met}/{len(ROWS)} verdict={v}")
        sys.exit(0 if v == "PASS" else 1)
    finally:
