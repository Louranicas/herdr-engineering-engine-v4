#!/usr/bin/env python3
"""check-deployed [--unit hee4.service] [--repo DIR] [--drive-cmd CMD] [--control [--control-skip D<n>]] ...

The deployed read-back (ATLAS D1-D9, the v4 readings): nine rows, each read live from the unit
(`systemctl show` key=value), the socket (`/proc/net/unix` + `/proc/<MainPID>/fd`), the ledger
(Python sqlite3, `file:<path>?mode=ro`, PRAGMA and read-only SELECTs) and the tree. Each row prints
  D<n> key=value ... PASS|FAIL|UNMEASURED
and the last line is
  deployed=<PASS rows>/9 tree=<sha12> dirty=<git status --porcelain lines> verdict=PASS|FAIL|UNMEASURED
PASS only when all nine rows PASS and dirty=0 (exit 0); FAIL when any row FAILs (exit 1);
UNMEASURED when nothing FAILs and any row is UNMEASURED (exit 3). A field that could not be read
prints UNMEASURED(<reason>) by name; a row that looked at nothing is UNMEASURED and red.
Run order: D8 (the drive restarts the unit under --allow-restart) first, then D1..D7, D9; rows
print in D1..D9 order. No value comes from a receipt, a plan row, a source file or an earlier run.

Every `--version` and `health` read-back runs the unit's own binary (ExecStart argv[0], and
/proc/<MainPID>/exe for the running copy), never whatever `hee4` is first on PATH.

--control: a disposable HOME under ~/.cache/hee4-host (never /tmp) with stub systemctl/loginctl/
hee4 on PATH, a real AF_UNIX listener held by a fake MainPID, a fake /api/ps, a synthetic ledger,
a stub drive and a rehearsal record; one fault planted per row, each asserted by its row's own
diagnostic text. Prints `check-deployed control cases=k/9 verdict=PASS|FAIL`. The control's
children die with it (PR_SET_PDEATHSIG) and a control start sweeps cd-control-* dirs whose pid is dead.
--control-skip D<n> (test only) removes that one plant: the control must then print cases=8/9.
"""
import argparse, ctypes, hashlib, importlib.machinery, importlib.util, http.server, json, os, shlex, shutil, signal, socket, sqlite3, stat, subprocess, sys, tempfile, threading, time, uuid

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
ROWS = ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9"]
V3_PATTERNS = ["/var/home/herdr-engineering-engine-v3", "/run/host/var/home", "hee3-evidence", "hee3-worktrees",
               "hee3-implementation", "/lib/herdr-engineering-engine-v3"]  # .claude/agents/hee4-watch-fence.md:94
V3_LIMIT = "over-counts a literal in a help string; under-counts an encoded path"
REPAIR_ENTRY_EVENTS = [{"settle": "not_ready"}, {"decide": "fail"}]  # hee4_contracts::Event serde spelling, the two edges into repair_pending
HEALTH_TOKENS = ("ready=true", "recovery=complete", "database=ready", "socket=owned")


def sh(*cmd, timeout=60, env=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, "", str(e)


class Row:
    """One D row: fields in order, the verdict from what was measured."""
    def __init__(self, name):
        self.name, self.parts, self.failed, self.unmeasured = name, [], False, False

    def val(self, key, value):
        self.parts.append(f"{key}={value}")

    def check(self, key, value, ok):
        self.parts.append(f"{key}={value}")
        if not ok:
            self.failed = True

    def unm(self, key, why):
        self.parts.append(f"{key}=UNMEASURED({why})")
        self.unmeasured = True

    def verdict(self):
        return "FAIL" if self.failed else "UNMEASURED" if self.unmeasured or not self.parts else "PASS"

    def line(self):
        return f"{self.name} {' '.join(self.parts)} {self.verdict()}"


# ---- read-backs: every one is a parse, never a regex over a declaration ----

def show(unit, *keys):
    rc, out, err = sh("systemctl", "--user", "show", "-p", ",".join(keys), unit)
    return rc, dict(l.split("=", 1) for l in out.splitlines() if "=" in l), err


def parse_execstart(value):
    """`{ path=P ; argv[]=A B C ; ... }` -> {bin, socket, ledger, work} from the argv[] member."""
    body = value.strip()
    if body.startswith("{") and body.endswith("}"):
        body = body[1:-1]
    members = dict(m.strip().split("=", 1) for m in body.split(" ; ") if "=" in m)
    argv = shlex.split(members.get("argv[]", ""))
    out = {"bin": argv[0] if argv else ""}
    for i, tok in enumerate(argv):
        if tok in ("--socket", "--ledger", "--work") and i + 1 < len(argv):
            out[tok[2:]] = argv[i + 1]
    return out


def parse_environment(value):
    return dict(kv.split("=", 1) for kv in value.split() if "=" in kv)


def parse_version(out):
    """`hee4 <version> <sha> [catalogue=<12hex>]` -> {version, head (sha12), catalogue}, or None when the
    line is not that shape. The sha is the token after the version, never the last token: since the
    catalogue landed the last token is `catalogue=<12hex>` (old lines end at the sha)."""
    toks = out.split()
    if len(toks) < 3 or toks[0] != "hee4":
        return None
    head = toks[2]
    if len(head) < 12 or any(c not in "0123456789abcdef" for c in head):
        return None
    kv = dict(t.split("=", 1) for t in toks[3:] if "=" in t)
    return {"version": toks[1], "head": head[:12], "catalogue": kv.get("catalogue")}


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def ledger_ro(path):
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True)


def listener_inodes(proc, sock_path):
    """sockfs inodes bound to sock_path with the accept flag, parsed from <proc>/net/unix."""
    out = set()
    try:
        lines = open(os.path.join(proc, "net", "unix")).read().splitlines()[1:]
    except OSError:
        return None
    for line in lines:
        f = line.split()
        if len(f) >= 8 and f[7] == sock_path and int(f[3], 16) & 0x10000:
            out.add(f[6])
    return out


def fd_targets(proc, pid):
    d = os.path.join(proc, str(pid), "fd")
    out = set()
    try:
        for n in os.listdir(d):
            try:
                out.add(os.readlink(os.path.join(d, n)))
            except OSError:
                pass
    except OSError:
        return None
    return out


def health_cli(binp, sock_path):
    """`<bin> health --socket S` (the unit's own binary, never PATH) -> (rc, first line, parsed JSON reply or None)."""
    if not binp:
        return None, "no ExecStart argv[0]", None
    rc, out, err = sh(binp, "health", "--socket", sock_path, timeout=20)
    lines = out.splitlines()
    reply = None
    for l in lines[1:]:
        try:
            reply = json.loads(l)
            break
        except ValueError:
            continue
    return rc, lines[0] if lines else err, reply


def drive_task_ids(evidence_root):
    """Every body.task_id in a recv frame under <evidence-root>/*/*.jsonl (the drive's own ids)."""
    ids, files = set(), 0
    if not os.path.isdir(evidence_root):
        return ids, files
    for sub in os.listdir(evidence_root):
        d = os.path.join(evidence_root, sub)
        if not os.path.isdir(d):
            continue
        for name in os.listdir(d):
            if not name.endswith(".jsonl"):
                continue
            files += 1
            try:
                for line in open(os.path.join(d, name)):
                    try:
                        fr = json.loads(line)
                        if fr.get("dir") != "recv" or not fr.get("raw"):
                            continue
                        t = (json.loads(fr["raw"]).get("body") or {}).get("task_id")
                        if t:
                            ids.add(t)
                    except (ValueError, AttributeError):
                        continue
            except OSError:
                continue
    return ids, files


# ---- the nine rows ----

def feature_counts(feats):
    """(l2, reasoned, unexplained) over `drive feature=` lines; every line lands in exactly one bucket.
    PASS is l2, except a PASS marked out of release (`served=false`: tools.inspect says this
    binary does not serve it, and it was refused by release scope, as catalogued), which is a
    reasoned flow; UNMEASURED with `scope=unserved` or `reason=` is reasoned; everything else (a FAIL, with or without a reason or scope, an UNMEASURED with
    neither, an unknown verdict) is unexplained."""
    l2 = reasoned = unexplained = 0
    for line in feats:
        keys = {t.split("=", 1)[0]: t.split("=", 1)[1] for t in line.split() if "=" in t}
        v = keys.get("verdict")
        if v == "PASS" and keys.get("served") == "false":
            reasoned += 1
        elif v == "PASS":
            l2 += 1
        elif v == "UNMEASURED" and (keys.get("scope") == "unserved" or "reason" in keys):
            reasoned += 1
        else:
            unexplained += 1
    return l2, reasoned, unexplained


def d8(a, ctx):
    r = Row("D8")
    cmd = shlex.split(a.drive_cmd)
    rc, out, err = sh(*cmd, timeout=900)
    fdir = os.path.join(a.repo, "gates", "features")
    try:
        flows = len([f for f in os.listdir(fdir) if f.endswith(".md") and f != "README.md"])
        r.val("flows", flows)
    except OSError:
        r.unm("flows", f"no {fdir}")
    if rc is None:
        r.check("drive", f"not_run({err})", False)
        return r
    feats = [l for l in out.splitlines() if l.startswith("drive feature=")]
    l2, reasoned, unexplained = feature_counts(feats)
    last = out.splitlines()[-1] if out else ""
    kv = dict(t.split("=", 1) for t in last.split() if "=" in t) if last.startswith("drive verdict=") else {}
    r.val("drive_rc", rc)
    r.val("l2", l2)
    r.val("reasoned", reasoned)
    r.check("unexplained", unexplained, unexplained == 0)
    if not feats:
        r.check("feature_lines", 0, False)
    v = kv.get("verdict")
    if v is None:
        r.check("drive_verdict", "absent", False)
    else:
        r.check("drive_verdict", v, v != "FAIL")
    return r


def d1(a, ctx):
    r = Row("D1")
    pid, binp = ctx["pid"], ctx["bin"]
    exe_sha = bin_sha = None
    if not pid:
        r.unm("exe_sha", "no MainPID")
    else:
        try:
            exe_sha = sha256_file(os.path.join(a.proc, str(pid), "exe"))
            r.val("exe_sha", exe_sha[:16])
        except OSError as e:
            r.unm("exe_sha", f"{a.proc}/{pid}/exe unreadable: {e}")
    if not binp:
        r.unm("bin_sha", "no ExecStart argv[0]")
    else:
        try:
            bin_sha = sha256_file(binp)
            r.val("bin_sha", bin_sha[:16])
        except OSError as e:
            r.unm("bin_sha", f"{binp} unreadable: {e}")
    if exe_sha and bin_sha:
        r.check("identity", "match" if exe_sha == bin_sha else "mismatch", exe_sha == bin_sha)
    r.val("head", ctx["tree"])
    bh = None
    if not binp:
        r.unm("binary", "no ExecStart argv[0]")
    else:  # the unit's own binary answers, never the `hee4` first on PATH
        rc, out, err = sh(binp, "--version")
        bv = parse_version(out) if rc == 0 else None
        if bv is None:
            r.unm("binary", f"{binp} --version rc={rc} line={out!r} {err}")
        else:
            bh = bv["head"]
            r.check("binary", bh, bh == ctx["tree"])
            r.val("catalogue", bv["catalogue"] or "absent")
    if pid and exe_sha:  # the running copy's own head: must agree with argv[0]'s
        rc, out, err = sh(os.path.join(a.proc, str(pid), "exe"), "--version")
        ev = parse_version(out) if rc == 0 else None
        if ev is None:
            r.unm("exe_head", f"exe --version rc={rc} line={out!r} {err}")
        else:
            eh = ev["head"]
            r.check("exe_head", eh, bh is not None and eh == bh)
            if bh is not None and eh != bh:
                r.check("version_head", f"mismatch(binary={bh},exe={eh})", False)
    if binp and bin_sha:
        try:
            data = open(binp, "rb").read()
            r.val("v3_refs", f"{sum(data.count(p.encode()) for p in V3_PATTERNS)} (limit: {V3_LIMIT})")
        except OSError as e:
            r.unm("v3_refs", str(e))
    return r


def d2(a, ctx):
    r = Row("D2")
    unit = a.unit
    rc, out, _ = sh("systemctl", "--user", "is-enabled", unit)
    r.check("is_enabled", out or f"rc={rc}", out == "enabled")
    rc, out, _ = sh("systemctl", "--user", "is-active", unit)
    r.check("is_active", out or f"rc={rc}", out == "active")
    rc, out, _ = sh("loginctl", "show-user", "-p", "Linger", "--value", os.environ.get("USER", ""))
    if rc == 0 and out in ("yes", "no"):
        r.val("linger", out)
    else:
        r.unm("linger", f"loginctl rc={rc} out={out!r}")
    rc, p, err = show(unit, "MainPID", "ExecStart", "TimeoutStopUSec", "KillMode")
    if rc != 0:
        r.unm("show", f"systemctl show rc={rc} {err}")
    else:
        r.val("main_pid", p.get("MainPID", "?"))
        r.val("timeout_stop", p.get("TimeoutStopUSec", "?"))
        r.val("kill_mode", p.get("KillMode", "?"))
    pid = ctx["pid"]
    if not pid:
        r.unm("cgroup", "no MainPID")
    else:
        try:
            lines = [l for l in open(os.path.join(a.proc, str(pid), "cgroup")).read().splitlines() if l.strip()]
            last = lines[-1] if lines else ""
            r.check("cgroup", last.split(":", 2)[-1] if last else "empty", last.endswith(f"/{unit}"))
        except OSError as e:
            r.unm("cgroup", str(e))
    inst = os.path.expanduser(f"~/.config/systemd/user/{unit}")
    src = os.path.join(a.repo, "systemd", unit)
    try:
        si, ss = sha256_file(inst), sha256_file(src)
        r.check("unit_file", "installed==repo" if si == ss else f"installed={si[:12]} repo={ss[:12]}", si == ss)
    except OSError as e:
        r.unm("unit_file", str(e))
    return r


def d3(a, ctx):
    r = Row("D3")
    sp, pid = ctx["socket"], ctx["pid"]
    if not sp:
        r.unm("socket", "no --socket in ExecStart")
        return r
    try:
        sd, ss = os.stat(os.path.dirname(sp)), os.stat(sp)
    except OSError as e:
        r.check("socket", f"absent({e})", False)
        return r
    md, ms = stat.S_IMODE(sd.st_mode), stat.S_IMODE(ss.st_mode)
    r.check("dir", f"{md:o}", md == 0o700)
    r.check("sock", f"{ms:o}", ms == 0o600)
    r.check("uid_ok", ss.st_uid == os.getuid(), ss.st_uid == os.getuid())
    r.check("is_socket", stat.S_ISSOCK(ss.st_mode), stat.S_ISSOCK(ss.st_mode))
    inodes = listener_inodes(a.proc, sp)
    if inodes is None:
        r.unm("listener", f"{a.proc}/net/unix unreadable")
    elif not inodes:
        r.check("listener", "none_bound", False)
    elif not pid:
        r.unm("in_mainpid_fds", "no MainPID")
    else:
        fds = fd_targets(a.proc, pid)
        if fds is None:
            r.unm("in_mainpid_fds", f"{a.proc}/{pid}/fd unreadable")
        else:
            held = any(f"socket:[{i}]" in fds for i in inodes)
            r.check("in_mainpid_fds", "yes" if held else "no", held)
            r.val("main_pid", pid)
            if not held:
                holder = "none"
                for d in os.listdir(a.proc):
                    if d.isdigit() and d != str(pid):
                        t = fd_targets(a.proc, int(d)) or set()
                        if any(f"socket:[{i}]" in t for i in inodes):
                            holder = d
                            break
                r.val("held_by", holder)
    rc, first, _ = health_cli(ctx["bin"], sp)
    ok = rc == 0 and all(t in first for t in HEALTH_TOKENS)
    if rc is None:
        r.unm("health", f"{ctx['bin'] or 'no ExecStart argv[0]'}: {first}")
    else:
        r.check("health", first.split(" head=")[0] if ok else f"rc={rc} {first}", ok)
    return r


def d4(a, ctx):
    r = Row("D4")
    lp = ctx["ledger"]
    if not lp:
        r.unm("ledger", "no --ledger in ExecStart")
        return r
    try:
        md = stat.S_IMODE(os.stat(os.path.dirname(lp)).st_mode)
        ml = stat.S_IMODE(os.stat(lp).st_mode)
    except OSError as e:
        r.check("ledger", f"absent({e})", False)
        return r
    r.check("dir", f"{md:o}", md == 0o700)
    r.check("ledger_mode", f"{ml:o}" + ("" if ml == 0o600 else " want 600"), ml == 0o600)
    try:
        uv = ledger_ro(lp).execute("PRAGMA user_version").fetchone()[0]
        r.val("user_version", uv)
    except sqlite3.Error as e:
        uv = None
        r.check("user_version", f"unreadable({e})", False)
    rc, first, reply = health_cli(ctx["bin"], ctx["socket"] or "")
    body = (reply or {}).get("body") or {}
    if rc is None:
        r.unm("schema_version", f"{ctx['bin'] or 'no ExecStart argv[0]'}: {first}")
    elif "schema_version" not in body:
        r.unm("schema_version", "health body carries no schema_version yet; lands with task-family-actions")
    else:
        sv = body["schema_version"]
        r.val("schema_version", sv)
        r.check("schema", "match" if uv == sv else "mismatch", uv == sv)
    r.val("commission", "Store::open")
    return r


def manifest_objects(m):
    """(objects_n, objects_bound) from a ledger backup manifest (hee4-core backup.rs writes both); None where absent."""
    n, bound = m.get("objects_n"), m.get("objects_bound")
    ok = lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 0
    return (n if ok(n) else None), (bound if ok(bound) else None)


def habitat_tool():
    """tools/habitat-backup as a module: it owns the verdict contract and its parse (verdict_of, last_run)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "habitat-backup")
    loader = importlib.machinery.SourceFileLoader("habitat_backup", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("habitat_backup", loader))
    loader.exec_module(mod)
    return mod


def last_habitat_run(log):
    """The tool's own log, its last run block only: ({run line fields}, verdict or None); None when no run."""
    try:
        with open(log) as f:
            text = f.read()
    except OSError:
        return None
    return habitat_tool().last_run(text)


def habitat_agrees(verdict, result, status):
    """The unit's last ExecMainStatus is the code its last verdict line maps to, and Result says success
    exactly when that code is 0 or 10 (SuccessExitStatus=10). A disagreement is refused, never reconciled."""
    want = habitat_tool().EXIT.get(verdict, 30)
    return status == str(want) and (result == "success") == (want in (0, 10))


def d5(a, ctx):
    r = Row("D5")
    b = a.backups
    if not os.path.isdir(b):
        r.unm("backups", f"no backup dir at {b}")
        return r
    ids = [d for d in os.listdir(b) if os.path.isfile(os.path.join(b, d, "manifest.json"))]
    if not ids:
        r.check("manifest", "absent", False)
    else:
        newest = max(ids, key=lambda d: os.stat(os.path.join(b, d, "manifest.json")).st_mtime)
        mp = os.path.join(b, newest, "manifest.json")
        try:
            m = json.load(open(mp))
            r.val("newest", newest)
            n, bound = manifest_objects(m)
            r.check("objects", "absent" if n is None else n, n is not None and bound is not None and n <= bound)
            r.val("objects_bound", "absent" if bound is None else bound)
            r.val("age_s", int(time.time() - os.stat(mp).st_mtime))
        except (OSError, ValueError) as e:
            r.check("manifest", f"unparseable({e})", False)
    lg = os.path.join(b, "restore.log")
    try:
        lines = open(lg).read().splitlines()
        r.val("restore_log", lines[-1] if lines else "empty")
    except OSError:
        r.unm("restore_log", f"no {lg}")
    rc, out, _ = sh("systemctl", "--user", "is-enabled", "hee4-backup.timer")
    r.check("timer", out or f"rc={rc}", out == "enabled")
    rc, p, _ = show("hee4-backup.service", "Result", "ExecMainStatus", "ExecMainExitTimestamp", "InvocationID")
    r.val("last_run", f"{p.get('Result', '?')}/{p.get('ExecMainStatus', '?')}")
    # A unit that never ran reads Result=success ExecMainStatus=0 with an empty exit timestamp: not a run.
    ran = bool(p.get("ExecMainExitTimestamp")) and bool(p.get("InvocationID"))
    r.check("unit_ran", "yes" if ran else "never", ran)
    run = last_habitat_run(a.habitat_log)
    fields, hv = run if run else ({}, None)
    r.check("habitat_verdict", hv or "absent", hv == "PASS")
    # The log's last block must be this unit's last run, not a manual --service run or an older block.
    inv, unit_inv = fields.get("invocation", "none"), p.get("InvocationID", "")
    same_run = ran and inv == unit_inv
    r.check("habitat_run", "unit" if same_run else f"other(log={inv[:12]},unit={unit_inv[:12] or 'none'})", same_run)
    agree = habitat_agrees(hv, p.get("Result"), p.get("ExecMainStatus"))
    r.check("habitat_agree", "yes" if agree else f"no(verdict={hv or 'absent'},status={p.get('ExecMainStatus', '?')})", agree)
    try:
        same = os.stat(b).st_dev == os.stat(os.path.expanduser("~")).st_dev
        r.check("other_device", "no" if same else "yes", not same)
    except OSError as e:
        r.unm("other_device", str(e))
    if ids:
        root = os.path.expanduser("~/.cache/hee4-host")
        os.makedirs(root, exist_ok=True)
        into = tempfile.mkdtemp(prefix="cd-restore-", dir=root)
        rc, out, err = sh(ctx["bin"] or "hee4-absent", "restore", "--into", into, newest, timeout=600)
        shutil.rmtree(into, ignore_errors=True)
        if rc == 2 and "unknown verb" in err:
            r.unm("restore", "restore verb absent")
        elif rc is None:
            r.unm("restore", f"{ctx['bin'] or 'no ExecStart argv[0]'} not runnable: {err}")
        else:
            r.check("restore", (out.splitlines() or [f"rc={rc}"])[-1], rc == 0)
    return r


def d6(a, ctx):
    r = Row("D6")
    lp = ctx["ledger"]
    try:
        c = ledger_ro(lp)
        n = c.execute("select count(distinct t.id) from tasks t join observations o on o.task_id=t.id "
                      "where t.phase='accepted' and json_extract(o.json,'$.tool.name')='model-door'").fetchone()[0]
        r.check("accepted_with_model_door", n, n >= 1)
        legs = 0
        for (tid,) in c.execute("select id from tasks where phase='accepted'"):
            evs = [json.loads(e) for (e,) in c.execute("select event_json from events where task_id=? order by seq", (tid,))]
            if any(e in REPAIR_ENTRY_EVENTS for e in evs):
                legs += 1
        r.val("repair_leg", f"{legs} (B16 leg lands in app-runtime-budgets-attempts)" if legs == 0 else legs)
    except (sqlite3.Error, ValueError, TypeError) as e:
        r.check("ledger", f"unreadable({e})", False)
    model = a.model
    try:
        with urllib_open(a.model_url + "/api/ps") as resp:
            models = json.load(resp).get("models", [])
    except (OSError, ValueError) as e:
        r.check("model_endpoint", f"unreachable({e})", False)
        return r
    r.val("model", model or "none")
    if not model:
        r.unm("gpu", "no pinned model name")
        return r
    hit = [m for m in models if m.get("name") == model or m.get("model") == model]
    if not hit:
        r.unm("gpu", f"model {model} not resident (ollama unloads idle models)")
    else:
        vram = hit[0].get("size_vram", 0) or 0
        r.check("gpu", f"size_vram={vram}", vram > 0)
    return r


def urllib_open(url):
    import urllib.request
    return urllib.request.build_opener(urllib.request.ProxyHandler({})).open(url, timeout=5)


def rehearsal_path(a, tree):
    return os.path.join(a.drill_root, tree, "rehearsal.json")


def d7(a, ctx):
    r = Row("D7")
    p = rehearsal_path(a, ctx["tree"])
    try:
        rec = json.load(open(p))
    except (OSError, ValueError):
        r.unm("rehearsal", f"no rehearsal record at tree={ctx['tree']}; run tools/drill --submit N")
        return r
    steps = rec.get("steps") or []
    measured = sum(1 for s in steps if s.get("status") == "MEASURED")
    r.check("steps", f"{measured}/{len(steps)}", steps and measured == len(steps))
    sub = rec.get("submitted", 0)
    ap = str(rec.get("acked_present", ""))
    k, _, n = ap.partition("/")
    r.val("submitted", sub)
    if not isinstance(sub, int) or sub < 1:
        r.unm("acked_present", f"rehearsal submitted={sub}; run tools/drill --submit N")
    else:
        r.check("acked_present", ap, k.isdigit() and n.isdigit() and int(k) == int(n) == sub)
    r.val("task_ids", len(rec.get("task_ids") or []))
    return r


def d9(a, ctx):
    r = Row("D9")
    try:
        c = ledger_ro(ctx["ledger"])
        cols = [row[1] for row in c.execute("PRAGMA table_info(tasks)")]
        if "serve_cgroup" in cols:
            ids = {t for (t,) in c.execute("select id from tasks where phase='accepted' and serve_cgroup like ?", (f"%/{a.unit}",))}
            r.val("provenance", "serve_cgroup")
        else:
            ids = {t for (t,) in c.execute("select id from tasks where phase='accepted'")}
            r.val("provenance", "ledger_path")
    except sqlite3.Error as e:
        r.check("ledger", f"unreadable({e})", False)
        return r
    r.val("accepted", len(ids))
    reh, records = set(), 0  # every rehearsal record under the drill root: a drill task never counts as use, whatever tree it ran at
    for tree in (os.listdir(a.drill_root) if os.path.isdir(a.drill_root) else []):
        try:
            reh |= set(json.load(open(rehearsal_path(a, tree))).get("task_ids") or [])
            records += 1
        except (OSError, ValueError):
            continue
    drive, files = drive_task_ids(a.evidence_root)
    r.val("rehearsal_excluded", f"{len(ids & reh)} (from {records} records)")
    r.val("drive_excluded", f"{len(ids & drive)} (from {files} jsonl)")
    use = len(ids - reh - drive)
    r.check("use", use, use >= 1)
    return r


def tree_of(a):
    if a.tree:
        return a.tree[:12]
    h = os.environ.get("HEE4_HEAD", "").strip()
    if not h:
        rc, h, _ = sh("git", "-C", a.repo, "rev-parse", "HEAD")
        h = h if rc == 0 else ""
    return h[:12] if h else "unmeasured"


def run_rows(a):
    """The nine rows against the world the flags name; returns the row lines in D1..D9 order."""
    ctx = {"tree": tree_of(a), "pid": 0, "bin": a.bin, "socket": a.socket, "ledger": a.ledger}
    rc, p, _ = show(a.unit, "MainPID", "ExecStart", "Environment")
    if rc == 0:
        ctx["pid"] = int(p.get("MainPID", "0") or 0)
        ex = parse_execstart(p.get("ExecStart", ""))
        ctx["bin"] = ctx["bin"] or ex.get("bin", "")
        ctx["socket"] = ctx["socket"] or ex.get("socket", "")
        ctx["ledger"] = ctx["ledger"] or ex.get("ledger", "")
        if not a.model:
            a.model = os.environ.get("HEE4_MODEL") or parse_environment(p.get("Environment", "")).get("HEE4_MODEL", "")
    rows = {}
    rows["D8"] = d8(a, ctx)
    rc, p, _ = show(a.unit, "MainPID")  # post-restart MainPID: the drive restarts the unit
    if rc == 0:
        ctx["pid"] = int(p.get("MainPID", "0") or 0)
    for name, fn in (("D1", d1), ("D2", d2), ("D3", d3), ("D4", d4), ("D5", d5), ("D6", d6), ("D7", d7), ("D9", d9)):
        try:
            rows[name] = fn(a, ctx)
        except Exception as e:  # a crash in a reader is a FAIL row, never a silent skip
            rows[name] = Row(name)
            rows[name].check("reader", f"{type(e).__name__}: {e}", False)
    return [rows[n] for n in ROWS], ctx


def main_rows(a):
    rows, ctx = run_rows(a)
    for r in rows:
        print(r.line())
    rc, out, _ = sh("git", "-C", a.repo, "status", "--porcelain")
    dirty = len(out.splitlines()) if rc == 0 else None
    vs = [r.verdict() for r in rows]
    passed = vs.count("PASS")
    v = "FAIL" if "FAIL" in vs else "UNMEASURED" if "UNMEASURED" in vs or dirty is None else "PASS" if dirty == 0 else "FAIL"
    print(f"deployed={passed}/9 tree={ctx['tree']} dirty={'UNMEASURED(not a git tree)' if dirty is None else dirty} verdict={v}")
    sys.exit({"PASS": 0, "FAIL": 1, "UNMEASURED": 3}[v])


