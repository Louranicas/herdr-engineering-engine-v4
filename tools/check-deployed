        shutil.rmtree(ctl, ignore_errors=True)


def main():
    ap = argparse.ArgumentParser(prog="check-deployed", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--unit", default="hee4.service")
    ap.add_argument("--socket", default="", help="default: the unit's ExecStart --socket")
    ap.add_argument("--ledger", default="", help="default: the unit's ExecStart --ledger")
    ap.add_argument("--bin", default="", help="default: the unit's ExecStart argv[0]")
    ap.add_argument("--tree", default="", help="default: HEE4_HEAD, else git rev-parse HEAD of --repo")
    ap.add_argument("--repo", default=REPO)
    ap.add_argument("--evidence-root", default=os.path.expanduser("~/.cache/hee4-drive"))
    ap.add_argument("--drill-root", default=os.path.expanduser("~/.cache/hee4-drill"))
    ap.add_argument("--backups", default="/mnt/storage-10tb/hee4-backups")
    ap.add_argument("--habitat-log", default=os.path.expanduser("~/.local/state/hee4/habitat-backup.log"))
    ap.add_argument("--model", default="", help="default: HEE4_MODEL env, else the unit's Environment")
    ap.add_argument("--model-url", default="http://127.0.0.1:11434")
    ap.add_argument("--drive-cmd", default=f"{HERE}/drive --doctor-first --allow-restart")
    ap.add_argument("--proc", default="/proc", help="the proc root (the control points it at a fake)")
    ap.add_argument("--control", action="store_true")
    ap.add_argument("--control-skip", action="append", metavar="D<n>", help="test only: remove one plant")
    a = ap.parse_args()
    if a.control:
        control(a)
    elif a.control_skip:
        print("check-deployed refused: --control-skip needs --control")
        sys.exit(2)
    else:
        main_rows(a)


if __name__ == "__main__":
