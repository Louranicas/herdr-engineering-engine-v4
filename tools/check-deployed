        self.send_response(200); self.end_headers(); self.wfile.write(b)

    def log_message(self, *a):
        pass


def write(path, body, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(body)
    os.chmod(path, mode)


def control(a):
