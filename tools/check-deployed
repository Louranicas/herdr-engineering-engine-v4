def die_with_parent():
    """preexec_fn: the child is SIGKILLed when its parent dies (PR_SET_PDEATHSIG), so a killed control leaves no listener."""
    me = os.getppid()
    try:
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL, 0, 0, 0)  # PR_SET_PDEATHSIG = 1
    except (OSError, AttributeError):
        pass
    if os.getppid() != me:  # the parent died between fork and prctl
        os._exit(1)


def sweep_dead_controls(root):
    """Remove cd-control-* dirs whose pid file names a process that is gone (a control killed mid-way)."""
    swept = 0
    for d in os.listdir(root) if os.path.isdir(root) else []:
        full = os.path.join(root, d)
        if not d.startswith("cd-control-") or not os.path.isdir(full):
            continue
        try:
            pid = int(open(os.path.join(full, "pid")).read().strip())
            os.kill(pid, 0)
            alive = True
        except (OSError, ValueError):
            alive = False
        if not alive:
            shutil.rmtree(full, ignore_errors=True)
            swept += 1
    return swept


SERVER_PY = r'''
import json, os, socket, sys
path, sv, head = sys.argv[1], int(sys.argv[2]), sys.argv[3]
s = socket.socket(socket.AF_UNIX); s.bind(path); os.chmod(path, 0o600); s.listen(8)
sys.stdout.write("bound\n"); sys.stdout.flush()
while True:
    c, _ = s.accept()
    try:
        line = c.makefile("rb").readline()
        try:
            req = json.loads(line)
        except ValueError:
            req = {}
        body = {"ok": True, "head_sha": head, "recovery_complete": True, "uptime_s": 1, "schema_version": sv}
        c.sendall((json.dumps({"kind": "result", "request_id": req.get("request_id"), "replayed": False, "body": body}) + "\n").encode())
    except OSError:
        pass
    c.close()
'''


class PsHandler(http.server.BaseHTTPRequestHandler):
