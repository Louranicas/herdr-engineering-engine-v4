#!/usr/bin/env python3
"""drive [--socket PATH] [--unit hee4.service] [--doctor-first] [--allow-restart] [--repo DIR] [--evidence-root DIR] [--only NAME[,NAME...]] [--ledger PATH]

The rung-3 feature-map driver (gates/features/README.md "The drive"). Runs the "Driving it with
hee4" procedure of each served feature over the JSON-line frame on AF_UNIX, and writes every
frame sent and received to
  <evidence-root>/<sha12>/<feature>.jsonl      (default ~/.cache/hee4-drive)
The served set is the plugins: tools/drive.d/<family>.py, each exporting FEATURES = [(name, fn)]
(fn(F, ctx) drives gates/features/<name>.md). Prints one line per feature
  drive feature=<name> verdict=PASS|FAIL|UNMEASURED paths=k/n evidence=<path>
(UNMEASURED always names a reason; never a 0) and a last line
  drive verdict=PASS|FAIL|UNMEASURED features=k/n unserved=u head=<sha12>
An unserved feature (no procedure in tools/drive.d) whose catalogue scope (tools.inspect) is not
this release's is driven by its refusal (tools/drive.d/scoped.py) and prints
  drive feature=<name> verdict=PASS|FAIL paths=k/2 evidence=<path> scope=<v4.2> (refused by release scope, as catalogued)
counted in features=k/n. Any other unserved feature prints UNMEASURED with scope=unserved (the
reason names why it is not out of release) and is counted in unserved=, not in features=k/n. A feature file without the
"(rev 2026-10-05 drive)" marker in its Driving block is UNMEASURED: procedure UNWRITTEN.
--only NAME[,NAME...]: run only these plugin features (a name no plugin serves exits 2).
--ledger PATH: the ledger a procedure may read back, read-only (ctx["ledger"]; drive_d.ledger_ro);
  without it a side-effect check is UNMEASURED "--ledger not passed".
--doctor-first: run tools/doctor; if its unit or socket check is not MEASURED, print that line, exit 3.
--allow-restart: the persistence path restarts the unit (live unit only; else UNMEASURED).
A plugin that cannot be served (drive_d.PluginFault) is FAIL naming the module, exit 1.
Exit: 0 PASS, 1 FAIL, 3 UNMEASURED.
"""
import argparse, importlib.util, json, os, re, socket, subprocess, sys, time, uuid

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)


def load_drive_d():
    """Register tools/drive.d/__init__.py as the module 'drive_d' (the directory name is not importable)."""
    d = os.path.join(HERE, "drive.d")
    spec = importlib.util.spec_from_file_location("drive_d", os.path.join(d, "__init__.py"), submodule_search_locations=[d])
    mod = importlib.util.module_from_spec(spec)
    sys.modules["drive_d"] = mod
    spec.loader.exec_module(mod)
    return mod


def sh(*cmd, timeout=30):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, "", str(e)


def refusal_table(repo):
    """name -> (retry, field) from the FLOW.md 'Refusal names' table: the one vocabulary."""
    out = {}
    try:
        text = open(os.path.join(repo, "crates/hee4-app/FLOW.md")).read()
    except OSError:
        return out
    sect = text.split("## Refusal names", 1)[-1].split("\n## ", 1)[0]
    for line in sect.splitlines():
        m = re.match(r"\|\s*`(\w+)`\s*\|\s*(\w+)\s*\|", line)
        if m:
            out[m.group(1)] = m.group(2)
    return out


MINE = []  # (socket, task id) for every task.submit frame of THIS drive run: the only tasks settle() may touch


class Feature:
    def __init__(self, name, path, sock, table):
        self.name, self.path, self.sock, self.table = name, path, sock, table
        self.f = open(path, "w")
        self.paths = []  # (name, status, detail)

    def frame(self, obj_or_raw, timeout=10):
        raw = obj_or_raw if isinstance(obj_or_raw, str) else json.dumps(obj_or_raw, separators=(",", ":"))
        self.f.write(json.dumps({"t": time.time(), "dir": "send", "raw": raw}) + "\n")
        s = socket.socket(socket.AF_UNIX); s.settimeout(timeout)
        reply = None
        try:
            s.connect(self.sock)
            s.sendall(raw.encode() + b"\n")
            buf = b""
            while not buf.endswith(b"\n"):
                c = s.recv(65536)
                if not c:
                    break
                buf += c
            reply = buf.decode(errors="replace").rstrip("\n") if buf else None
        except OSError as e:
            self.f.write(json.dumps({"t": time.time(), "dir": "io_error", "raw": str(e)}) + "\n")
        finally:
            s.close()
        self.f.write(json.dumps({"t": time.time(), "dir": "recv", "raw": reply}) + "\n")
        self.f.flush()
        try:
            return json.loads(reply) if reply else None
        except ValueError:
            return None

    def req(self, action, body, key=None, version=1, precondition=None):
        """One request frame; `precondition` is a member only when given (the five task frames stay byte-identical)."""
        obj = {"request_id": "drive-" + uuid.uuid4().hex[:12], "action": action, "action_version": version, "idempotency_key": key}
        if precondition is not None:
            obj["precondition"] = precondition
        obj["body"] = body
        r = self.frame(obj)
        if action == "task.submit" and isinstance(r, dict) and r.get("kind") == "result":
            t = (r.get("body") or {}).get("task_id")
            if t and (self.sock, t) not in MINE:
                MINE.append((self.sock, t))
        return r

    def check(self, name, ok, detail, unmeasured=False):
        self.paths.append((name, "UNMEASURED" if unmeasured else "PASS" if ok else "FAIL", detail))

    def refuse(self, name, reply, code, field=None, msg_has=None, because=None, extra=None):
        """One name per refusal: the code is the expected one, is in the table, with its retry class.

        because: a substring the reply's `because` must hold; extra: {member: expected value} each
        of which must be present and equal. Both are checked only when the caller passes them.
        """
        if not reply or reply.get("kind") != "error":
            return self.check(name, False, f"expected error {code}, got {reply}")
        got = reply.get("code")
        probs = []
        if got != code: probs.append(f"code={got} want {code}")
        if got not in self.table: probs.append(f"code {got} not in FLOW.md refusal table")
        elif reply.get("retry") != self.table[got]: probs.append(f"retry={reply.get('retry')} want {self.table[got]}")
        if field and reply.get("field") != field: probs.append(f"field={reply.get('field')} want {field}")
        if msg_has and msg_has not in str(reply.get("message", "")): probs.append(f"message lacks {msg_has!r}: {reply.get('message')}")
        if because is not None and because not in str(reply.get("because", "")): probs.append(f"because lacks {because!r}: {reply.get('because')}")
        for member, want in (extra or {}).items():
            if member not in reply: probs.append(f"{member} missing")
            elif reply[member] != want: probs.append(f"{member}={reply[member]!r} want {want!r}")
        self.check(name, not probs, "; ".join(probs) or f"{got} field={reply.get('field')}")

    def verdict(self):
        st = [p[1] for p in self.paths]
        v = "FAIL" if "FAIL" in st else "UNMEASURED" if "UNMEASURED" in st or not st else "PASS"
        return v, st.count("PASS"), len(st)


TERMINAL_PHASES = {"accepted", "failed", "cancelled", "abandoned"}


def settle(sock, ev, table, budget=60):
    """Leave no debris on the unit: the drive's own restart path (persistence_restart) and the
    unit's recovery can leave tasks THIS run submitted in `blocked` (R12) or `effect_unknown` (R08).
    Abandon exactly those through task.resolve (reason attempt_failed), wait for the rest of this
    run's tasks on `sock` to finish, and print one line. Tasks submitted to another socket (a
    procedure's own disposable serve) and tasks this run did not submit are never touched.
    PASS when all are terminal; FAIL when a resolve is refused; UNMEASURED, naming them, when some
    are still open after `budget` seconds (e.g. a serve that never dispatches)."""
    mine = [t for s_, t in MINE if s_ == sock]
    if not mine:
        print("drive settle mine=0 terminal=0/0 resolved=0 refused=none open=none")
        return "PASS"
    F = Feature("settle", os.path.join(ev, "settle.jsonl"), sock, table)
    resolved, refused, t0, phases = [], [], time.monotonic(), {}
    while True:
        phases = {t: ((F.req("task.get", {"task_id": t}) or {}).get("body") or {}).get("phase") for t in mine}
        for t, ph in phases.items():
            if ph in ("blocked", "effect_unknown") and t not in resolved and t not in refused:
                r = F.req("task.resolve", {"task_id": t, "resolution": "abandon", "reason": "attempt_failed"}, key=f"drive-settle-{t}")
                (resolved if isinstance(r, dict) and r.get("kind") == "result" else refused).append(t)
        if all(ph in TERMINAL_PHASES for ph in phases.values()) or time.monotonic() - t0 > budget:
            break
        time.sleep(0.5)
    F.f.close()
    open_ = [f"{t}:{ph}" for t, ph in phases.items() if ph not in TERMINAL_PHASES]
    print(f"drive settle mine={len(mine)} terminal={len(mine) - len(open_)}/{len(mine)} resolved={len(resolved)} "
          f"refused={','.join(refused) or 'none'} open={','.join(open_) or 'none'}")
    return "FAIL" if refused else "UNMEASURED" if open_ else "PASS"


def main():
    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    live = f"{xdg}/hee4/control.sock"
    ap = argparse.ArgumentParser(prog="drive", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--socket", default=live)
    ap.add_argument("--unit", default="hee4.service")
    ap.add_argument("--doctor-first", action="store_true")
    ap.add_argument("--allow-restart", action="store_true")
    ap.add_argument("--repo", default=REPO)
    ap.add_argument("--evidence-root", default=os.path.expanduser("~/.cache/hee4-drive"))
    ap.add_argument("--only", metavar="NAME[,NAME...]", help="run only these plugin features")
    ap.add_argument("--ledger", metavar="PATH", help="ledger a procedure may read back (opened read-only)")
    a = ap.parse_args()
    rc, head, _ = sh("git", "-C", a.repo, "rev-parse", "HEAD")
    head = head[:12] if rc == 0 and head else os.environ.get("HEE4_HEAD", "unknown")[:12]  # the gate's export has no .git

    if a.doctor_first:
        _, out, _ = sh(os.path.join(HERE, "doctor"), "--socket", a.socket, "--unit", a.unit, "--repo", a.repo, timeout=60)
        for line in out.splitlines():
            m = re.match(r"check=(unit|socket) status=(\S+)", line)
            if m and m.group(2) != "MEASURED":
                print(line); print(f"drive verdict=UNMEASURED features=0/0 unserved=0 head={head} (doctor refused)")
                sys.exit(3)

    drive_d = load_drive_d()
    fdir = os.path.join(a.repo, "gates/features")
    try:
        served = drive_d.load_plugins(os.path.join(a.repo, "tools/drive.d"), fdir)
    except drive_d.PluginFault as e:
        print(f"drive verdict=FAIL features=0/0 unserved=0 head={head} reason=plugin {e.module}: {e.reason}")
        sys.exit(1)
    scoped = sys.modules["drive_d.scoped"]  # tools/drive.d/scoped.py, loaded by load_plugins: the unserved branch
    selected = list(served)
    if a.only:
        wanted = [n for n in a.only.split(",") if n]
        for n in wanted:
            if n not in served:
                print(f"drive: --only {n} is not a plugin feature (plugins: {', '.join(served)})", file=sys.stderr)
                sys.exit(2)
        selected = [n for n in served if n in wanted]

    table = refusal_table(a.repo)
    ev = os.path.join(a.evidence_root, head); os.makedirs(ev, exist_ok=True)
    is_live = os.path.realpath(a.socket) == os.path.realpath(live)
    ctx = {"unit": a.unit, "restart_ok": a.allow_restart and is_live, "ledger": a.ledger,
           "restart_why": ("--allow-restart not passed" if not a.allow_restart else "socket is not the live unit's; restart only drives the live unit")}
    names = sorted(f[:-3] for f in os.listdir(fdir) if f.endswith(".md") and f != "README.md")
    unserved = [n for n in names if n not in served]
    out_of_release = 0
    verdicts = []
    for name in unserved + selected:
        evp = os.path.join(ev, f"{name}.jsonl")
        if name not in served:
            F = Feature(name, evp, a.socket, table)
            try:
                scope, why = scoped.drive(F, name, a.repo, open(os.path.join(fdir, name + ".md")).read())
            except Exception as e:  # a crash in the scoped procedure is a FAIL, never a silent skip
                scope, why = "unknown", ""
                F.check("driver", False, f"{type(e).__name__}: {e}")
            if scope is None:
                F.f.write(json.dumps({"unmeasured": "no procedure in tools/drive.d"}) + "\n"); F.f.close()
                print(f"drive feature={name} verdict=UNMEASURED paths=0/0 evidence={evp} scope=unserved reason=no procedure in tools/drive.d ({why})")
                continue
            F.f.close(); out_of_release += 1
            v, k, n = F.verdict(); verdicts.append(v)
            print(f"drive feature={name} verdict={v} paths={k}/{n} evidence={evp} scope={scope} (refused by release scope, as catalogued)")
            for p, st, d in F.paths:
                if st != "PASS": print(f"  path={p} status={st} detail={d[:300]}")
            continue
        text = open(os.path.join(fdir, name + ".md")).read()
        drive_sect = text.split("## Driving it with hee4", 1)[-1].split("\n## ", 1)[0]
        if drive_d.MARK not in drive_sect:
            open(evp, "w").write(json.dumps({"unmeasured": "procedure UNWRITTEN in file"}) + "\n")
            print(f"drive feature={name} verdict=UNMEASURED paths=0/0 evidence={evp} reason=procedure UNWRITTEN in gates/features/{name}.md (no {drive_d.MARK} marker)")
            verdicts.append("UNMEASURED"); continue
        F = Feature(name, evp, a.socket, table)
        try:
            served[name](F, ctx)
        except Exception as e:  # a crash in a procedure is a FAIL, never a silent skip
            F.check("driver", False, f"{type(e).__name__}: {e}")
        F.f.close()
        v, k, n = F.verdict(); verdicts.append(v)
        print(f"drive feature={name} verdict={v} paths={k}/{n} evidence={evp}" + (drive_d.feature_reason(F.paths) if v == "UNMEASURED" else ""))
        for p, st, d in F.paths:
            if st != "PASS": print(f"  path={p} status={st} detail={d[:300]}")
    sv = settle(a.socket, ev, table)
    if sv != "PASS":
        verdicts.append(sv)
    v = "FAIL" if "FAIL" in verdicts else "UNMEASURED" if "UNMEASURED" in verdicts or not verdicts else "PASS"
    print(f"drive verdict={v} features={verdicts.count('PASS')}/{len(verdicts)} unserved={len(unserved) - out_of_release} head={head}")
    sys.exit({"PASS": 0, "FAIL": 1, "UNMEASURED": 3}[v])


if __name__ == "__main__":
    main()
