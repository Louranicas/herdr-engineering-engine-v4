#!/usr/bin/env python3
"""doctor [--unit hee4.service] [--socket PATH] [--model-url URL] [--model NAME] [--require-gpu] [--repo DIR]

Fresh-instance readiness (gates/features/README.md "doctor"). Each check prints
  check=<name> status=MEASURED|UNMEASURED|FAIL detail=<text>
UNMEASURED always names its reason; it is never a 0 and it is red. Last line
  doctor verdict=PASS|FAIL|UNMEASURED measured=k/n unmeasured=u fail=f advisory=a head=<sha12>
Exit: 0 PASS (every counted check MEASURED and ok), 1 FAIL (any check measured bad), 3 UNMEASURED.
Checks: tool cargo, tool bwrap, tool cargo-deny (the commit tier's `deps` step runs it; a fresh
host also needs one `cargo fetch` before it passes offline), unit active, socket perms, ledger opens (hee4 health),
budgets (the last line of hee4 health is the JSON reply; body.budgets must be a non-empty object of
non-empty objects of positive integers whose key=value set equals the
`doctor row=budgets present` line of `hee4 doctor` (the detail is that line), whose check is Budgets::parse; an error frame
or a bad shape is FAIL naming the code or field; a binary without the reply line or row is UNMEASURED),
model_endpoint (/api/ps parses), model_gpu (the pinned model listed with size_vram > 0; a CPU copy
is FAIL; not resident or no name is UNMEASURED with scope=advisory, excluded from the verdict and
counted in advisory=, unless --require-gpu), binary sha = HEAD.
"""
import argparse, json, os, re, stat, subprocess, sys, urllib.request

rows = []      # counted statuses
advisory = []  # excluded from the verdict (scope=advisory), as tools/drive excludes scope=unserved

def emit(name, status, detail, excluded=False):
    (advisory if excluded else rows).append(status)
    print(f"check={name} status={status} detail={detail}")

def sh(*cmd, timeout=10):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, "", str(e)

def tool(name, args):
    rc, out, err = sh(name, *args)
    if rc is None:
        emit(f"tool_{name}", "FAIL", f"cannot run {name}: {err}")
    elif rc:
        emit(f"tool_{name}", "FAIL", f"rc={rc} {err}")
    else:
        emit(f"tool_{name}", "MEASURED", out.splitlines()[0] if out else "ran")

def budgets_shape(budgets):
    """The one line `section.field=value` in key order, or (None, why) naming the bad field.
    A served value is a non-empty object of non-empty objects of positive integers."""
    if not isinstance(budgets, dict) or not budgets:
        return None, f"body.budgets is not a non-empty object: {json.dumps(budgets)}"
    parts = []
    for sec, fields in budgets.items():
        if not isinstance(fields, dict) or not fields:
            return None, f"budgets.{sec} is not a non-empty object: {json.dumps(fields)}"
        for k, v in fields.items():
            if isinstance(v, bool) or not isinstance(v, int) or v <= 0:
                return None, f"budgets.{sec}.{k}={json.dumps(v)} is not a positive integer"
            parts.append(f"{sec}.{k}={v}")
    return " ".join(parts), None

def budgets_check(out, unit):
    """(status, detail) for the budgets row. MEASURED only when the reply's body.budgets has the
    served shape AND the binary's own `hee4 doctor` row (Budgets::parse + round trip, the
    contracts' validator) is present with the same rendered line."""
    last = out.splitlines()[-1] if out else ""
    try:
        reply = json.loads(last)
    except ValueError:
        return "UNMEASURED", "last line of hee4 health is not JSON (the binary predates the health reply line)"
    if not isinstance(reply, dict):
        return "FAIL", f"health reply is not an object: {last[:200]}"
    if reply.get("kind") == "error":
        return "FAIL", f"health refused code={reply.get('code')} message={reply.get('message')}"
    body = reply.get("body")
    if not isinstance(body, dict):
        return "FAIL", f"health reply kind={reply.get('kind')} has no object body"
    if "budgets" not in body:
        return "UNMEASURED", "health reply has no budgets (the serving binary predates them)"
    line, why = budgets_shape(body["budgets"])
    if line is None:
        return "FAIL", why
    # Same socket as the `hee4 health` above (the binary's default), so both read one server.
    rc, dout, derr = sh("hee4", "doctor", "--unit", unit, timeout=30)
    if rc is None:
        return "UNMEASURED", f"hee4 doctor not runnable: {derr}"
    row = next((l for l in dout.splitlines() if l.startswith("doctor row=budgets ")), None)
    if row is None:
        return "UNMEASURED", "hee4 doctor prints no budgets row (the binary predates it)"
    if not row.startswith("doctor row=budgets present "):
        return "FAIL", f"hee4 doctor: {row}"
    # The reply's JSON object order is serde_json's (sorted), the render line's is the contracts'
    # field table: compare the key=value sets, print the contracts' line.
    rendered = row[len("doctor row=budgets present "):]
    if sorted(rendered.split()) != sorted(line.split()):
        return "FAIL", f"health budgets {line} != hee4 doctor {row}"
    inert = body.get("budgets_inert")
    return "MEASURED", rendered + (f" inert={','.join(inert)}" if isinstance(inert, list) and inert else "")

def main():
    ap = argparse.ArgumentParser(prog="doctor", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    ap.add_argument("--unit", default="hee4.service")
    ap.add_argument("--socket", default=f"{xdg}/hee4/control.sock")
    ap.add_argument("--model-url", default="http://127.0.0.1:11434")
    ap.add_argument("--repo", default=os.getcwd())
    ap.add_argument("--model", default="", help="the pinned model name; default HEE4_MODEL, else the unit's Environment")
    ap.add_argument("--require-gpu", action="store_true", help="count an unmeasured model_gpu row in the verdict")
    a = ap.parse_args()

    # Under the gate the tree is a `git archive` export with no .git: the gate passes the subject
    # in HEE4_HEAD (the sha build.rs baked), and that wins over a rev-parse of the cwd.
    head = os.environ.get("HEE4_HEAD", "").strip()
    if not head:
        rc, head, _ = sh("git", "-C", a.repo, "rev-parse", "HEAD")
        head = head if rc == 0 else ""
    head = head[:12] if head else "unmeasured"

    tool("cargo", ["--version"])
    tool("bwrap", ["--version"])
    tool("cargo-deny", ["--version"])

    # unit
    rc, out, err = sh("systemctl", "--user", "show", "-p", "LoadState,ActiveState,MainPID", a.unit)
    props = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    pid = 0
    if rc is None:
        emit("unit", "UNMEASURED", f"systemctl not runnable: {err}")
    elif props.get("LoadState") != "loaded":
        emit("unit", "UNMEASURED", f"{a.unit} not loaded (LoadState={props.get('LoadState', '?')}); the unit does not exist yet")
    elif props.get("ActiveState") != "active":
        emit("unit", "FAIL", f"{a.unit} ActiveState={props.get('ActiveState')}")
    else:
        pid = int(props.get("MainPID", "0") or 0)
        emit("unit", "MEASURED", f"active MainPID={pid}")

    # socket
    d = os.path.dirname(a.socket)
    try:
        sd, ss = os.stat(d), os.stat(a.socket)
    except OSError:
        emit("socket", "UNMEASURED", f"{a.socket} absent; nothing is listening yet")
    else:
        md, ms = stat.S_IMODE(sd.st_mode), stat.S_IMODE(ss.st_mode)
        good = md == 0o700 and ms == 0o600 and stat.S_ISSOCK(ss.st_mode) and ss.st_uid == os.getuid()
        emit("socket", "MEASURED" if good else "FAIL", f"dir={md:o} sock={ms:o} is_socket={stat.S_ISSOCK(ss.st_mode)} uid_ok={ss.st_uid == os.getuid()}")

    # ledger opens, via the product's own health read
    rc, out, err = sh("hee4", "health")
    if rc is None:
        emit("ledger", "UNMEASURED", "hee4 binary not on PATH; ledger open cannot be read")
    elif rc == 0 and re.search(r"\bready=true\b", out) and "recovery=complete" in out and "database=ready" in out:
        emit("ledger", "MEASURED", out.splitlines()[0])
    else:
        emit("ledger", "FAIL", f"rc={rc} {out or err}")

    # budgets: the health reply's body.budgets, read from the last stdout line (the JSON reply)
    if rc is None:
        emit("budgets", "UNMEASURED", "hee4 binary not on PATH; health reply unreadable")
    else:
        status, detail = budgets_check(out, a.unit)
        emit("budgets", status, detail)

    # model endpoint: /api/ps parses
    models = None
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(a.model_url + "/api/ps", timeout=5) as r:
            models = json.load(r).get("models", [])
    except (OSError, ValueError) as e:
        emit("model_endpoint", "FAIL", f"{a.model_url}/api/ps unreachable: {e}")
    else:
        emit("model_endpoint", "MEASURED", f"{a.model_url}/api/ps ok loaded={len(models)}")

    # model gpu: the pinned model resident with size_vram > 0; advisory unless --require-gpu
    model = a.model or os.environ.get("HEE4_MODEL", "")
    if not model:
        _, env_out, _ = sh("systemctl", "--user", "show", "-p", "Environment", "--value", a.unit)
        model = dict(kv.split("=", 1) for kv in env_out.split() if "=" in kv).get("HEE4_MODEL", "")
    scope = "required" if a.require_gpu else "advisory"
    if models is None:
        emit("model_gpu", "UNMEASURED", f"endpoint unreachable, residency unreadable scope={scope}", excluded=not a.require_gpu)
    elif not model:
        emit("model_gpu", "UNMEASURED", f"no pinned model name (--model, HEE4_MODEL, or the unit's Environment) scope={scope}", excluded=not a.require_gpu)
    else:
        hit = [m for m in models if m.get("name") == model or m.get("model") == model]
        if not hit:
            emit("model_gpu", "UNMEASURED", f"model {model} not resident (ollama unloads idle models) scope={scope}", excluded=not a.require_gpu)
        else:
            vram = hit[0].get("size_vram", 0) or 0
            emit("model_gpu", "MEASURED" if vram > 0 else "FAIL", f"model={model} size_vram={vram}" + ("" if vram > 0 else " (CPU copy)"))

    # binary sha = HEAD
    if not pid:
        emit("binary_sha", "UNMEASURED", "no running unit, so no /proc/<MainPID>/exe to compare with HEAD")
    else:
        rc, out, err = sh("hee4", "--version")
        if rc == 0 and head != "unmeasured":
            emit("binary_sha", "MEASURED" if head in out else "FAIL", f"HEAD={head} hee4 --version={out.splitlines()[0] if out else ''}")
        else:
            emit("binary_sha", "UNMEASURED", "hee4 --version unavailable or HEAD unknown")

    k, n = rows.count("MEASURED"), len(rows)
    u, f = rows.count("UNMEASURED"), rows.count("FAIL")
    v = "FAIL" if f else "UNMEASURED" if u else "PASS"
    print(f"doctor verdict={v} measured={k}/{n} unmeasured={u} fail={f} advisory={len(advisory)} head={head}")
    sys.exit({"PASS": 0, "FAIL": 1, "UNMEASURED": 3}[v])

if __name__ == "__main__":
    main()
