#!/usr/bin/env bash
# The tests runner: `tools/tests/run`. Last line `tools-tests verdict=PASS|FAIL`; refuses zero tests.
# HEE4_TOOLS_TESTS_DIR names another test directory (default: this one). The full output always goes
# to $HOME/.cache/hee4-tools-tests/<UTC stamp>-<pid>.log (newest 20 kept); on FAIL every unittest
# FAIL:/ERROR: header and its traceback is printed (at most 200 lines) with the log's path.
cd "${HEE4_TOOLS_TESTS_DIR:-$(dirname "$0")}" || exit 2
out=$(python3 -m unittest discover -s . -p 'test_*.py' 2>&1); rc=$?
logdir="$HOME/.cache/hee4-tools-tests"
log="$logdir/$(date -u +%Y%m%dT%H%M%S.%NZ)-$$.log"
if mkdir -p "$logdir" && printf '%s\n' "$out" > "$log"; then
  # stamps sort by name; keep the newest 20
  find "$logdir" -maxdepth 1 -type f -name '*.log' -printf '%f\n' | sort -r | sed -n '21,$p' |
    while IFS= read -r old; do rm -f -- "$logdir/$old"; done
else
  log=none
fi
ran=$(printf '%s\n' "$out" | sed -n 's/^Ran \([0-9]*\) test.*/\1/p')
if [ "$rc" -eq 0 ] && [ "${ran:-0}" -gt 0 ]; then
  printf '%s\n' "$out" | tail -n 4
  echo "tools-tests verdict=PASS ran=$ran"; exit 0
fi
# each failure block runs from its FAIL:/ERROR: header to the next ===== rule or the Ran line
printf '%s\n' "$out" | awk -v cap=200 '
  /^(FAIL|ERROR): / { inb = 1 }
  inb && (/^=+$/ || /^Ran [0-9]+ test/) { inb = 0 }
  inb { if (n < cap) print; else cut++; n++ }
  END { if (cut) printf "tools-tests failures truncated: %d more lines in the log\n", cut }'
printf '%s\n' "$out" | tail -n 4
echo "tools-tests log=$log"
echo "tools-tests verdict=FAIL rc=$rc ran=${ran:-none}"; exit 1
