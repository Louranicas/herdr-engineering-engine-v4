#!/usr/bin/env python3
"""drill [--unit hee4.service] [--socket PATH] [--restart-budget S] [--repo DIR] [--submit N] [--drill-root DIR]

The kill -9 drill (gates/features/crash-restart.md): SIGKILL the unit's MainPID, then require the
unit to come back with a new MainPID, the socket to return 0700/0600, and `hee4 health` ready.
Parameterised on the unit name and socket path. Each step prints
  drill_step=<name> status=MEASURED|UNMEASURED|FAIL elapsed=<s>/<budget>s detail=<text>
If the unit is not loaded every step is UNMEASURED with its reason (never a 0, and red).
--submit N (default 0): N acked task.submit frames over --socket before the kill (step `submit`,
detail acked=N/N ids=...), and after health_ready one task.list that must list every id (step
`acked_present`, detail k/N missing=...). The rehearsal record
  <drill-root>/<sha12>/rehearsal.json      (default ~/.cache/hee4-drill; written on every run but KEPT)
holds {tree, unit, submitted, acked_present, task_ids, steps, ts}: D7 reads it, D9 excludes its ids.
It is written atomically (temp file, fsync, rename) under an exclusive flock on <drill-root>/<sha12>/.lock
(read, decide, write). submitted is the number of acked task ids (requested holds --submit N).
A run that acked no task (plain, or --submit N with the unit down or the socket gone) never replaces
a record with submitted>0 at the same tree: it prints `drill rehearsal=KEPT(...)` and the submitting record stands.
task_ids is the union with the record already there (a second run at the same tree loses no id, so no
drill task ever counts as use) and the record is written right after the submit step, before the kill.
unit_active refuses MainPID=0 by name (an active unit without a main process): nothing is killed.
unit_restarted waits for Restart=on-failure; if no new MainPID by half the budget it runs
`systemctl --user start <unit>` once and records explicit_start=yes (V4-37).
Last line
  drill verdict=PASS|FAIL|UNMEASURED steps=k/n unit=<name> head=<sha12> [submitted=N acked_present=k/N [requested=M]]
Exit: 0 PASS, 1 FAIL, 3 UNMEASURED.
"""
import argparse, fcntl, json, os, signal, socket, stat, subprocess, sys, tempfile, time, uuid

rows = []
BASE_STEPS = ["unit_active", "kill9", "unit_restarted", "socket_perms", "health_ready"]
# The drill's brief: eleven fields; VERIFY is an absolute path (a Run step, FLOW.md), never a vacuous `true`.
BRIEF = ("GOAL: drill rehearsal\nSCOPE: s\nCONTEXT: c\nACCEPTANCE: a\nVERIFY: /usr/bin/test -d /usr\nTIMEBOX: 10s\n"
         "FORBIDDEN: f\nREPORT: r\nSTANDING: s\nRECON: r\nRESTATEMENT: test that /usr is a directory\n")


def sh(*cmd, timeout=10):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, "", str(e)


def emit(name, status, budget, t0, detail):
    elapsed = time.monotonic() - t0
    rows.append({"name": name, "status": status, "elapsed": round(elapsed, 1), "detail": detail})
    print(f"drill_step={name} status={status} elapsed={elapsed:.1f}/{budget}s detail={detail}")


def props(unit):
    rc, out, _ = sh("systemctl", "--user", "show", "-p", "LoadState,ActiveState,MainPID", unit)
    return rc, dict(l.split("=", 1) for l in out.splitlines() if "=" in l)


def frame(sock_path, action, body, key=None, timeout=10):
    """One JSON line over AF_UNIX (the tools/drive client shape); the parsed reply or None."""
    raw = json.dumps({"request_id": "drill-" + uuid.uuid4().hex[:12], "action": action, "action_version": 1,
                      "idempotency_key": key, "body": body}, separators=(",", ":"))
    s = socket.socket(socket.AF_UNIX); s.settimeout(timeout)
    buf = b""
    try:
        s.connect(sock_path)
        s.sendall(raw.encode() + b"\n")
        while not buf.endswith(b"\n"):
            c = s.recv(65536)
            if not c:
                break
            buf += c
    except OSError:
        return None
    finally:
        s.close()
    try:
        return json.loads(buf.decode(errors="replace")) if buf else None
    except ValueError:
        return None


def is_result(r):
    return bool(r) and r.get("kind") == "result"


def write_atomic(path, text):
    """A uniquely named temp file in the record's directory, fsynced, then renamed over `path`: a reader
    sees the old record or the new one, never a partial file. On any error the temp file is removed."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".rehearsal-", suffix=".tmp", dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class Run:
    """This run's step list (submit/acked_present only with --submit), its ids, and the record."""
    def __init__(self, a, head):
        self.a, self.head = a, head
        self.steps = list(BASE_STEPS)
        if a.submit > 0:
            self.steps.insert(1, "submit")
            self.steps.append("acked_present")
            self.steps.append("rehearsal_settled")
        self.ids, self.acked = [], 0

    def not_reached(self, after, why):
        for s in self.steps[self.steps.index(after) + 1:]:
            emit(s, "UNMEASURED", self.a.restart_budget, time.monotonic(), f"not reached: {why}")

    def save(self, ap):
        """Write the record: this run's steps and ack count, task_ids merged with the record already there.
        The door is keyed on what was acked, not on --submit: a run that acked no task (plain, unit down,
        socket gone) never replaces a record that submitted (D7 and watch-recovery would read UNMEASURED);
        the overwrite is refused by name and the submitting record is kept. The read of the prior record,
        that decision and the write hold an exclusive flock on <drill-root>/<tree>/.lock, so two drills at
        one tree serialize and neither erases the other's record or ids."""
        d = os.path.join(self.a.drill_root, self.head)
        p = os.path.join(d, "rehearsal.json")
        try:
            os.makedirs(d, exist_ok=True)
            lock = open(os.path.join(d, ".lock"), "a")
        except OSError as e:
            print(f"drill rehearsal=UNWRITTEN({p}: {e})")
            return
        with lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                with open(p) as f:
                    prior = json.load(f)
            except (OSError, ValueError):
                prior = {}
            prior = prior if isinstance(prior, dict) else {}
            prior_sub = prior.get("submitted")
            if not self.ids and isinstance(prior_sub, int) and prior_sub > 0:
                print(f"drill rehearsal=KEPT(prior submitted={prior_sub} at tree={self.head}; this run acked=0 requested={self.a.submit} does not replace it)")
                return
            ids = list(dict.fromkeys([*(prior.get("task_ids") or []), *self.ids]))  # append-only: no earlier run's id is ever dropped
            rec = {"tree": self.head, "unit": self.a.unit, "submitted": len(self.ids), "requested": self.a.submit,
                   "acked_present": ap, "task_ids": ids, "steps": rows, "ts": time.time()}
            try:
                write_atomic(p, json.dumps(rec))
            except OSError as e:
                print(f"drill rehearsal=UNWRITTEN({p}: {e})")

    def finish(self):
        k, n = sum(1 for r in rows if r["status"] == "MEASURED"), len(self.steps)
        v = "FAIL" if any(r["status"] == "FAIL" for r in rows) else "PASS" if k == n else "UNMEASURED"
        ap = f"{self.acked}/{len(self.ids)}"
        self.save(ap)
        tail = (f" submitted={len(self.ids)} acked_present={ap}" + (f" requested={self.a.submit}" if len(self.ids) != self.a.submit else "")
                if self.a.submit > 0 else "")
        print(f"drill verdict={v} steps={k}/{n} unit={self.a.unit} head={self.head}{tail}")
        sys.exit({"PASS": 0, "FAIL": 1, "UNMEASURED": 3}[v])


def main():
    ap = argparse.ArgumentParser(prog="drill", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    ap.add_argument("--unit", default="hee4.service")
    ap.add_argument("--socket", default=f"{xdg}/hee4/control.sock")
    ap.add_argument("--restart-budget", type=int, default=30, help="seconds to wait for the restart")
    ap.add_argument("--repo", default=os.getcwd())
    ap.add_argument("--submit", type=int, default=0, help="N acked task.submit frames before the kill")
    ap.add_argument("--drill-root", default=os.path.expanduser("~/.cache/hee4-drill"))
    a = ap.parse_args()
    head = os.environ.get("HEE4_HEAD", "").strip()  # the gate's export has no .git: HEE4_HEAD wins
    if not head:
        rc, head, _ = sh("git", "-C", a.repo, "rev-parse", "HEAD")
        head = head if rc == 0 else ""
    head = head[:12] if head else "unmeasured"
    B = a.restart_budget
    run = Run(a, head)

    t0 = time.monotonic()
    rc, p = props(a.unit)
    if rc is None or p.get("LoadState") != "loaded" or p.get("ActiveState") != "active":
        why = "systemctl not runnable" if rc is None else f"{a.unit} LoadState={p.get('LoadState')} ActiveState={p.get('ActiveState')}; the unit does not exist or is not running"
        emit("unit_active", "UNMEASURED", 5, t0, why)
        run.not_reached("unit_active", "unit_active was not measured")
        run.finish()
    old = int(p.get("MainPID", "0") or 0)
    if old <= 0:  # os.kill(0, ...) would signal this drill's own process group: refused by name, nothing is killed
        emit("unit_active", "FAIL", 5, t0, f"MainPID={old}: active unit without a main process; nothing to kill")
        run.not_reached("unit_active", "no MainPID to kill")
        run.finish()
    emit("unit_active", "MEASURED", 5, t0, f"MainPID={old}")

    if a.submit > 0:
        t0 = time.monotonic()
        up = None
        while time.monotonic() - t0 < B and not is_result(up):  # poll health first: not_ready precedes reconcile
            up = frame(a.socket, "health", {})
            if not is_result(up):
                time.sleep(0.5)
        refused = None
        for _ in range(a.submit):
            r = frame(a.socket, "task.submit", {"brief": BRIEF}, key=str(uuid.uuid4()))
            if is_result(r) and (r.get("body") or {}).get("task_id"):
                run.ids.append(r["body"]["task_id"])
            else:
                refused = (r or {}).get("code", "no_reply")
                break
        ok = len(run.ids) == a.submit
        emit("submit", "MEASURED" if ok else "FAIL", B, t0,
             f"acked={len(run.ids)}/{a.submit} ids={','.join(run.ids) or 'none'}" + ("" if ok else f" refused={refused}"))
        if not ok:
            run.not_reached("submit", "submit failed")
            run.finish()
        run.save(f"0/{len(run.ids)}")  # the ids are on disk before the kill: a drill killed mid-way loses none

    t0 = time.monotonic()
    try:
        os.kill(old, signal.SIGKILL)
        emit("kill9", "MEASURED", 5, t0, f"SIGKILL sent to {old}")
    except OSError as e:
        emit("kill9", "FAIL", 5, t0, f"cannot kill {old}: {e}")
        run.not_reached("kill9", "kill9 failed")
        run.finish()

    t0 = time.monotonic()
    new, explicit = 0, "no"
    while time.monotonic() - t0 < B:
        rc, p = props(a.unit)
        pid = int(p.get("MainPID", "0") or 0)
        if p.get("ActiveState") == "active" and pid and pid != old:
            new = pid
            break
        if explicit == "no" and time.monotonic() - t0 >= B / 2:  # V4-37: the drill never relies on Restart=
            sh("systemctl", "--user", "start", a.unit, timeout=30)
            explicit = "yes"
        time.sleep(0.2)
    emit("unit_restarted", "MEASURED" if new else "FAIL", B, t0, f"old={old} new={new or 'none'} explicit_start={explicit}")

    t0 = time.monotonic()
    while time.monotonic() - t0 < B and not os.path.exists(a.socket):
        time.sleep(0.2)
    try:
        ss, sd = os.stat(a.socket), os.stat(os.path.dirname(a.socket))
        ms, md = stat.S_IMODE(ss.st_mode), stat.S_IMODE(sd.st_mode)
        good = ms == 0o600 and md == 0o700 and stat.S_ISSOCK(ss.st_mode)
        emit("socket_perms", "MEASURED" if good else "FAIL", B, t0, f"dir={md:o} sock={ms:o}")
    except OSError:
        emit("socket_perms", "FAIL", B, t0, f"{a.socket} did not return")

    t0 = time.monotonic()
    out, rc = "", None
    while time.monotonic() - t0 < B:
        rc, out, _ = sh("hee4", "health")
        if rc == 0 and "ready=true" in out:
            break
        time.sleep(0.5)
    if rc is None:
        emit("health_ready", "UNMEASURED", B, t0, "hee4 binary not on PATH")
    else:
        emit("health_ready", "MEASURED" if rc == 0 and "ready=true" in out and "recovery=complete" in out else "FAIL", B, t0, out.splitlines()[0] if out else f"rc={rc}")

    if a.submit > 0:
        t0 = time.monotonic()
        r = frame(a.socket, "task.list", {})
        listed = {t.get("task_id") for t in ((r or {}).get("body") or {}).get("tasks", [])}
        missing = [t for t in run.ids if t not in listed]
        run.acked = len(run.ids) - len(missing)
        emit("acked_present", "MEASURED" if not missing else "FAIL", B, t0, f"{run.acked}/{a.submit} missing={','.join(missing) or 'none'}")
        settle_rehearsal(a, run.ids, B)
    run.finish()


TERMINAL = {"accepted", "failed", "cancelled", "abandoned"}


# What the kill can leave a drill task in: effect_unknown when it died mid-attempt (R08), blocked
# when it died verifying with no Decide and no receipt (R12 quarantine). The smoke soak of
# 2026-10-06 found the second: the drill's settle step had handled only the first.
UNSETTLED = ("effect_unknown", "blocked")


def settle_rehearsal(a, ids, budget):
    """Step `rehearsal_settled`: the kill lands mid-attempt on purpose, so recovery correctly leaves
    some of THIS run's tasks `effect_unknown` (R08) or `blocked` (R12). The drill resolves those, and only those (its
    own acked ids), through task.resolve abandon with reason attempt_failed, then waits until every
    one of its tasks is terminal. A task it did not submit is never touched. MEASURED only when all
    are terminal within the budget; a refused resolve or a task still open is FAIL by name."""
    t0 = time.monotonic()
    resolved, refused = [], []
    deadline = t0 + budget
    phases = {}
    while True:
        phases = {t: ((frame(a.socket, "task.get", {"task_id": t}) or {}).get("body") or {}).get("phase") for t in ids}
        for t, ph in phases.items():
            if ph in UNSETTLED and t not in resolved and t not in refused:
                r = frame(a.socket, "task.resolve", {"task_id": t, "resolution": "abandon", "reason": "attempt_failed"},
                          key=f"drill-settle-{t}")
                (resolved if is_result(r) else refused).append(t)
        if all(ph in TERMINAL for ph in phases.values()) or time.monotonic() >= deadline:
            break
        time.sleep(0.5)
    open_ = [f"{t}:{ph}" for t, ph in phases.items() if ph not in TERMINAL]
    ok = not open_ and not refused
    emit("rehearsal_settled", "MEASURED" if ok else "FAIL", budget, t0,
         f"terminal={len(ids) - len(open_)}/{len(ids)} resolved_unsettled={len(resolved)} refused={','.join(refused) or 'none'} open={','.join(open_) or 'none'}")


if __name__ == "__main__":
    main()
