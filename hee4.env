# hee4.env — where the HEE v4 homes live on THIS machine (Arch/Omarchy, HOME=/home/louranicas; no toolbox).
# Sourceable: `. /mnt/storage-10tb/herdr-engineering-engine-v4/hee4.env` from a shell profile, a cron line or a
# runner. Each variable is set only when unset, so an exported override wins. Every tool here falls back to these
# same paths when the file is not sourced; the file is the one place the machine's layout is written down.
# No state lives here: the paths say where the tooling LOOKS, and `just verify` measures what it finds there.
: "${HEE4_ROOT:=/mnt/storage-10tb/herdr-engineering-engine-v4}"
: "${HEE4_EVIDENCE:=/mnt/storage-10tb/hee4-evidence}"
: "${HEE4_VAULT:=/mnt/storage-10tb/fedora-obsidian-vaults/herdr-engineering-engine-v4.vault}"
: "${HEE4_HANDOFFS:=/mnt/storage-10tb/handoffs}"
: "${HEE4_BRAIN:=$HEE4_ROOT/brain}"
export HEE4_ROOT HEE4_EVIDENCE HEE4_VAULT HEE4_HANDOFFS HEE4_BRAIN

# Firstmate (the orchestrator, V4-82 proposal): its home and its one orchestration DB (ops/firstmate/fm-db)
: "${FM_HOME:=$HOME/firstmate}"
: "${FM_DB:=$FM_HOME/data/firstmate.db}"
export FM_HOME FM_DB
